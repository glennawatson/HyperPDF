# Maintainer: Glenn Watson
# Builds from source. Release tags have no "v" prefix. Update pkgver and the
# archive hash for each release; the release workflow generates hyperpdf-bin.
pkgname=hyperpdf
pkgver=1.0.1
pkgrel=1
pkgdesc="Fast, tabbed PDF viewer that integrates with KDE Plasma and Dolphin"
arch=('x86_64' 'aarch64')
url="https://github.com/glennawatson/HyperPDF"
license=('MIT')
depends=('fontconfig' 'libx11' 'libice' 'libsm' 'gcc-libs' 'glibc')
optdepends=('wayland: native Wayland support' 'libxkbcommon: Wayland keyboard input' 'libegl: native Wayland rendering' 'libcups: print straight to a printer' 'libpulse: Read Aloud sound through PulseAudio or PipeWire')
# global.json pins the .NET 11 SDK.
makedepends=('dotnet-sdk>=11.0' 'clang' 'zlib')
# The package was named pdfviewerlite before the app was renamed to HyperPDF.
conflicts=('hyperpdf-bin' 'pdfviewerlite' 'pdfviewerlite-bin')
replaces=('pdfviewerlite')
options=('!strip' '!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz")
sha256sums=('14876a0bc415f308dcc539aa03f20ac5404c963e8db59dcf5ab2ab7f390cc3db')

_rid() {
  case "$CARCH" in
    x86_64) echo linux-x64 ;;
    aarch64) echo linux-arm64 ;;
  esac
}

build() {
  cd "HyperPDF-$pkgver"
  export DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1
  # The source archive has no Git history, so MinVer takes the version from pkgver.
  dotnet publish src/HyperPdf.App/HyperPdf.App.csproj -c Release -f net10.0 -r "$(_rid)" -o "$srcdir/publish" \
    -p:Version="$pkgver" -p:MinVerVersionOverride="$pkgver"
}

package() {
  cd "HyperPDF-$pkgver"
  install -Dm755 "$srcdir/publish/hyperpdf" "$pkgdir/usr/lib/hyperpdf/hyperpdf"
  # Native libraries, including the shipped Tesseract and its dependencies under their soname (libjpeg.so.62 and so on).
  for lib in "$srcdir"/publish/*.so "$srcdir"/publish/*.so.*; do
    [ -e "$lib" ] && install -Dm644 "$lib" "$pkgdir/usr/lib/hyperpdf/$(basename "$lib")"
  done
  # The English text recognition data shipped with the app.
  install -Dm644 "$srcdir/publish/tessdata/eng.traineddata" "$pkgdir/usr/lib/hyperpdf/tessdata/eng.traineddata"
  install -d "$pkgdir/usr/bin"
  ln -s /usr/lib/hyperpdf/hyperpdf "$pkgdir/usr/bin/hyperpdf"
  install -Dm644 packaging/linux/net.glennwatson.HyperPDF.desktop "$pkgdir/usr/share/applications/net.glennwatson.HyperPDF.desktop"
  install -Dm644 packaging/linux/net.glennwatson.HyperPDF.metainfo.xml "$pkgdir/usr/share/metainfo/net.glennwatson.HyperPDF.metainfo.xml"
  install -d "$pkgdir/usr/share/icons/hicolor"
  cp -R packaging/linux/icons/hicolor/. "$pkgdir/usr/share/icons/hicolor/"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
