<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Refit" />
    <ProjectReference Include="..\..\src\HyperPdfLibrary.Render.Skia\HyperPdfLibrary.Render.Skia.csproj" />
    <ProjectReference Include="..\..\src\HyperPdf.Engine\HyperPdf.Engine.csproj" />
    <PackageReference Include="bblanchon.PDFium.Linux" />
    <PackageReference Include="bblanchon.PDFium.Win32" />
    <PackageReference Include="bblanchon.PDFium.macOS" />
    <ProjectReference Include="..\HyperPdf.TestAssets\HyperPdf.TestAssets.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(IncludeReferencePdfRenderingTests)' != 'true'">
    <Compile Remove="RenderingComparison/ReferencePdfRenderingTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../reference-pdfs/ATTRIBUTION.md" Link="reference-pdfs-attribution.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../reference-pdfs/manifest.json" Link="reference-pdfs-manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Builds the PDFs with known shapes that the render parity tests compare. -->
    <Compile Include="..\HyperPdfLibrary.Tests\Rendering\RenderTestPdf.cs" Link="RenderTestPdf.cs" />
    <!-- Generates the CMYK ICC profiles of the PDFium colour parity test from a documented ink model. -->
    <Compile Include="..\HyperPdfLibrary.Tests\Graphics\IccCmykFixture.cs" Link="Shared\IccCmykFixture.cs" />
    <Compile Include="..\HyperPdfLibrary.Tests\Graphics\IccTestProfileBuilder.cs" Link="Shared\IccTestProfileBuilder.cs" />
    <Compile Include="..\HyperPdfLibrary.Tests\Graphics\IccReference.cs" Link="Shared\IccReference.cs" />
    <!-- Encrypted and structured fixtures for the page editing parity tests. -->
    <Compile Include="..\HyperPdfLibrary.Tests\Writing\WritingTestDocuments.cs" Link="Shared\WritingTestDocuments.cs" />
    <Compile Include="..\HyperPdfLibrary.Tests\Editing\EditingTestDocuments.cs" Link="Shared\EditingTestDocuments.cs" />
    <!-- The two page book with a form, outline, destinations, labels, layer and embedded file that the carried structure tests copy. -->
    <Compile Include="..\HyperPdfLibrary.Tests\Editing\CarryTestDocuments.cs" Link="Shared\CarryTestDocuments.cs" />
    <!-- Builds the PDFs with embedded test fonts that the font parity tests compare. -->
    <Compile Include="..\HyperPdfLibrary.Tests\Fonts\CharstringWriter.cs" Link="Fonts\CharstringWriter.cs" />
    <Compile Include="..\HyperPdfLibrary.Tests\Fonts\FontSpec.cs" Link="Fonts\FontSpec.cs" />
    <Compile Include="..\HyperPdfLibrary.Tests\Fonts\FontTestDocument.cs" Link="Fonts\FontTestDocument.cs" />
    <Compile Include="..\HyperPdfLibrary.Tests\Fonts\TestFontPrograms.cs" Link="Fonts\TestFontPrograms.cs" />
    <!-- Builds the PDFs with fonts embedded through the library that the embedded font parity tests compare. -->
    <Compile Include="..\HyperPdfLibrary.Tests\Fonts\Embedding\EmbeddedFontPdf.cs" Link="Fonts\EmbeddedFontPdf.cs" />
    <Compile Include="..\HyperPdfLibrary.Tests\Creation\CreatedFiles.cs" Link="Shared\CreatedFiles.cs" />
    <!-- Prepares the font data of non-embedded fonts once, so the synchronous text and render paths do not depend on test order. -->
    <Compile Include="..\HyperPdfLibrary.Tests\Fonts\FontDataWarmUp.cs" Link="Fonts\FontDataWarmUp.cs" />
    <!-- Caps the tests running at once in this process, which shares a small CI runner with other test processes. -->
    <Compile Include="..\HyperPdfLibrary.Tests\TestParallelLimit.cs" Link="TestParallelLimit.cs" />
    <Compile Include="..\HyperPdfLibrary.Tests\Fonts\Embedding\ScriptedShaper.cs" Link="Fonts\ScriptedShaper.cs" />
    <Compile Include="..\HyperPdfLibrary.Tests\Security\PublicKeyPdf.cs" Link="Security\PublicKeyPdf.cs" />
    <Compile Include="..\HyperPdfLibrary.Tests\Security\PublicKeyCipher.cs" Link="Security\PublicKeyCipher.cs" />
    <Compile Include="..\HyperPdfLibrary.Tests\Security\EcdhRecipients.cs" Link="Security\EcdhRecipients.cs" />
    <EmbeddedResource Include="..\HyperPdfLibrary.Tests\Security\Data\*" LogicalName="HyperPdfLibrary.Tests.Security.Ecdh.%(Filename)%(Extension)" />
    <Compile Include="..\HyperPdfLibrary.Tests\Robustness\LinearizedDocuments.cs" Link="LinearizedDocuments.cs" />
    <!-- The JPEG 2000 test encoder, which writes the HTJ2K images the high-throughput parity tests compare. -->
    <Compile Include="..\HyperPdfLibrary.Tests\Graphics\Jpx\JpxTest*.cs" Link="Jpx\%(Filename)%(Extension)" />
    <Compile Include="..\HyperPdfLibrary.Tests\Graphics\Jpx\JpxFixtures.cs" Link="Jpx\JpxFixtures.cs" />
    <Compile Include="..\..\scripts\JpxHtTableBuilder.cs" Link="Jpx\JpxHtTableBuilder.cs" />
    <EmbeddedResource Include="..\..\src\HyperPdfLibrary\Graphics\Images\Jpx\Data\T814CxtVlc.txt" LogicalName="T814CxtVlc.txt" />
    <Compile Include="..\HyperPdfLibrary.Tests\Graphics\Jpeg\JpegTestRandom.cs" Link="Jpx\JpegTestRandom.cs" />
  </ItemGroup>
</Project>
