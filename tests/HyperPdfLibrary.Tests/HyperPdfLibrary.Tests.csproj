<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\..\src\HyperPdfLibrary\HyperPdfLibrary.csproj" />
    <ProjectReference Include="..\..\src\HyperPdfLibrary.Render.Skia\HyperPdfLibrary.Render.Skia.csproj" />
    <ProjectReference Include="..\HyperPdf.TestAssets\HyperPdf.TestAssets.csproj" />
  </ItemGroup>

  <!-- The HT table generator's builder is shared with the tests, which rebuild the decoder's tables from the T.814 rows
       and the test encoder reads the same rows. -->
  <ItemGroup>
    <Compile Include="..\..\scripts\JpxHtTableBuilder.cs" Link="Graphics\Jpx\JpxHtTableBuilder.cs" />
    <Compile Include="..\..\scripts\KnownNameTableBuilder.cs" Link="Syntax\KnownNameTableBuilder.cs" />
    <EmbeddedResource Include="..\..\src\HyperPdfLibrary\Objects\KnownName.cs" LogicalName="KnownName.cs" />
    <EmbeddedResource Include="..\..\src\HyperPdfLibrary\Objects\KnownNameSpellings.cs" LogicalName="KnownNameSpellings.cs" />
    <EmbeddedResource Include="..\..\src\HyperPdfLibrary\Graphics\Images\Jpx\Data\T814CxtVlc.txt" LogicalName="T814CxtVlc.txt" />
    <EmbeddedResource Include="..\..\src\HyperPdfLibrary\Graphics\Images\Jpx\JpxHtTables.cs" LogicalName="JpxHtTables.cs" />
  </ItemGroup>

  <!-- veraPDF's results for its PDF/A test files, recorded by scripts/RecordVeraPdfResults.cs, for the validator agreement test. -->
  <ItemGroup>
    <EmbeddedResource Include="Conformance\VeraPdf\Data\verapdf-results.tsv" LogicalName="HyperPdfLibrary.Tests.VeraPdfRecordedResults.tsv" />
  </ItemGroup>

  <!-- OpenSSL's ECDH recipient envelopes and their test-only keys, read by Security/EcdhRecipients.cs. -->
  <ItemGroup>
    <EmbeddedResource Include="Security\Data\*" LogicalName="HyperPdfLibrary.Tests.Security.Ecdh.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- OpenSSL's SHA-3 and SHAKE256 signatures over one prepared file, read by Signatures/Sha3Signatures.cs. -->
  <ItemGroup>
    <EmbeddedResource Include="Signatures\Data\*" LogicalName="HyperPdfLibrary.Tests.Signatures.Sha3.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- OpenSSL's elliptic-curve and EdDSA signatures over the same prepared file, read by Signatures/EcSignatures.cs. -->
  <ItemGroup>
    <EmbeddedResource Include="Signatures\EcData\*" LogicalName="HyperPdfLibrary.Tests.Signatures.Ec.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
