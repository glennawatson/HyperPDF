<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Refit" />
    <ProjectReference Include="..\..\src\HyperPdfLibrary.Render.Skia\HyperPdfLibrary.Render.Skia.csproj" />
    <ProjectReference Include="..\..\src\PdfViewerLite.HyperPdf\PdfViewerLite.HyperPdf.csproj" />
    <!-- PDFium is the comparison baseline for the parity tests; the adapter itself does not reference it. -->
    <ProjectReference Include="..\..\src\PdfViewerLite.Pdfium\PdfViewerLite.Pdfium.csproj" />
    <ProjectReference Include="..\PdfViewerLite.TestAssets\PdfViewerLite.TestAssets.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\render-corpus\corpus.json" Link="render-corpus.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Builds the PDFs with known shapes that the render parity tests compare. -->
    <Compile Include="..\HyperPdfLibrary.Tests\Rendering\RenderTestPdf.cs" Link="RenderTestPdf.cs" />
    <!-- Encrypted and structured fixtures for the page editing parity tests. -->
    <Compile Include="..\HyperPdfLibrary.Tests\Writing\WritingTestDocuments.cs" Link="Shared\WritingTestDocuments.cs" />
    <Compile Include="..\HyperPdfLibrary.Tests\Editing\EditingTestDocuments.cs" Link="Shared\EditingTestDocuments.cs" />
    <!-- The two page book with a form, outline, destinations, labels, layer and embedded file that the carried structure tests copy. -->
    <Compile Include="..\HyperPdfLibrary.Tests\Editing\CarryTestDocuments.cs" Link="Shared\CarryTestDocuments.cs" />
    <!-- Builds the PDFs with embedded test fonts that the font parity tests compare. -->
    <Compile Include="..\HyperPdfLibrary.Tests\Fonts\CharstringWriter.cs" Link="Fonts\CharstringWriter.cs" />
    <Compile Include="..\HyperPdfLibrary.Tests\Fonts\FontSpec.cs" Link="Fonts\FontSpec.cs" />
    <Compile Include="..\HyperPdfLibrary.Tests\Fonts\FontTestDocument.cs" Link="Fonts\FontTestDocument.cs" />
    <Compile Include="..\HyperPdfLibrary.Tests\Fonts\TestFontPrograms.cs" Link="Fonts\TestFontPrograms.cs" />
    <!-- The JPEG 2000 test encoder, which writes the HTJ2K images the high-throughput parity tests compare. -->
    <Compile Include="..\HyperPdfLibrary.Tests\Graphics\Jpx\JpxTest*.cs" Link="Jpx\%(Filename)%(Extension)" />
    <Compile Include="..\..\scripts\JpxHtTableBuilder.cs" Link="Jpx\JpxHtTableBuilder.cs" />
    <EmbeddedResource Include="..\..\src\HyperPdfLibrary\Graphics\Images\Jpx\Data\T814CxtVlc.txt" LogicalName="T814CxtVlc.txt" />
    <Compile Include="..\HyperPdfLibrary.Tests\Graphics\Jpeg\JpegTestRandom.cs" Link="Jpx\JpegTestRandom.cs" />
  </ItemGroup>
</Project>
