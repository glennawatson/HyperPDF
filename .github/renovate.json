{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigests",
    ":separateMajorReleases",
    ":combinePatchMinorReleases",
    "group:dotnetMonorepo",
    "group:nugetMonorepo",
    "security:openssf-scorecard"
  ],
  "mode": "full",
  "timezone": "Australia/Melbourne",
  "prConcurrentLimit": 10,
  "prHourlyLimit": 10,
  "labels": ["dependencies"],
  "recreateWhen": "auto",
  "semanticCommits": "enabled",
  "semanticCommitType": "build",
  "semanticCommitScope": "deps",
  "commitMessageAction": "bump",
  "osvVulnerabilityAlerts": true,
  "customManagers": [
    {
      "customType": "regex",
      "description": "The veraPDF release src/tools/InstallVeraPdf.cs installs for the PDF/A tests.",
      "managerFilePatterns": ["/^verapdf\\.json$/"],
      "matchStrings": ["\"version\":\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "veraPDF/veraPDF-apps",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d*[02468])\\.(?<patch>\\d+)$"
    }
  ],
  "vulnerabilityAlerts": {
    "schedule": ["at any time"],
    "labels": ["dependencies", "security"]
  },
  "packageRules": [
    {
      "matchManagers": ["nuget"],
      "matchPackageNames": ["/^HyperCodecs(\\.|$)/"],
      "groupName": "HyperCodecs"
    },
    {
      "matchManagers": ["nuget"],
      "matchPackageNames": ["StyleSharp.Analyzers", "PerformanceSharp.Analyzers", "SecuritySharp.Analyzers"],
      "groupName": "build analyzers",
      "labels": ["dependencies", "build-gate"]
    },
    {
      "matchManagers": ["nuget"],
      "matchPackageNames": ["/^TUnit(\\.|$)/", "/^Microsoft\\.Testing\\./"],
      "groupName": "test runner"
    },
    {
      "matchManagers": ["nuget"],
      "matchPackageNames": ["MinVer"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "matchManagers": ["nuget"],
      "matchDepTypes": ["dotnet-sdk", "msbuild-sdk"],
      "dependencyDashboardApproval": true,
      "ignoreUnstable": false
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["pin", "pinDigest"],
      "group": { "commitMessageTopic": "GitHub Actions digests" }
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["/^actions\\//", "/^github\\//", "/^microsoft\\//"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "automerge": true
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["glennawatson/actions-common"],
      "groupName": "shared actions",
      "automerge": false
    },
    {
      "description": "veraPDF tags odd minors as development builds and posts release installers after tagging.",
      "matchDepNames": ["veraPDF/veraPDF-apps"],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Keep .NET 10 package entries on 10.x.",
      "matchDatasources": ["nuget"],
      "matchPackageNames": [
        "/^Microsoft\\.Extensions\\./",
        "/^Microsoft\\.AspNetCore\\./",
        "/^Microsoft\\.NETCore\\./",
        "/^Microsoft\\.SourceLink\\./",
        "Microsoft.Build.Tasks.Git",
        "/^System\\./"
      ],
      "matchCurrentValue": "/^10\\./",
      "allowedVersions": "/^10\\./",
      "ignoreUnstable": true,
      "groupName": ".NET 10 packages",
      "groupSlug": "dotnet-10"
    },
    {
      "description": "Keep .NET 11 package entries on 11.x.",
      "matchDatasources": ["nuget"],
      "matchPackageNames": [
        "/^Microsoft\\.Extensions\\./",
        "/^Microsoft\\.AspNetCore\\./",
        "/^Microsoft\\.NETCore\\./",
        "/^Microsoft\\.SourceLink\\./",
        "Microsoft.Build.Tasks.Git",
        "/^System\\./"
      ],
      "matchCurrentValue": "/^11\\./",
      "allowedVersions": "/^11\\./",
      "ignoreUnstable": false,
      "groupName": ".NET 11 packages",
      "groupSlug": "dotnet-11"
    }
  ]
}
