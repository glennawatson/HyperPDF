<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Description>Allocation and throughput benchmarks for HyperPDF.</Description>
    <UsesTesseractNative>true</UsesTesseractNative>
  </PropertyGroup>

  <!-- The layout benchmarks use the page measurement cache and the layout reuse when Core has them, so one definition measures the baseline too. -->
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\src\HyperPdf.Core\Layout\PageFitExtentsCache.cs')">
    <DefineConstants>$(DefineConstants);HYPERPDF_FIT_EXTENTS_CACHE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HyperPdf.Core\HyperPdf.Core.csproj" />
    <ProjectReference Include="..\..\src\HyperPdf.Skia\HyperPdf.Skia.csproj" />
    <ProjectReference Include="..\..\src\HyperPdf.Platform.Cups\HyperPdf.Platform.Cups.csproj" />
    <ProjectReference Include="..\..\src\HyperPdf.Platform.Linux\HyperPdf.Platform.Linux.csproj" />
    <ProjectReference Include="..\..\src\HyperPdf.Engine\HyperPdf.Engine.csproj" />
    <ProjectReference Include="..\..\src\HyperPdfLibrary\HyperPdfLibrary.csproj" />
    <ProjectReference Include="..\..\src\HyperPdfLibrary.Render.Skia\HyperPdfLibrary.Render.Skia.csproj" />
    <ProjectReference Include="..\..\src\HyperPdf.Ocr\HyperPdf.Ocr.csproj" />
    <ProjectReference Include="..\..\src\HyperPdf.Speech\HyperPdf.Speech.csproj" />
    <ProjectReference Include="..\..\src\HyperPdf.Http\HyperPdf.Http.csproj" />
    <ProjectReference Include="..\..\src\HyperPdf.Media\HyperPdf.Media.csproj" />
    <ProjectReference Include="..\..\tests\HyperPdf.TestAssets\HyperPdf.TestAssets.csproj" />
  </ItemGroup>

  <!-- The batched tile operation, the zoom label and the single-walk page removal exist only on newer refs; a baseline ref lacks them, so their benchmarks compile only where the sources are. -->
  <PropertyGroup Condition="$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\src\HyperPdf.Core\Rendering\TileCache.cs').Contains('int otherDocumentId'))">
    <DefineConstants>$(DefineConstants);HYPERPDF_REMOVE_PAGE_PAIR</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\src\HyperPdf.App\Rendering\TileDraw.cs')">
    <Compile Include="..\..\src\HyperPdf.App\Rendering\TileDraw.cs" Link="TileBatch\TileDraw.cs" />
    <Compile Include="..\..\src\HyperPdf.App\Rendering\GpuTileBatchOperation.cs" Link="TileBatch\GpuTileBatchOperation.cs" />
    <Compile Include="..\..\src\HyperPdf.App\Rendering\GpuPreparedRenderSurface.cs" Link="TileBatch\GpuPreparedRenderSurface.cs" />
    <Compile Include="..\..\src\HyperPdf.App\Rendering\GpuAvailability.cs" Link="TileBatch\GpuAvailability.cs" />
    <Compile Include="..\..\src\HyperPdf.App\Rendering\AvaloniaRenderSurface.cs" Link="TileBatch\AvaloniaRenderSurface.cs" />
    <Compile Include="..\..\src\HyperPdf.App\Rendering\TileRenderingEventSource.cs" Link="TileBatch\TileRenderingEventSource.cs" />
  </ItemGroup>

  <ItemGroup Condition="!Exists('$(MSBuildThisFileDirectory)..\..\src\HyperPdf.App\Rendering\TileDraw.cs')">
    <Compile Remove="TileBatchOperationBenchmarks.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\src\HyperPdf.App\ViewModels\ZoomLabel.cs')">
    <Compile Include="..\..\src\HyperPdf.App\ViewModels\ZoomLabel.cs" Link="ZoomLabel.cs" />
  </ItemGroup>

  <ItemGroup Condition="!Exists('$(MSBuildThisFileDirectory)..\..\src\HyperPdf.App\ViewModels\ZoomLabel.cs')">
    <Compile Remove="ZoomLabelEaseBenchmarks.cs" />
  </ItemGroup>

  <!-- Lists the benchmarks for the allocation harness, so no reflection finds or calls them. -->
  <ItemGroup>
    <ProjectReference Include="..\HyperPdf.Benchmarks.Generator\HyperPdf.Benchmarks.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="ReactiveUI.Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\HyperPdf.App\Services\DesktopBackend.cs" Link="DesktopBackend.cs" />
    <Compile Include="..\..\src\HyperPdf.App\Views\FocusAnnouncementRepair.cs" Link="FocusAnnouncementRepair.cs" />
    <Compile Include="..\..\src\HyperPdf.App\Controls\FocusArrival.cs" Link="FocusArrival.cs" />
    <Compile Include="..\..\src\HyperPdf.App\Controls\FocusArrivalMixins.cs" Link="FocusArrivalMixins.cs" />
    <Compile Include="..\..\src\HyperPdf.App\Services\ErrorTrace.cs" Link="ErrorTrace.cs" />
    <Compile Include="..\..\src\HyperPdf.App\Rendering\GpuPageTone.cs" Link="GpuPageTone.cs" />
    <Compile Include="..\..\src\HyperPdf.App\ViewModels\AnnotationItemViewModel.cs" Link="AnnotationItemViewModel.cs" />
    <Compile Include="..\..\src\HyperPdf.App\ViewModels\AnnotationNames.cs" Link="AnnotationNames.cs" />
    <!-- The JPEG 2000 test encoder, which re-encodes a corpus page as HTJ2K for the high-throughput benchmarks. -->
    <Compile Include="..\..\tests\HyperPdfLibrary.Tests\Graphics\Jpx\JpxTest*.cs" Link="Jpx\%(Filename)%(Extension)" />
    <Compile Include="..\..\scripts\JpxHtTableBuilder.cs" Link="Jpx\JpxHtTableBuilder.cs" />
    <EmbeddedResource Include="..\..\src\HyperPdfLibrary\Graphics\Images\Jpx\Data\T814CxtVlc.txt" LogicalName="T814CxtVlc.txt" />
    <!-- The two page book with a form, outline, destinations, labels, layer and embedded file that the page copy benchmarks copy. -->
    <Compile Include="..\..\tests\HyperPdfLibrary.Tests\Editing\CarryTestDocuments.cs" Link="CarryTestDocuments.cs" />
    <Compile Include="..\..\tests\HyperPdfLibrary.Tests\Rendering\RenderTestPdf.cs" Link="RenderTestPdf.cs" />
    <Compile Include="..\..\tests\HyperPdfLibrary.Tests\Security\PublicKeyPdf.cs" Link="Security\PublicKeyPdf.cs" />
    <Compile Include="..\..\tests\HyperPdfLibrary.Tests\Security\PublicKeyCipher.cs" Link="Security\PublicKeyCipher.cs" />
    <Compile Include="..\..\tests\HyperPdfLibrary.Tests\Security\EcdhRecipients.cs" Link="Security\EcdhRecipients.cs" />
    <!-- The AES-GCM test file builder, written from ISO/TS 32003 without library code. -->
    <Compile Include="..\..\tests\HyperPdfLibrary.Tests\Security\AesGcmPdf.cs" Link="Security\AesGcmPdf.cs" />
    <Compile Include="..\..\tests\HyperPdfLibrary.Tests\Security\AesGcmLayout.cs" Link="Security\AesGcmLayout.cs" />
    <!-- The PDF MAC (ISO/TS 32004) test file builder, written from the standard without library code. -->
    <Compile Include="..\..\tests\HyperPdfLibrary.Tests\Security\MacPdf.cs" Link="Security\MacPdf.cs" />
    <Compile Include="..\..\tests\HyperPdfLibrary.Tests\Security\MacToken.cs" Link="Security\MacToken.cs" />
    <Compile Include="..\..\tests\HyperPdfLibrary.Tests\Security\MacDer.cs" Link="Security\MacDer.cs" />
    <Compile Include="..\..\tests\HyperPdfLibrary.Tests\Security\MacProtection.cs" Link="Security\MacProtection.cs" />
    <Compile Include="..\..\tests\HyperPdfLibrary.Tests\Security\PdfBytes.cs" Link="Security\PdfBytes.cs" />
    <Compile Include="..\..\tests\HyperPdfLibrary.Tests\Syntax\RawPdf.cs" Link="Syntax\RawPdf.cs" />
    <EmbeddedResource Include="..\..\tests\HyperPdfLibrary.Tests\Security\Data\*" LogicalName="HyperPdfLibrary.Tests.Security.Ecdh.%(Filename)%(Extension)" />
    <!-- OpenSSL's SHA-3 and SHAKE256 signatures, which the signature validation benchmarks check. -->
    <Compile Include="..\..\tests\HyperPdfLibrary.Tests\Signatures\Sha3Signatures.cs" Link="Signatures\Sha3Signatures.cs" />
    <EmbeddedResource Include="..\..\tests\HyperPdfLibrary.Tests\Signatures\Data\*" LogicalName="HyperPdfLibrary.Tests.Signatures.Sha3.%(Filename)%(Extension)" />
    <!-- OpenSSL's elliptic-curve and EdDSA signatures, which the elliptic-curve validation benchmarks check. -->
    <Compile Include="..\..\tests\HyperPdfLibrary.Tests\Signatures\EcSignatures.cs" Link="Signatures\EcSignatures.cs" />
    <EmbeddedResource Include="..\..\tests\HyperPdfLibrary.Tests\Signatures\EcData\*" LogicalName="HyperPdfLibrary.Tests.Signatures.Ec.%(Filename)%(Extension)" />
    <Compile Include="..\..\tests\HyperPdfLibrary.Tests\Robustness\LinearizedDocuments.cs" Link="LinearizedDocuments.cs" />
    <!-- Valid PDF/A files, so the conformant save benchmarks measure a claim that is kept rather than repaired. -->
    <Compile Include="..\..\tests\HyperPdfLibrary.Tests\Conformance\PdfAFixtures.cs" Link="Conformance\PdfAFixtures.cs" />
    <Compile Include="..\..\tests\HyperPdfLibrary.Tests\Conformance\PdfAFixtureLevel.cs" Link="Conformance\PdfAFixtureLevel.cs" />
    <Compile Include="..\..\tests\HyperPdfLibrary.Tests\Conformance\PdfAFixtureImage.cs" Link="Conformance\PdfAFixtureImage.cs" />
    <!-- A repeatable pseudo-random generator for the generated samples of the encoder benchmarks. -->
    <Compile Include="..\..\tests\HyperPdfLibrary.Tests\Filters\SampleRandom.cs" Link="Filters\SampleRandom.cs" />
    <!-- The 1.x samples the PDF 2.0 copy benchmark converts. -->
    <Compile Include="..\..\tests\HyperPdfLibrary.Tests\Pdf20\Pdf20TestPdf.cs" Link="Pdf20\Pdf20TestPdf.cs" />
    <Compile Include="..\..\tests\HyperPdfLibrary.Tests\Conformance\ConformancePdf.cs" Link="Conformance\ConformancePdf.cs" />
    <Compile Include="..\..\tests\HyperPdfLibrary.Tests\Graphics\IccTestProfileBuilder.cs" Link="Graphics\IccTestProfileBuilder.cs" />
    <!-- The documented CMYK ink-model profiles ('mft2' and 'mAB ') that the colour benchmarks convert through. -->
    <Compile Include="..\..\tests\HyperPdfLibrary.Tests\Graphics\IccCmykFixture.cs" Link="Graphics\IccCmykFixture.cs" />
    <Compile Include="..\..\tests\HyperPdfLibrary.Tests\Graphics\IccReference.cs" Link="Graphics\IccReference.cs" />
  </ItemGroup>
</Project>
