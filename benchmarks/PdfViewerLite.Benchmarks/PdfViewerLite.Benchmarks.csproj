<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Description>Allocation and throughput benchmarks for PdfViewerLite.</Description>
    <UsesTesseractNative>true</UsesTesseractNative>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PdfViewerLite.Core\PdfViewerLite.Core.csproj" />
    <ProjectReference Include="..\..\src\PdfViewerLite.Skia\PdfViewerLite.Skia.csproj" />
    <ProjectReference Include="..\..\src\PdfViewerLite.Platform.Cups\PdfViewerLite.Platform.Cups.csproj" />
    <ProjectReference Include="..\..\src\PdfViewerLite.Platform.Linux\PdfViewerLite.Platform.Linux.csproj" />
    <ProjectReference Include="..\..\src\PdfViewerLite.HyperPdf\PdfViewerLite.HyperPdf.csproj" />
    <ProjectReference Include="..\..\src\HyperPdfLibrary\HyperPdfLibrary.csproj" />
    <ProjectReference Include="..\..\src\HyperPdfLibrary.Render.Skia\HyperPdfLibrary.Render.Skia.csproj" />
    <ProjectReference Include="..\..\src\PdfViewerLite.Ocr\PdfViewerLite.Ocr.csproj" />
    <ProjectReference Include="..\..\src\PdfViewerLite.Speech\PdfViewerLite.Speech.csproj" />
    <ProjectReference Include="..\..\src\PdfViewerLite.Http\PdfViewerLite.Http.csproj" />
    <ProjectReference Include="..\..\tests\PdfViewerLite.TestAssets\PdfViewerLite.TestAssets.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\PdfViewerLite.App\Services\DesktopBackend.cs" Link="DesktopBackend.cs" />
    <Compile Include="..\..\src\PdfViewerLite.App\Views\FocusAnnouncementRepair.cs" Link="FocusAnnouncementRepair.cs" />
    <!-- The JPEG 2000 test encoder, which re-encodes a corpus page as HTJ2K for the high-throughput benchmarks. -->
    <Compile Include="..\..\tests\HyperPdfLibrary.Tests\Graphics\Jpx\JpxTest*.cs" Link="Jpx\%(Filename)%(Extension)" />
    <Compile Include="..\..\scripts\JpxHtTableBuilder.cs" Link="Jpx\JpxHtTableBuilder.cs" />
    <EmbeddedResource Include="..\..\src\HyperPdfLibrary\Graphics\Images\Jpx\Data\T814CxtVlc.txt" LogicalName="T814CxtVlc.txt" />
    <!-- The two page book with a form, outline, destinations, labels, layer and embedded file that the page copy benchmarks copy. -->
    <Compile Include="..\..\tests\HyperPdfLibrary.Tests\Editing\CarryTestDocuments.cs" Link="CarryTestDocuments.cs" />
  </ItemGroup>
</Project>
