<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:PdfViewerLite.App.Controls"
             xmlns:views="using:PdfViewerLite.App.Views"
             x:Class="PdfViewerLite.App.Views.DocumentView">
  <!-- Layout only: every binding is made in code with ReactiveUI.Binding (DocumentView.axaml.cs). -->
  <DockPanel>
    <!-- Read mode's only control: the way back to the tool bars. -->
    <Border x:Name="ReadModeBar" DockPanel.Dock="Top" Classes="toolbar subbar" AutomationProperties.Name="Read mode" AutomationProperties.ControlTypeOverride="ToolBar">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="ReadModeTitle" Classes="secondary" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="1" AutomationProperties.Name="Leave Read Mode" x:Name="LeaveReadModeButton" views:ControlHelp.Text="{x:Static views:Descriptions.LeaveReadMode}" Classes="tool">
          <StackPanel Orientation="Horizontal">
            <Path Classes="icon nav" Data="{StaticResource IconDone}" />
            <TextBlock Classes="label" Text="Leave Read Mode" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
    <!-- Everything above the pages; hidden while presenting or reading. -->
    <StackPanel x:Name="Chrome" DockPanel.Dock="Top">
    <!-- Named menus keep related actions together. Their labels stay visible in icons-only mode. -->
    <Border x:Name="MainToolBar" DockPanel.Dock="Top" Classes="toolbar" AutomationProperties.Name="Tool bar" AutomationProperties.LandmarkType="Navigation" AutomationProperties.ControlTypeOverride="ToolBar">
      <!-- Rows in reading order, so Tab moves through the top row before the one beneath it. -->
      <StackPanel>
        <!-- Wraps rather than clips when the window is narrow, so no control is ever hidden. -->
        <WrapPanel Orientation="Horizontal">
          <ToggleButton AutomationProperties.Name="Sidebar" x:Name="SidebarToggle" views:ControlHelp.Text="{x:Static views:Descriptions.Sidebar}" Classes="tool">
            <StackPanel Orientation="Horizontal">
              <Path Classes="icon nav" Data="{StaticResource IconSidebar}" />
              <TextBlock Classes="label" Text="Sidebar" />
            </StackPanel>
          </ToggleButton>
          <Rectangle Classes="separator" />
          <Button AutomationProperties.Name="Back" x:Name="BackButton" views:ControlHelp.Text="{x:Static views:Descriptions.Back}" Classes="tool">
            <StackPanel Orientation="Horizontal">
              <Path Classes="icon nav" Data="{StaticResource IconBack}" />
              <TextBlock Classes="label" Text="Back" />
            </StackPanel>
          </Button>
          <Button AutomationProperties.Name="Forward" x:Name="ForwardButton" views:ControlHelp.Text="{x:Static views:Descriptions.Forward}" Classes="tool">
            <StackPanel Orientation="Horizontal">
              <TextBlock Classes="label leading" Text="Forward" />
              <Path Classes="icon nav" Data="{StaticResource IconForward}" />
            </StackPanel>
          </Button>
          <Rectangle Classes="separator" />
          <!-- One group on one centre line: the arrows together, then the page box and the page count. -->
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button AutomationProperties.Name="Previous page" x:Name="PreviousPageButton" views:ControlHelp.Text="{x:Static views:Descriptions.PreviousPage}" Classes="tool">
              <Path Classes="icon nav" Data="{StaticResource IconPageUp}" />
            </Button>
            <Button AutomationProperties.Name="Next page" x:Name="NextPageButton" views:ControlHelp.Text="{x:Static views:Descriptions.NextPage}" Classes="tool">
              <Path Classes="icon nav" Data="{StaticResource IconPageDown}" />
            </Button>
            <TextBox x:Name="PageBox" views:ControlHelp.Text="{x:Static views:Descriptions.PageNumber}" AutomationProperties.Name="Page number" Width="56" Height="30" MinHeight="30" Margin="4,0,0,0" Padding="6,0" VerticalAlignment="Center"
                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
            <TextBlock x:Name="PageCountText" Classes="secondary" VerticalAlignment="Center" Margin="6,0" />
          </StackPanel>
          <Rectangle Classes="separator" />
          <Button AutomationProperties.Name="Zoom out" x:Name="ZoomOutButton" views:ControlHelp.Text="{x:Static views:Descriptions.ZoomOut}" Classes="tool">
            <Path Classes="icon nav" Data="{StaticResource IconZoomOut}" />
          </Button>
          <!-- Named by its content, the zoom, which is announced when it changes. -->
          <Button x:Name="ZoomButton" views:ControlHelp.Text="{x:Static views:Descriptions.ZoomMenu}" AutomationProperties.LiveSetting="Polite" Classes="tool" MinWidth="64">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem x:Name="FitWidthItem" views:ControlHelp.Text="{x:Static views:Descriptions.FitWidth}" Header="Fit _Width" InputGesture="Ctrl+2" />
                <MenuItem x:Name="FitPageItem" views:ControlHelp.Text="{x:Static views:Descriptions.FitPage}" Header="Fit _Page" InputGesture="Ctrl+1" />
                <Separator />
                <MenuItem x:Name="Zoom50Item" views:ControlHelp.Text="{x:Static views:Descriptions.Zoom50}" Header="50%" />
                <MenuItem x:Name="Zoom75Item" views:ControlHelp.Text="{x:Static views:Descriptions.Zoom75}" Header="75%" />
                <MenuItem x:Name="Zoom100Item" views:ControlHelp.Text="{x:Static views:Descriptions.Zoom100}" Header="100%" InputGesture="Ctrl+0" />
                <MenuItem x:Name="Zoom125Item" views:ControlHelp.Text="{x:Static views:Descriptions.Zoom125}" Header="125%" />
                <MenuItem x:Name="Zoom150Item" views:ControlHelp.Text="{x:Static views:Descriptions.Zoom150}" Header="150%" />
                <MenuItem x:Name="Zoom200Item" views:ControlHelp.Text="{x:Static views:Descriptions.Zoom200}" Header="200%" />
                <MenuItem x:Name="Zoom400Item" views:ControlHelp.Text="{x:Static views:Descriptions.Zoom400}" Header="400%" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button AutomationProperties.Name="Zoom in" x:Name="ZoomInButton" views:ControlHelp.Text="{x:Static views:Descriptions.ZoomIn}" Classes="tool">
            <Path Classes="icon nav" Data="{StaticResource IconZoomIn}" />
          </Button>
        </WrapPanel>

        <WrapPanel Orientation="Horizontal">
          <Button AutomationProperties.Name="Save" x:Name="SaveButton" views:ControlHelp.Text="{x:Static views:Descriptions.Save}" Classes="tool">
            <StackPanel Orientation="Horizontal">
              <Path Classes="icon add" Data="{StaticResource IconSave}" />
              <TextBlock Classes="label" Text="Save" />
            </StackPanel>
          </Button>
          <Button AutomationProperties.Name="Print" x:Name="PrintItem" views:ControlHelp.Text="{x:Static views:Descriptions.Print}" Classes="tool">
            <StackPanel Orientation="Horizontal">
              <Path Classes="icon nav" Data="{StaticResource IconPrint}" />
              <TextBlock Classes="label" Text="Print" />
            </StackPanel>
          </Button>
          <ToggleButton AutomationProperties.Name="Annotate" x:Name="AnnotateToggle" views:ControlHelp.Text="{x:Static views:Descriptions.Annotate}" Classes="tool">
            <StackPanel Orientation="Horizontal">
              <Path Classes="icon edit" Data="{StaticResource IconHighlight}" />
              <TextBlock Classes="label" Text="Annotate" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton AutomationProperties.Name="Fill &amp; Sign" x:Name="FillSignToggle" views:ControlHelp.Text="{x:Static views:Descriptions.FillSign}" Classes="tool">
            <StackPanel Orientation="Horizontal">
              <Path Classes="icon edit" Data="{StaticResource IconFillSign}" />
              <TextBlock Classes="label" Text="Fill &amp; Sign" />
            </StackPanel>
          </ToggleButton>
          <Rectangle Classes="separator" />
          <ToggleButton AutomationProperties.Name="Find" x:Name="FindToggle" views:ControlHelp.Text="{x:Static views:Descriptions.Find}" Classes="tool">
            <StackPanel Orientation="Horizontal">
              <Path Classes="icon nav" Data="{StaticResource IconSearch}" />
              <TextBlock Classes="label" Text="Find" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton AutomationProperties.Name="Focus" x:Name="FocusToggle" views:ControlHelp.Text="{x:Static views:Descriptions.Focus}" Classes="tool">
            <StackPanel Orientation="Horizontal">
              <Path Classes="icon nav" Data="{StaticResource IconFocus}" />
              <TextBlock Classes="label" Text="Focus" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton AutomationProperties.Name="Read Aloud" x:Name="ReadAloudToggle" views:ControlHelp.Text="{x:Static views:Descriptions.ReadAloud}" Classes="tool">
            <StackPanel Orientation="Horizontal">
              <Path Classes="icon nav" Data="{StaticResource IconSpeaker}" />
              <TextBlock Classes="label" Text="Read Aloud" />
            </StackPanel>
          </ToggleButton>
          <Button x:Name="ViewMenuButton" views:ControlHelp.Text="{x:Static views:Descriptions.ViewMenu}" AutomationProperties.Name="View" Classes="tool" Content="View ▾">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem x:Name="RotateLeftItem" views:ControlHelp.Text="{x:Static views:Descriptions.RotateLeft}" Header="Rotate _Left" InputGesture="Ctrl+Left" />
                <MenuItem x:Name="RotateRightItem" views:ControlHelp.Text="{x:Static views:Descriptions.RotateRight}" Header="Rotate _Right" InputGesture="Ctrl+Right" />
                <Separator />
                <MenuItem x:Name="SingleLayoutItem" views:ControlHelp.Text="{x:Static views:Descriptions.SinglePage}" Header="_Single Page" ToggleType="Radio" GroupName="PageLayout" />
                <MenuItem x:Name="DualLayoutItem" views:ControlHelp.Text="{x:Static views:Descriptions.DualPage}" Header="_Two Pages" ToggleType="Radio" GroupName="PageLayout" />
                <MenuItem x:Name="CoverLayoutItem" views:ControlHelp.Text="{x:Static views:Descriptions.DualPageCover}" Header="Two Pages with _Cover" ToggleType="Radio" GroupName="PageLayout" />
                <MenuItem x:Name="ReadModeItem" views:ControlHelp.Text="{x:Static views:Descriptions.ReadMode}" Header="Rea_d Mode" InputGesture="Ctrl+H" />
                <MenuItem x:Name="PresentItem" views:ControlHelp.Text="{x:Static views:Descriptions.Present}" Header="P_resent" InputGesture="Shift+F5" />
                <MenuItem x:Name="CaretModeItem" views:ControlHelp.Text="{x:Static views:Descriptions.CaretNavigation}" Header="_Caret Navigation" InputGesture="F7" ToggleType="CheckBox" />
                <MenuItem x:Name="SplitViewItem" views:ControlHelp.Text="{x:Static views:Descriptions.SplitView}" Header="Split _View" ToggleType="CheckBox" />
                <MenuItem x:Name="PageByPageItem" views:ControlHelp.Text="{x:Static views:Descriptions.PageByPage}" Header="Page _by Page" ToggleType="CheckBox" />
                <MenuItem x:Name="AutoScrollItem" views:ControlHelp.Text="{x:Static views:Descriptions.AutoScroll}" Header="_Auto-scroll" InputGesture="Ctrl+Shift+H" ToggleType="CheckBox" />
                <Separator />
                <MenuItem x:Name="FirstPageItem" views:ControlHelp.Text="{x:Static views:Descriptions.FirstPage}" Header="_First Page" InputGesture="Ctrl+Home" />
                <MenuItem x:Name="LastPageItem" views:ControlHelp.Text="{x:Static views:Descriptions.LastPage}" Header="Last Pa_ge" InputGesture="Ctrl+End" />
                <Separator />
                <!-- What dragging on the pages does. -->
                <MenuItem x:Name="SelectTextToolItem" views:ControlHelp.Text="{x:Static views:Descriptions.SelectTextTool}" Header="Select Te_xt" ToggleType="Radio" GroupName="PageTool" />
                <MenuItem x:Name="HandToolItem" views:ControlHelp.Text="{x:Static views:Descriptions.HandTool}" Header="_Hand Tool" ToggleType="Radio" GroupName="PageTool" />
                <MenuItem x:Name="ZoomAreaToolItem" views:ControlHelp.Text="{x:Static views:Descriptions.ZoomAreaTool}" Header="_Zoom to Area" ToggleType="Radio" GroupName="PageTool" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button x:Name="DocumentMenuButton" views:ControlHelp.Text="{x:Static views:Descriptions.DocumentMenu}" AutomationProperties.Name="Document" Classes="tool" Content="Document ▾">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem x:Name="SaveItem" views:ControlHelp.Text="{x:Static views:Descriptions.Save}" Header="_Save" InputGesture="Ctrl+S" />
                <MenuItem x:Name="SaveAsItem" views:ControlHelp.Text="{x:Static views:Descriptions.SaveAs}" Header="Save _As…" InputGesture="Ctrl+Shift+S" />
                <MenuItem x:Name="OptimizeCopyItem" views:ControlHelp.Text="{x:Static views:Descriptions.OptimizeCopy}" Header="Save _Optimised Copy…" />
                <MenuItem x:Name="ApplyRedactionsItem" views:ControlHelp.Text="{x:Static views:Descriptions.ApplyRedactions}" Header="Apply _Redactions…" />
                <MenuItem x:Name="SelectAllItem" views:ControlHelp.Text="{x:Static views:Descriptions.SelectAll}" Header="Select A_ll Text on Page" InputGesture="Ctrl+A" />
                <MenuItem x:Name="ReloadItem" views:ControlHelp.Text="{x:Static views:Descriptions.Reload}" Header="Re_load" InputGesture="F5" />
                <MenuItem x:Name="ShowInFolderItem" views:ControlHelp.Text="{x:Static views:Descriptions.ShowInFolder}" Header="Show in _Folder" />
                <MenuItem x:Name="PropertiesItem" views:ControlHelp.Text="{x:Static views:Descriptions.Properties}" Header="_Properties" InputGesture="Alt+Enter" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button x:Name="ToolsMenuButton" views:ControlHelp.Text="{x:Static views:Descriptions.ToolsMenu}" AutomationProperties.Name="Tools" Classes="tool" Content="Tools ▾">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem x:Name="MeasureItem" views:ControlHelp.Text="{x:Static views:Descriptions.Measure}" Header="_Measure" InputGesture="Ctrl+Shift+M" />
                <MenuItem x:Name="SnapshotToolItem" views:ControlHelp.Text="{x:Static views:Descriptions.SnapshotTool}" Header="_Snapshot" ToggleType="CheckBox" />
                <MenuItem x:Name="RecognizeTextItem" views:ControlHelp.Text="{x:Static views:Descriptions.RecognizeText}" Header="Recognise _Text" />
                <MenuItem x:Name="RecognizeLanguageItem" views:ControlHelp.Text="{x:Static views:Descriptions.RecognizeTextInLanguage}" Header="Recognise Text in Another _Language…" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </WrapPanel>
      </StackPanel>
    </Border>

    <!-- Measuring: shown only while measuring. Click points on the page; double-click or Enter finishes, Esc clears. -->
    <Border x:Name="MeasureBar" DockPanel.Dock="Top" Classes="toolbar subbar" AutomationProperties.Name="Measure tools" AutomationProperties.ControlTypeOverride="ToolBar">
      <Grid ColumnDefinitions="*,Auto">
        <WrapPanel Orientation="Horizontal">
          <ToggleButton AutomationProperties.Name="Distance" x:Name="DistanceTool" views:ControlHelp.Text="{x:Static views:Descriptions.Distance}" Classes="tool">
            <StackPanel Orientation="Horizontal">
              <Path Classes="icon nav" Data="{StaticResource IconRuler}" />
              <TextBlock Classes="label" Text="Distance" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton AutomationProperties.Name="Perimeter" x:Name="PerimeterTool" views:ControlHelp.Text="{x:Static views:Descriptions.Perimeter}" Classes="tool">
            <StackPanel Orientation="Horizontal">
              <Path Classes="icon nav" Data="{StaticResource IconPerimeter}" />
              <TextBlock Classes="label" Text="Perimeter" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton AutomationProperties.Name="Area" x:Name="AreaTool" views:ControlHelp.Text="{x:Static views:Descriptions.Area}" Classes="tool">
            <StackPanel Orientation="Horizontal">
              <Path Classes="icon nav" Data="{StaticResource IconArea}" />
              <TextBlock Classes="label" Text="Area" />
            </StackPanel>
          </ToggleButton>
          <Rectangle Classes="separator" />
          <TextBlock x:Name="ScaleLabel" Classes="secondary" Text="Scale" VerticalAlignment="Center" Margin="4,0,6,0" />
          <TextBox x:Name="ScaleBox" views:ControlHelp.Text="{x:Static views:Descriptions.MeasureScale}" AutomationProperties.Name="Measuring scale" Width="130" Height="30" MinHeight="30" VerticalAlignment="Center"
                   VerticalContentAlignment="Center" />
          <TextBlock x:Name="MeasureResult" AutomationProperties.LiveSetting="Polite" VerticalAlignment="Center" Margin="12,0" FontWeight="SemiBold" />
        </WrapPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button AutomationProperties.Name="Keep on page" x:Name="MeasureKeepButton" views:ControlHelp.Text="{x:Static views:Descriptions.MeasureKeep}" Classes="tool">
            <StackPanel Orientation="Horizontal">
              <Path Classes="icon add" Data="{StaticResource IconAdd}" />
              <TextBlock Classes="label" Text="Keep" />
            </StackPanel>
          </Button>
          <Button AutomationProperties.Name="Clear measurement" x:Name="MeasureClearButton" views:ControlHelp.Text="{x:Static views:Descriptions.MeasureClear}" Classes="tool">
            <StackPanel Orientation="Horizontal">
              <Path Classes="icon nav" Data="{StaticResource IconClose}" />
              <TextBlock Classes="label" Text="Clear" />
            </StackPanel>
          </Button>
          <Button AutomationProperties.Name="Done measuring" x:Name="MeasureDoneButton" views:ControlHelp.Text="{x:Static views:Descriptions.MeasureDone}" Classes="tool">
            <StackPanel Orientation="Horizontal">
              <Path Classes="icon nav" Data="{StaticResource IconDone}" />
              <TextBlock Classes="label" Text="Done" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Annotate tools: shown only while annotating. Each tool has its name beside its icon. -->
    <Border x:Name="AnnotateBar" DockPanel.Dock="Top" Classes="toolbar subbar" AutomationProperties.Name="Annotate tools" AutomationProperties.ControlTypeOverride="ToolBar">
      <Grid ColumnDefinitions="*,Auto">
        <WrapPanel Orientation="Horizontal">
          <ToggleButton AutomationProperties.Name="Select" x:Name="SelectTool" views:ControlHelp.Text="{x:Static views:Descriptions.SelectTool}" Classes="tool">
            <StackPanel Orientation="Horizontal">
              <Path Classes="icon nav" Data="{StaticResource IconCursor}" />
              <TextBlock Classes="label" Text="Select" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton AutomationProperties.Name="Highlight" x:Name="HighlightTool" views:ControlHelp.Text="{x:Static views:Descriptions.HighlightTool}" Classes="tool">
            <StackPanel Orientation="Horizontal">
              <Path Classes="icon edit" Data="{StaticResource IconHighlight}" />
              <TextBlock Classes="label" Text="Highlight" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton AutomationProperties.Name="Underline" x:Name="UnderlineTool" views:ControlHelp.Text="{x:Static views:Descriptions.UnderlineTool}" Classes="tool">
            <StackPanel Orientation="Horizontal">
              <Path Classes="icon edit" Data="{StaticResource IconUnderline}" />
              <TextBlock Classes="label" Text="Underline" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton AutomationProperties.Name="Strike" x:Name="StrikeOutTool" views:ControlHelp.Text="{x:Static views:Descriptions.StrikeTool}" Classes="tool">
            <StackPanel Orientation="Horizontal">
              <Path Classes="icon edit" Data="{StaticResource IconStrike}" />
              <TextBlock Classes="label" Text="Strike" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton AutomationProperties.Name="Draw" x:Name="DrawTool" views:ControlHelp.Text="{x:Static views:Descriptions.DrawTool}" Classes="tool">
            <StackPanel Orientation="Horizontal">
              <Path Classes="icon edit" Data="{StaticResource IconDraw}" />
              <TextBlock Classes="label" Text="Draw" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton AutomationProperties.Name="Note" x:Name="NoteTool" views:ControlHelp.Text="{x:Static views:Descriptions.NoteTool}" Classes="tool">
            <StackPanel Orientation="Horizontal">
              <Path Classes="icon add" Data="{StaticResource IconNote}" />
              <TextBlock Classes="label" Text="Note" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton AutomationProperties.Name="Text" x:Name="TextTool" views:ControlHelp.Text="{x:Static views:Descriptions.TextTool}" Classes="tool">
            <StackPanel Orientation="Horizontal">
              <Path Classes="icon add" Data="{StaticResource IconText}" />
              <TextBlock Classes="label" Text="Text" />
            </StackPanel>
          </ToggleButton>
          <Button AutomationProperties.Name="Shape" x:Name="ShapeButton" views:ControlHelp.Text="{x:Static views:Descriptions.Shape}" Classes="tool">
            <StackPanel Orientation="Horizontal">
              <Path Classes="icon edit" Data="{StaticResource IconShape}" />
              <TextBlock x:Name="ShapeText" Classes="label" Text="Shape" />
            </StackPanel>
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem x:Name="RectangleItem" views:ControlHelp.Text="{x:Static views:Descriptions.Rectangle}" Header="_Rectangle" />
                <MenuItem x:Name="EllipseItem" views:ControlHelp.Text="{x:Static views:Descriptions.Ellipse}" Header="_Ellipse" />
                <MenuItem x:Name="ArrowItem" views:ControlHelp.Text="{x:Static views:Descriptions.Arrow}" Header="_Arrow" />
                <MenuItem x:Name="LineItem" views:ControlHelp.Text="{x:Static views:Descriptions.Line}" Header="_Line" />
                <Separator />
                <MenuItem x:Name="CalloutItem" views:ControlHelp.Text="{x:Static views:Descriptions.Callout}" Header="_Callout" />
                <MenuItem x:Name="PolygonItem" views:ControlHelp.Text="{x:Static views:Descriptions.Polygon}" Header="_Polygon" />
                <MenuItem x:Name="CloudItem" views:ControlHelp.Text="{x:Static views:Descriptions.Cloud}" Header="Cl_oud" />
                <MenuItem x:Name="PolyLineItem" views:ControlHelp.Text="{x:Static views:Descriptions.PolyLine}" Header="Co_nnected Lines" />
                <Separator />
                <MenuItem x:Name="RedactAreaItem" views:ControlHelp.Text="{x:Static views:Descriptions.RedactArea}" Header="Mark Area to Re_dact" />
                <MenuItem x:Name="RedactTextItem" views:ControlHelp.Text="{x:Static views:Descriptions.RedactText}" Header="Mark _Text to Redact" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button AutomationProperties.Name="Stamp" x:Name="StampButton" views:ControlHelp.Text="{x:Static views:Descriptions.Stamp}" Classes="tool">
            <StackPanel Orientation="Horizontal">
              <Path Classes="icon add" Data="{StaticResource IconStamp}" />
              <TextBlock x:Name="StampText" Classes="label" Text="Stamp" />
            </StackPanel>
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem x:Name="ApprovedItem" views:ControlHelp.Text="{x:Static views:Descriptions.StampApproved}" Header="_Approved" />
                <MenuItem x:Name="ReviewedItem" views:ControlHelp.Text="{x:Static views:Descriptions.StampReviewed}" Header="_Reviewed" />
                <MenuItem x:Name="DraftItem" views:ControlHelp.Text="{x:Static views:Descriptions.StampDraft}" Header="_Draft" />
                <MenuItem x:Name="ConfidentialItem" views:ControlHelp.Text="{x:Static views:Descriptions.StampConfidential}" Header="_Confidential" />
                <MenuItem x:Name="FinalItem" views:ControlHelp.Text="{x:Static views:Descriptions.StampFinal}" Header="_Final" />
                <MenuItem x:Name="NotApprovedItem" views:ControlHelp.Text="{x:Static views:Descriptions.StampNotApproved}" Header="_Not Approved" />
                <Separator />
                <MenuItem x:Name="CustomStampItem" views:ControlHelp.Text="{x:Static views:Descriptions.StampCustom}" Header="_Your Own Words…" />
                <MenuItem x:Name="PictureStampItem" views:ControlHelp.Text="{x:Static views:Descriptions.StampPicture}" Header="_Picture…" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Rectangle Classes="separator" />
          <!-- One colour button, always showing the colour's name, so colour is never the only cue. -->
          <Button AutomationProperties.Name="Annotation colour" x:Name="ColourButton" views:ControlHelp.Text="{x:Static views:Descriptions.AnnotationColour}" Classes="tool">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border x:Name="ColourSwatch" Classes="swatch" />
              <TextBlock x:Name="ColourText" VerticalAlignment="Center" />
            </StackPanel>
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem x:Name="YellowItem" views:ControlHelp.Text="{x:Static views:Descriptions.Yellow}" Header="_Yellow">
                  <MenuItem.Icon>
                    <Border Classes="swatch" Background="#F0DC96" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="GreenItem" views:ControlHelp.Text="{x:Static views:Descriptions.Green}" Header="_Green">
                  <MenuItem.Icon>
                    <Border Classes="swatch" Background="#BCDCB0" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="BlueItem" views:ControlHelp.Text="{x:Static views:Descriptions.Blue}" Header="_Blue">
                  <MenuItem.Icon>
                    <Border Classes="swatch" Background="#B4CCDC" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="RedItem" views:ControlHelp.Text="{x:Static views:Descriptions.Red}" Header="_Red">
                  <MenuItem.Icon>
                    <Border Classes="swatch" Background="#E8BCB4" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="PurpleItem" views:ControlHelp.Text="{x:Static views:Descriptions.Purple}" Header="_Purple">
                  <MenuItem.Icon>
                    <Border Classes="swatch" Background="#D4C8E4" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="OrangeItem" views:ControlHelp.Text="{x:Static views:Descriptions.Orange}" Header="_Orange">
                  <MenuItem.Icon>
                    <Border Classes="swatch" Background="#F0CCA8" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="GreyItem" views:ControlHelp.Text="{x:Static views:Descriptions.Grey}" Header="Gr_ey">
                  <MenuItem.Icon>
                    <Border Classes="swatch" Background="#D0D0CC" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="DarkBlueItem" views:ControlHelp.Text="{x:Static views:Descriptions.DarkBlue}" Header="_Dark Blue">
                  <MenuItem.Icon>
                    <Border Classes="swatch" Background="#23324A" />
                  </MenuItem.Icon>
                </MenuItem>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button AutomationProperties.Name="Line width" x:Name="LineWidthButton" views:ControlHelp.Text="{x:Static views:Descriptions.LineWidth}" Classes="tool">
            <StackPanel Orientation="Horizontal">
              <Path Classes="icon edit" Data="{StaticResource IconLineWidth}" />
              <TextBlock x:Name="LineWidthText" Classes="label" Text="Line" />
            </StackPanel>
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem x:Name="ThinLineItem" views:ControlHelp.Text="{x:Static views:Descriptions.LineThin}" Header="_Thin" />
                <MenuItem x:Name="MediumLineItem" views:ControlHelp.Text="{x:Static views:Descriptions.LineMedium}" Header="_Medium" />
                <MenuItem x:Name="ThickLineItem" views:ControlHelp.Text="{x:Static views:Descriptions.LineThick}" Header="T_hick" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </WrapPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button AutomationProperties.Name="Undo" x:Name="UndoButton" views:ControlHelp.Text="{x:Static views:Descriptions.Undo}" Classes="tool">
            <StackPanel Orientation="Horizontal">
              <Path Classes="icon edit" Data="{StaticResource IconUndo}" />
              <TextBlock Classes="label" Text="Undo" />
            </StackPanel>
          </Button>
          <Button AutomationProperties.Name="Redo" x:Name="RedoButton" views:ControlHelp.Text="{x:Static views:Descriptions.Redo}" Classes="tool">
            <StackPanel Orientation="Horizontal">
              <Path Classes="icon edit" Data="{StaticResource IconRedo}" />
              <TextBlock Classes="label" Text="Redo" />
            </StackPanel>
          </Button>
          <Button AutomationProperties.Name="Done" x:Name="AnnotateDoneButton" views:ControlHelp.Text="{x:Static views:Descriptions.AnnotateDone}" Classes="tool">
            <StackPanel Orientation="Horizontal">
              <Path Classes="icon nav" Data="{StaticResource IconDone}" />
              <TextBlock Classes="label" Text="Done" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!--
      Fill & Sign tools: form fields are filled by clicking them. A signature or initials is typed, drawn or taken from a
      picture, previewed on the page, then placed. While placing, the same row shows the placing steps and buttons.
    -->
    <Border x:Name="FillSignBar" DockPanel.Dock="Top" Classes="toolbar subbar" AutomationProperties.Name="Fill and Sign tools" AutomationProperties.ControlTypeOverride="ToolBar">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <WrapPanel>
            <ToggleButton AutomationProperties.Name="Add Text" x:Name="AddTextTool" views:ControlHelp.Text="{x:Static views:Descriptions.AddText}" Classes="tool">
              <StackPanel Orientation="Horizontal">
                <Path Classes="icon add" Data="{StaticResource IconText}" />
                <TextBlock Classes="label" Text="Add Text" />
              </StackPanel>
            </ToggleButton>
            <Button AutomationProperties.Name="Signature…" x:Name="SignatureButton" views:ControlHelp.Text="{x:Static views:Descriptions.SignatureMark}" Classes="tool">
              <StackPanel Orientation="Horizontal">
                <Path Classes="icon edit" Data="{StaticResource IconSignature}" />
                <TextBlock Classes="label" Text="Signature…" />
              </StackPanel>
            </Button>
            <Button AutomationProperties.Name="Initials…" x:Name="InitialsButton" views:ControlHelp.Text="{x:Static views:Descriptions.InitialsMark}" Classes="tool">
              <StackPanel Orientation="Horizontal">
                <Path Classes="icon edit" Data="{StaticResource IconText}" />
                <TextBlock Classes="label" Text="Initials…" />
              </StackPanel>
            </Button>
            <Button AutomationProperties.Name="Sign with Certificate…" x:Name="CertificateSignButton" views:ControlHelp.Text="{x:Static views:Descriptions.CertificateSign}" Classes="tool">
              <StackPanel Orientation="Horizontal">
                <Path Classes="icon edit" Data="{StaticResource IconCertificate}" />
                <TextBlock Classes="label" Text="Sign with Certificate…" />
              </StackPanel>
            </Button>
            <StackPanel x:Name="PlacingTools" Orientation="Horizontal">
              <Button AutomationProperties.Name="Place" x:Name="PlaceMarkButton" views:ControlHelp.Text="{x:Static views:Descriptions.PlaceMark}" Classes="tool">
                <StackPanel Orientation="Horizontal">
                  <Path Classes="icon add" Data="{StaticResource IconDone}" />
                  <TextBlock Classes="label" Text="Place" />
                </StackPanel>
              </Button>
              <Button AutomationProperties.Name="Bigger" x:Name="BiggerMarkButton" views:ControlHelp.Text="{x:Static views:Descriptions.BiggerMark}" Classes="tool">
                <StackPanel Orientation="Horizontal">
                  <Path Classes="icon edit" Data="{StaticResource IconZoomIn}" />
                  <TextBlock Classes="label" Text="Bigger" />
                </StackPanel>
              </Button>
              <Button AutomationProperties.Name="Smaller" x:Name="SmallerMarkButton" views:ControlHelp.Text="{x:Static views:Descriptions.SmallerMark}" Classes="tool">
                <StackPanel Orientation="Horizontal">
                  <Path Classes="icon edit" Data="{StaticResource IconZoomOut}" />
                  <TextBlock Classes="label" Text="Smaller" />
                </StackPanel>
              </Button>
              <Button AutomationProperties.Name="Cancel Placing" x:Name="CancelPlacementButton" views:ControlHelp.Text="{x:Static views:Descriptions.CancelPlacement}" Classes="tool">
                <StackPanel Orientation="Horizontal">
                  <Path Classes="icon remove" Data="{StaticResource IconClose}" />
                  <TextBlock Classes="label" Text="Cancel" />
                </StackPanel>
              </Button>
            </StackPanel>
            <StackPanel x:Name="PlacedTools" Orientation="Horizontal">
              <Button AutomationProperties.Name="Adjust Mark" x:Name="AdjustMarkButton" views:ControlHelp.Text="{x:Static views:Descriptions.AdjustMark}" Classes="tool">
                <StackPanel Orientation="Horizontal">
                  <Path Classes="icon edit" Data="{StaticResource IconCursor}" />
                  <TextBlock Classes="label" Text="Adjust" />
                </StackPanel>
              </Button>
              <Button AutomationProperties.Name="Remove Mark" x:Name="RemoveMarkButton" views:ControlHelp.Text="{x:Static views:Descriptions.RemoveMark}" Classes="tool">
                <StackPanel Orientation="Horizontal">
                  <Path Classes="icon remove" Data="{StaticResource IconClose}" />
                  <TextBlock Classes="label" Text="Remove" />
                </StackPanel>
              </Button>
            </StackPanel>
          </WrapPanel>
          <TextBlock x:Name="FillSignHint" Classes="secondary" TextWrapping="Wrap" Margin="8,0,8,4" />
        </StackPanel>
        <Button Grid.Column="1" AutomationProperties.Name="Done" x:Name="FillSignDoneButton" views:ControlHelp.Text="{x:Static views:Descriptions.FillSignDone}" Classes="tool">
          <StackPanel Orientation="Horizontal">
            <Path Classes="icon nav" Data="{StaticResource IconDone}" />
            <TextBlock Classes="label" Text="Done" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!--
      Text format: shown with the Annotate and Fill & Sign tools, so it stays in one place. It shows the format of the
      text being typed or picked, and changing it changes that text straight away.
    -->
    <Border x:Name="TextFormatBar" DockPanel.Dock="Top" Classes="toolbar subbar" AutomationProperties.Name="Text format" AutomationProperties.ControlTypeOverride="ToolBar">
      <WrapPanel Orientation="Horizontal">
        <TextBlock x:Name="FontFamilyLabel" Classes="secondary" Text="Font" VerticalAlignment="Center" Margin="6,0,4,0" />
        <ComboBox x:Name="FontFamilyBox" views:ControlHelp.Text="{x:Static views:Descriptions.FontFamily}" Width="190" VerticalAlignment="Center" MaxDropDownHeight="420" />
        <TextBlock x:Name="FontSizeLabel" Classes="secondary" Text="Size" VerticalAlignment="Center" Margin="10,0,4,0" />
        <ComboBox x:Name="FontSizeBox" views:ControlHelp.Text="{x:Static views:Descriptions.FontSize}" IsEditable="True" Width="76" VerticalAlignment="Center" />
        <Button AutomationProperties.Name="Smaller text" x:Name="SmallerTextButton" views:ControlHelp.Text="{x:Static views:Descriptions.ShrinkPageText}" Classes="tool">
          <StackPanel Orientation="Horizontal">
            <Path Classes="icon edit" Data="{StaticResource IconZoomOut}" />
            <TextBlock Classes="label" Text="Smaller" />
          </StackPanel>
        </Button>
        <Button AutomationProperties.Name="Larger text" x:Name="LargerTextButton" views:ControlHelp.Text="{x:Static views:Descriptions.GrowPageText}" Classes="tool">
          <StackPanel Orientation="Horizontal">
            <Path Classes="icon edit" Data="{StaticResource IconZoomIn}" />
            <TextBlock Classes="label" Text="Larger" />
          </StackPanel>
        </Button>
        <Rectangle Classes="separator" />
        <ToggleButton AutomationProperties.Name="Bold" x:Name="BoldToggle" views:ControlHelp.Text="{x:Static views:Descriptions.BoldText}" Classes="tool">
          <TextBlock Classes="label" Text="Bold" FontWeight="Bold" />
        </ToggleButton>
        <ToggleButton AutomationProperties.Name="Italic" x:Name="ItalicToggle" views:ControlHelp.Text="{x:Static views:Descriptions.ItalicText}" Classes="tool">
          <TextBlock Classes="label" Text="Italic" FontStyle="Italic" />
        </ToggleButton>
        <ToggleButton AutomationProperties.Name="Underline text" x:Name="UnderlineToggle" views:ControlHelp.Text="{x:Static views:Descriptions.UnderlineText}" Classes="tool">
          <TextBlock Classes="label" Text="Underline" TextDecorations="Underline" />
        </ToggleButton>
        <Rectangle Classes="separator" />
        <ToggleButton AutomationProperties.Name="Align left" x:Name="AlignLeftToggle" views:ControlHelp.Text="{x:Static views:Descriptions.AlignLeft}" Classes="tool">
          <TextBlock Classes="label" Text="Left" />
        </ToggleButton>
        <ToggleButton AutomationProperties.Name="Centre" x:Name="AlignCenterToggle" views:ControlHelp.Text="{x:Static views:Descriptions.AlignCenter}" Classes="tool">
          <TextBlock Classes="label" Text="Centre" />
        </ToggleButton>
        <ToggleButton AutomationProperties.Name="Align right" x:Name="AlignRightToggle" views:ControlHelp.Text="{x:Static views:Descriptions.AlignRight}" Classes="tool">
          <TextBlock Classes="label" Text="Right" />
        </ToggleButton>
        <Rectangle Classes="separator" />
        <Button AutomationProperties.Name="Text colour" x:Name="TextColourButton" views:ControlHelp.Text="{x:Static views:Descriptions.TextColour}" Classes="tool">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Border x:Name="TextColourSwatch" Classes="swatch" />
            <TextBlock x:Name="TextColourText" VerticalAlignment="Center" />
          </StackPanel>
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem x:Name="BlackTextItem" views:ControlHelp.Text="{x:Static views:Descriptions.TextColour}" Header="_Black" />
              <MenuItem x:Name="DarkBlueTextItem" views:ControlHelp.Text="{x:Static views:Descriptions.TextColour}" Header="_Dark Blue" />
              <MenuItem x:Name="BlueTextItem" views:ControlHelp.Text="{x:Static views:Descriptions.TextColour}" Header="B_lue" />
              <MenuItem x:Name="RedTextItem" views:ControlHelp.Text="{x:Static views:Descriptions.TextColour}" Header="_Red" />
              <MenuItem x:Name="GreenTextItem" views:ControlHelp.Text="{x:Static views:Descriptions.TextColour}" Header="_Green" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        <Button AutomationProperties.Name="Spacing" x:Name="SpacingButton" views:ControlHelp.Text="{x:Static views:Descriptions.TextSpacing}" Classes="tool">
          <StackPanel Orientation="Horizontal">
            <Path Classes="icon edit" Data="{StaticResource IconLineWidth}" />
            <TextBlock x:Name="SpacingText" Classes="label" Text="Spacing" />
          </StackPanel>
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="Line spacing" IsEnabled="False" views:ControlHelp.Text="{x:Static views:Descriptions.TextSpacing}" />
              <MenuItem x:Name="SingleSpacingItem" views:ControlHelp.Text="{x:Static views:Descriptions.TextSpacing}" Header="_Single" />
              <MenuItem x:Name="NormalSpacingItem" views:ControlHelp.Text="{x:Static views:Descriptions.TextSpacing}" Header="_Normal" />
              <MenuItem x:Name="OneHalfSpacingItem" views:ControlHelp.Text="{x:Static views:Descriptions.TextSpacing}" Header="One and a _Half" />
              <MenuItem x:Name="DoubleSpacingItem" views:ControlHelp.Text="{x:Static views:Descriptions.TextSpacing}" Header="_Double" />
              <Separator />
              <MenuItem Header="Letter spacing" IsEnabled="False" views:ControlHelp.Text="{x:Static views:Descriptions.TextSpacing}" />
              <MenuItem x:Name="TightLettersItem" views:ControlHelp.Text="{x:Static views:Descriptions.TextSpacing}" Header="_Tight" />
              <MenuItem x:Name="NormalLettersItem" views:ControlHelp.Text="{x:Static views:Descriptions.TextSpacing}" Header="N_ormal Letters" />
              <MenuItem x:Name="WideLettersItem" views:ControlHelp.Text="{x:Static views:Descriptions.TextSpacing}" Header="_Wide" />
              <MenuItem x:Name="WiderLettersItem" views:ControlHelp.Text="{x:Static views:Descriptions.TextSpacing}" Header="Wi_der" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        <Button AutomationProperties.Name="Text Properties…" x:Name="TextPropertiesButton" views:ControlHelp.Text="{x:Static views:Descriptions.TextProperties}" Classes="tool">
          <StackPanel Orientation="Horizontal">
            <Path Classes="icon edit" Data="{StaticResource IconTextSize}" />
            <TextBlock Classes="label" Text="Properties…" />
          </StackPanel>
        </Button>
        <Button AutomationProperties.Name="Finish Text" x:Name="FinishTextButton" views:ControlHelp.Text="{x:Static views:Descriptions.FinishText}" Classes="tool">
          <StackPanel Orientation="Horizontal">
            <Path Classes="icon nav" Data="{StaticResource IconDone}" />
            <TextBlock Classes="label" Text="Finish Text" />
          </StackPanel>
        </Button>
      </WrapPanel>
    </Border>

    <!-- Shown for digitally signed documents. Signatures are checked only when asked, as checking may go online. -->
    <Border x:Name="SignedBar" DockPanel.Dock="Top" Classes="toolbar">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="6,0">
          <Path Classes="icon nav" Data="{StaticResource IconSignature}" />
          <TextBlock x:Name="SignedText" VerticalAlignment="Center" />
        </StackPanel>
        <Button Grid.Column="1" x:Name="CheckSignaturesButton" views:ControlHelp.Text="{x:Static views:Descriptions.CheckSignatures}" Content="Check Signatures" />
      </Grid>
    </Border>

    <!-- Steady progress while scanned pages are recognised; nothing moves except the bar, one step per page. -->
    <Border x:Name="RecognitionBar" DockPanel.Dock="Top" Classes="toolbar">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock x:Name="RecognitionText" AutomationProperties.LiveSetting="Polite" VerticalAlignment="Center" Margin="6,0" />
        <ProgressBar Grid.Column="1" x:Name="RecognitionProgress" AutomationProperties.Name="Text recognition progress" Width="160" Minimum="0" Maximum="1" VerticalAlignment="Center" Margin="8,0" />
        <Button Grid.Column="2" x:Name="StopRecognitionButton" views:ControlHelp.Text="{x:Static views:Descriptions.StopRecognition}" Content="Stop" />
      </Grid>
    </Border>

    <!-- Asks which language a document is in, when it matters; one button downloads it if needed and recognises. -->
    <Border x:Name="LanguageBar" DockPanel.Dock="Top" Classes="toolbar">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
        <TextBlock x:Name="LanguageBarText" VerticalAlignment="Center" Margin="6,0" TextWrapping="Wrap" />
        <ComboBox Grid.Column="1" x:Name="LanguageBox" Width="200" VerticalAlignment="Center" Margin="8,0"
                  AutomationProperties.Name="Document language"
                  views:ControlHelp.Text="{x:Static views:Descriptions.DocumentLanguage}" />
        <Button Grid.Column="2" x:Name="LanguageActionButton" MinWidth="220"
                views:ControlHelp.Text="{x:Static views:Descriptions.RecognizeInLanguage}" />
        <ProgressBar Grid.Column="3" x:Name="LanguageDownloadProgress" Width="140" Minimum="0" Maximum="1" VerticalAlignment="Center" Margin="8,0"
                     AutomationProperties.Name="Language download progress" />
        <Button Grid.Column="4" x:Name="CloseLanguageBarButton" Content="Not Now"
                AutomationProperties.Name="Not now"
                views:ControlHelp.Text="{x:Static views:Descriptions.CloseLanguageBar}" />
      </Grid>
    </Border>

    <!-- Read Aloud: steady controls; the sentence being read is softly marked on the page and the view follows it. -->
    <Border x:Name="ReadAloudBar" DockPanel.Dock="Top" Classes="toolbar" AutomationProperties.Name="Read Aloud" AutomationProperties.ControlTypeOverride="ToolBar">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <Button AutomationProperties.Name="Previous sentence" x:Name="PreviousSentenceButton" views:ControlHelp.Text="{x:Static views:Descriptions.PreviousSentence}" Classes="tool">
            <Path Classes="icon nav" Data="{StaticResource IconPreviousSentence}" />
          </Button>
          <Button AutomationProperties.Name="Play" x:Name="PlayButton" views:ControlHelp.Text="{x:Static views:Descriptions.Play}" Classes="tool">
            <StackPanel Orientation="Horizontal">
              <Path Classes="icon nav" Data="{StaticResource IconPlay}" />
              <TextBlock Classes="label" Text="Play" />
            </StackPanel>
          </Button>
          <Button AutomationProperties.Name="Pause" x:Name="PauseButton" views:ControlHelp.Text="{x:Static views:Descriptions.Pause}" Classes="tool">
            <StackPanel Orientation="Horizontal">
              <Path Classes="icon nav" Data="{StaticResource IconPause}" />
              <TextBlock Classes="label" Text="Pause" />
            </StackPanel>
          </Button>
          <Button AutomationProperties.Name="Next sentence" x:Name="NextSentenceButton" views:ControlHelp.Text="{x:Static views:Descriptions.NextSentence}" Classes="tool">
            <Path Classes="icon nav" Data="{StaticResource IconNextSentence}" />
          </Button>
          <ComboBox x:Name="VoiceBox" views:ControlHelp.Text="{x:Static views:Descriptions.Voice}" AutomationProperties.Name="Voice" Width="250" VerticalAlignment="Center" Margin="8,0,2,0" />
          <ComboBox x:Name="SpeedBox" views:ControlHelp.Text="{x:Static views:Descriptions.Speed}" AutomationProperties.Name="Speed" Width="150" VerticalAlignment="Center" />
          <Button AutomationProperties.Name="Options" x:Name="ReadAloudOptionsButton" views:ControlHelp.Text="{x:Static views:Descriptions.ReadAloudOptions}" Classes="tool">
            <TextBlock Classes="label" Text="Options" />
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <StackPanel Spacing="8" Margin="4">
                  <CheckBox x:Name="WordMarkCheck" views:ControlHelp.Text="{x:Static views:Descriptions.WordMark}" Content="Mark the word being read" />
                  <CheckBox x:Name="FocusBandCheck" views:ControlHelp.Text="{x:Static views:Descriptions.FocusBand}" Content="Dim text away from what is read" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button x:Name="DownloadVoiceButton" views:ControlHelp.Text="{x:Static views:Descriptions.DownloadVoice}" Content="Download Voice" VerticalAlignment="Center" Margin="8,0,0,0" />
          <ProgressBar x:Name="VoiceDownloadProgress" AutomationProperties.Name="Voice download progress" Width="140" Minimum="0" Maximum="1" VerticalAlignment="Center" Margin="8,0" />
        </StackPanel>
        <TextBlock Grid.Column="1" x:Name="ReadAloudText" AutomationProperties.LiveSetting="Polite" VerticalAlignment="Center" Margin="8,0" TextWrapping="Wrap" />
        <Button Grid.Column="2" x:Name="CloseReadAloudButton" views:ControlHelp.Text="{x:Static views:Descriptions.CloseReadAloud}" Content="Close" />
      </Grid>
    </Border>

    <!-- Says once, calmly, what this document holds that cannot be shown or run, instead of silently showing fallback pages. -->
    <Border x:Name="ContentWarningBar" DockPanel.Dock="Top" Classes="toolbar">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="ContentWarningText" AutomationProperties.LiveSetting="Polite" VerticalAlignment="Center" Margin="6,0" TextWrapping="Wrap" />
        <Button Grid.Column="1" x:Name="DismissContentWarningButton" views:ControlHelp.Text="{x:Static views:Descriptions.DismissContentWarning}" Content="Dismiss" />
      </Grid>
    </Border>

    <!-- Says once, calmly, that the file was damaged and repaired to show it; the list of repairs is shown on request. -->
    <Border x:Name="RepairNoticeBar" DockPanel.Dock="Top" Classes="toolbar">
      <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
        <TextBlock x:Name="RepairNoticeText" AutomationProperties.LiveSetting="Polite" VerticalAlignment="Center" Margin="6,0" TextWrapping="Wrap" />
        <Button Grid.Column="1" x:Name="ToggleRepairDetailsButton" views:ControlHelp.Text="{x:Static views:Descriptions.ToggleRepairDetails}" Content="Details" />
        <Button Grid.Column="2" x:Name="DismissRepairNoticeButton" views:ControlHelp.Text="{x:Static views:Descriptions.DismissRepairNotice}" Content="Dismiss" />
        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" x:Name="RepairDetailsText" VerticalAlignment="Center" Margin="6,4" TextWrapping="Wrap" />
      </Grid>
    </Border>

    <!-- A message that waits until dismissed, for example a failed save. -->
    <Border x:Name="NoticeBar" DockPanel.Dock="Top" Classes="toolbar">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="NoticeText" AutomationProperties.LiveSetting="Assertive" VerticalAlignment="Center" Margin="6,0" TextWrapping="Wrap" />
        <Button Grid.Column="1" x:Name="DismissNoticeButton" views:ControlHelp.Text="{x:Static views:Descriptions.DismissMessage}" Content="Dismiss" />
      </Grid>
    </Border>

    <!-- Shown when the user chose to be asked before reloading a changed file, or has unsaved edits. -->
    <Border x:Name="ReloadBar" DockPanel.Dock="Top" Classes="toolbar">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="ReloadText" AutomationProperties.LiveSetting="Polite" VerticalAlignment="Center" Margin="6,0" Text="This PDF changed on disk. Reload it?" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
          <Button x:Name="ReloadButton" views:ControlHelp.Text="{x:Static views:Descriptions.ReloadChanged}" Content="Reload" />
          <Button x:Name="DismissReloadButton" views:ControlHelp.Text="{x:Static views:Descriptions.DismissReload}" Content="Dismiss" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Find bar. -->
    <Border x:Name="FindBar" DockPanel.Dock="Top" Classes="toolbar" AutomationProperties.Name="Find" AutomationProperties.LandmarkType="Search">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <TextBox x:Name="SearchBox" views:ControlHelp.Text="{x:Static views:Descriptions.SearchBox}" AutomationProperties.Name="Find in document" Width="280" MinHeight="28" Padding="8,3" VerticalAlignment="Center" PlaceholderText="Find in document" />
        <ToggleButton AutomationProperties.Name="Match case" x:Name="MatchCaseToggle" views:ControlHelp.Text="{x:Static views:Descriptions.MatchCase}" Classes="tool">
          <Path Classes="icon" Data="{StaticResource IconCase}" />
        </ToggleButton>
        <ToggleButton AutomationProperties.Name="Whole words" x:Name="WholeWordToggle" views:ControlHelp.Text="{x:Static views:Descriptions.WholeWords}" Classes="tool">
          <Path Classes="icon" Data="{StaticResource IconWholeWord}" />
        </ToggleButton>
        <Button AutomationProperties.Name="Previous result" x:Name="PreviousResultButton" views:ControlHelp.Text="{x:Static views:Descriptions.PreviousResult}" Classes="tool">
          <Path Classes="icon nav" Data="{StaticResource IconPageUp}" />
        </Button>
        <Button AutomationProperties.Name="Next result" x:Name="NextResultButton" views:ControlHelp.Text="{x:Static views:Descriptions.NextResult}" Classes="tool">
          <Path Classes="icon nav" Data="{StaticResource IconPageDown}" />
        </Button>
        <TextBlock x:Name="SearchStatusText" AutomationProperties.LiveSetting="Polite" Classes="secondary" VerticalAlignment="Center" Margin="8,0" />
        <Button AutomationProperties.Name="Close find" x:Name="CloseFindButton" views:ControlHelp.Text="{x:Static views:Descriptions.CloseFind}" Classes="tool">
          <Path Classes="icon remove" Data="{StaticResource IconClose}" />
        </Button>
      </StackPanel>
    </Border>

    </StackPanel>

    <!-- Auto-scroll: shown only while the pages scroll by themselves, even in read mode, so stopping is always one click away. -->
    <Border x:Name="AutoScrollBar" DockPanel.Dock="Top" Classes="toolbar subbar" AutomationProperties.Name="Auto-scroll" AutomationProperties.ControlTypeOverride="ToolBar">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button AutomationProperties.Name="Slower" x:Name="AutoScrollSlowerButton" views:ControlHelp.Text="{x:Static views:Descriptions.AutoScrollSlower}" Classes="tool">
            <StackPanel Orientation="Horizontal">
              <Path Classes="icon nav" Data="{StaticResource IconZoomOut}" />
              <TextBlock Classes="label" Text="Slower" />
            </StackPanel>
          </Button>
          <Button AutomationProperties.Name="Faster" x:Name="AutoScrollFasterButton" views:ControlHelp.Text="{x:Static views:Descriptions.AutoScrollFaster}" Classes="tool">
            <StackPanel Orientation="Horizontal">
              <Path Classes="icon nav" Data="{StaticResource IconZoomIn}" />
              <TextBlock Classes="label" Text="Faster" />
            </StackPanel>
          </Button>
          <Button AutomationProperties.Name="Stop auto-scroll" x:Name="AutoScrollStopButton" views:ControlHelp.Text="{x:Static views:Descriptions.AutoScrollStop}" Classes="tool">
            <StackPanel Orientation="Horizontal">
              <Path Classes="icon nav" Data="{StaticResource IconPause}" />
              <TextBlock Classes="label" Text="Stop" />
            </StackPanel>
          </Button>
        </StackPanel>
        <TextBlock x:Name="AutoScrollText" AutomationProperties.LiveSetting="Polite" VerticalAlignment="Center" Margin="12,0" TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <Grid ColumnDefinitions="Auto,Auto,*">
      <!-- Sidebar. -->
      <Border x:Name="Sidebar" Grid.Column="0" Width="220" Classes="sidebar" AutomationProperties.Name="Sidebar" AutomationProperties.LandmarkType="Navigation">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="4">
            <ToggleButton AutomationProperties.Name="Thumbnails" x:Name="ThumbnailsToggle" views:ControlHelp.Text="{x:Static views:Descriptions.Thumbnails}" Classes="tool">
              <Path Classes="icon nav" Data="{StaticResource IconThumbnails}" />
            </ToggleButton>
            <ToggleButton AutomationProperties.Name="Outline" x:Name="OutlineToggle" views:ControlHelp.Text="{x:Static views:Descriptions.Outline}" Classes="tool">
              <Path Classes="icon nav" Data="{StaticResource IconOutline}" />
            </ToggleButton>
            <ToggleButton AutomationProperties.Name="Search results" x:Name="SearchResultsToggle" views:ControlHelp.Text="{x:Static views:Descriptions.SearchResults}" Classes="tool">
              <Path Classes="icon nav" Data="{StaticResource IconSearch}" />
            </ToggleButton>
            <ToggleButton AutomationProperties.Name="Annotations" x:Name="AnnotationsToggle" views:ControlHelp.Text="{x:Static views:Descriptions.Annotations}" Classes="tool">
              <Path Classes="icon nav" Data="{StaticResource IconAnnotations}" />
            </ToggleButton>
            <!-- Only shown when the document has embedded files. -->
            <ToggleButton AutomationProperties.Name="Attachments" x:Name="AttachmentsToggle" views:ControlHelp.Text="{x:Static views:Descriptions.Attachments}" Classes="tool">
              <Path Classes="icon nav" Data="{StaticResource IconAttachment}" />
            </ToggleButton>
            <!-- Only shown when the document has layers. -->
            <ToggleButton AutomationProperties.Name="Layers" x:Name="LayersToggle" views:ControlHelp.Text="{x:Static views:Descriptions.Layers}" Classes="tool">
              <Path Classes="icon nav" Data="{StaticResource IconLayers}" />
            </ToggleButton>
          </StackPanel>
          <Panel>
            <Grid x:Name="ThumbnailPanel" RowDefinitions="Auto,*">
              <views:PageManagementView x:Name="PageTools" />
              <controls:ThumbnailListBox Grid.Row="1" x:Name="ThumbnailList" AutomationProperties.Name="Page thumbnails" Classes="thumbnails" Background="Transparent" SelectionMode="Multiple" />
            </Grid>
            <Panel x:Name="OutlinePanel">
              <TreeView x:Name="OutlineTree" AutomationProperties.Name="Outline" Background="Transparent" />
              <TextBlock x:Name="NoOutlineText" Classes="secondary" Margin="12" TextWrapping="Wrap" Text="This document has no outline." />
            </Panel>
            <!-- Comment list: a text filter, then filters and sort order shown on request, then the list. -->
            <DockPanel x:Name="AnnotationsPanel">
              <StackPanel DockPanel.Dock="Top" Margin="8,4,8,4" Spacing="6">
                <TextBox AutomationProperties.Name="Filter comments" x:Name="AnnotationFilterBox" views:ControlHelp.Text="{x:Static views:Descriptions.AnnotationFilterText}" PlaceholderText="Filter comments" />
                <ToggleButton AutomationProperties.Name="Filter and sort" x:Name="AnnotationFiltersToggle" views:ControlHelp.Text="{x:Static views:Descriptions.AnnotationFilters}" HorizontalAlignment="Stretch">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Classes="icon nav" Data="{StaticResource IconFilter}" />
                    <TextBlock Text="Filter and Sort" VerticalAlignment="Center" />
                  </StackPanel>
                </ToggleButton>
                <StackPanel x:Name="AnnotationFiltersPanel" Spacing="4">
                  <TextBlock x:Name="AnnotationTypeLabel" Classes="secondary" Text="Type" />
                  <ComboBox AutomationProperties.Name="Type" x:Name="AnnotationTypeBox" views:ControlHelp.Text="{x:Static views:Descriptions.AnnotationTypeFilter}" HorizontalAlignment="Stretch" />
                  <TextBlock x:Name="AnnotationColourLabel" Classes="secondary" Text="Colour" />
                  <ComboBox AutomationProperties.Name="Colour" x:Name="AnnotationColourBox" views:ControlHelp.Text="{x:Static views:Descriptions.AnnotationColourFilter}" HorizontalAlignment="Stretch" />
                  <TextBlock x:Name="AnnotationAuthorLabel" Classes="secondary" Text="Author" />
                  <ComboBox AutomationProperties.Name="Author" x:Name="AnnotationAuthorBox" views:ControlHelp.Text="{x:Static views:Descriptions.AnnotationAuthorFilter}" HorizontalAlignment="Stretch" />
                  <TextBlock x:Name="AnnotationSortLabel" Classes="secondary" Text="Sort by" />
                  <ComboBox AutomationProperties.Name="Sort by" x:Name="AnnotationSortBox" views:ControlHelp.Text="{x:Static views:Descriptions.AnnotationSort}" HorizontalAlignment="Stretch" />
                  <Button AutomationProperties.Name="Show all comments" x:Name="ClearAnnotationFilterButton" views:ControlHelp.Text="{x:Static views:Descriptions.ClearAnnotationFilter}" HorizontalAlignment="Stretch" Content="Show All Comments" />
                </StackPanel>
              </StackPanel>
              <Panel>
                <ListBox x:Name="AnnotationList" AutomationProperties.Name="Annotations" Background="Transparent" />
                <TextBlock x:Name="NoAnnotationsText" Classes="secondary" Margin="12" TextWrapping="Wrap"
                           Text="No annotations yet. Choose Annotate, or right-click selected text." />
                <TextBlock x:Name="NoMatchesText" Classes="secondary" Margin="12" TextWrapping="Wrap"
                           Text="No comments match the filter. Choose Show All Comments to see them all." />
              </Panel>
            </DockPanel>
            <ListBox x:Name="SearchResultList" AutomationProperties.Name="Search results" Background="Transparent" />
            <DockPanel x:Name="LayersPanel">
              <TextBlock DockPanel.Dock="Top" Classes="secondary" Margin="12,4,12,8" TextWrapping="Wrap" Text="Tick a layer to show it. Only the view changes, not the file." />
              <ListBox x:Name="LayerList" AutomationProperties.Name="Layers" Background="Transparent" />
            </DockPanel>
            <Grid x:Name="AttachmentsPanel" RowDefinitions="*,Auto">
              <ListBox x:Name="AttachmentList" AutomationProperties.Name="Attachments" Background="Transparent" />
              <StackPanel Grid.Row="1" Margin="8" Spacing="6">
                <Button x:Name="OpenAttachmentButton" views:ControlHelp.Text="{x:Static views:Descriptions.OpenAttachment}" HorizontalAlignment="Stretch" Content="Open Attachment" />
                <Button x:Name="SaveAttachmentButton" views:ControlHelp.Text="{x:Static views:Descriptions.SaveAttachment}" HorizontalAlignment="Stretch" Content="Save Attachment…" />
              </StackPanel>
            </Grid>
          </Panel>
        </DockPanel>
      </Border>
      <GridSplitter x:Name="SidebarSplitter" views:ControlHelp.Text="{x:Static views:Descriptions.SidebarSplitter}" Grid.Column="1" Width="1" Background="{DynamicResource AppBorderBrush}" />

      <!-- Pages. -->
      <Panel x:Name="PageArea" Grid.Column="2" AutomationProperties.Name="Pages" AutomationProperties.LandmarkType="Main">
        <views:FocusView x:Name="FocusPane" IsVisible="False" />
        <ScrollViewer x:Name="Scroller" Background="{DynamicResource AppCanvasBackground}"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <Panel HorizontalAlignment="Left" VerticalAlignment="Top">
            <!-- Named "Page 5 of 40" by its automation peer; the new page is announced as the reader moves. -->
            <controls:PageCanvas x:Name="Canvas" AutomationProperties.HelpText="{x:Static views:Descriptions.Pages}" AutomationProperties.LiveSetting="Polite" HitBrush="{DynamicResource AppHitBrush}" CurrentHitOutline="{DynamicResource AppCurrentHitOutline}"
                                 SelectionBrush="{DynamicResource AppTextSelectionBrush}" SpokenBrush="{DynamicResource AppSpokenBrush}" DimBrush="{DynamicResource AppDimBrush}"
                                 LabelBackground="{DynamicResource AppWindowBackground}" LabelForeground="{DynamicResource AppForeground}" />
            <!-- The text field editor sits exactly over the field being filled in. -->
            <Canvas x:Name="FieldOverlay">
              <TextBox x:Name="FieldEditor" views:ControlHelp.Text="{x:Static views:Descriptions.FormField}" AutomationProperties.Name="Form field" Classes="field" IsVisible="False" />
              <!-- Text typed on the page sits where it will be written, in its own font, size and colour. -->
              <TextBox x:Name="PageTextEditor" views:ControlHelp.Text="{x:Static views:Descriptions.PageText}" AutomationProperties.Name="Text on page" Classes="pagetext" AcceptsReturn="True" IsVisible="False" />
              <!-- Marks misspelled words under the editor's text; the pointer passes through it to the editor. -->
              <controls:SpellingUnderlines x:Name="FieldSpelling" IsHitTestVisible="False" IsVisible="False" Stroke="{DynamicResource AppIconRemove}" />
              <!-- Underlines the typed text, which the editor cannot do itself; the pointer passes through it. -->
              <controls:PageTextUnderline x:Name="PageTextUnderline" IsHitTestVisible="False" RenderTransformOrigin="0%,0%" />
            </Canvas>
          </Panel>
        </ScrollViewer>

        <Border x:Name="ErrorPanel" Background="{DynamicResource AppCanvasBackground}">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="480">
            <Path Classes="icon" Width="48" Height="48" Stroke="{DynamicResource AppSecondaryForeground}" Data="{StaticResource IconDocument}" />
            <TextBlock FontSize="16" HorizontalAlignment="Center" AutomationProperties.HeadingLevel="1" Text="This document could not be opened" />
            <TextBlock x:Name="ErrorText" AutomationProperties.LiveSetting="Assertive" Classes="secondary" TextWrapping="Wrap" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>

        <Border x:Name="PasswordPanel" Background="{DynamicResource AppCanvasBackground}">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Width="320">
            <TextBlock FontSize="16" HorizontalAlignment="Center" AutomationProperties.HeadingLevel="1" Text="This document is password protected" />
            <TextBox x:Name="PasswordBox" views:ControlHelp.Text="{x:Static views:Descriptions.DocumentPassword}" AutomationProperties.Name="Password" PasswordChar="●" PlaceholderText="Password" />
            <Button x:Name="UnlockButton" views:ControlHelp.Text="{x:Static views:Descriptions.Unlock}" HorizontalAlignment="Right" Content="Unlock" />
          </StackPanel>
        </Border>
      </Panel>
    </Grid>
  </DockPanel>
</UserControl>
