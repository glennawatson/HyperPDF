<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:PdfViewerLite.App.Views"
             x:Class="PdfViewerLite.App.Views.RecentDocumentView">
  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Background="Transparent">
    <Path Classes="icon" Data="{StaticResource IconDocument}" VerticalAlignment="Center" />
    <StackPanel Grid.Column="1">
      <TextBlock x:Name="NameText" />
      <TextBlock x:Name="FolderText" Classes="secondary" FontSize="11" TextTrimming="CharacterEllipsis" />
    </StackPanel>
    <Button x:Name="RemoveButton" Grid.Column="2" VerticalAlignment="Center" Content="Remove" AutomationProperties.Name="Remove from recent documents" views:ControlHelp.Text="Remove this PDF from recent files without deleting it. On Linux, this also updates the desktop's shared recent list." />
  </Grid>
</UserControl>
