<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:PdfViewerLite.App.Views"
        x:Class="PdfViewerLite.App.Views.MainWindow"
        Title="Hyper PDF Viewer" Width="1200" Height="850" MinWidth="480" MinHeight="320"
        Background="{DynamicResource AppWindowBackground}"
        DragDrop.AllowDrop="True">
  <!-- Layout only: bindings, commands and shortcuts are set up in code with ReactiveUI.Binding (MainWindow.axaml.cs). -->
  <Grid RowDefinitions="Auto,*,Auto">
    <!-- Tab strip. -->
    <Border x:Name="TabBar" Classes="tabbar" AutomationProperties.Name="Tabs" AutomationProperties.LandmarkType="Navigation">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto">
        <ListBox x:Name="TabStrip" AutomationProperties.Name="Open documents" Classes="tabstrip"
                 ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <!-- Virtualised so a thousand tabs cost no more than the ones on screen. -->
              <VirtualizingStackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
        </ListBox>
        <Button AutomationProperties.Name="Find an open tab" x:Name="TabFinderButton" views:ControlHelp.Text="{x:Static views:Descriptions.TabFinder}" Grid.Column="1" Classes="tool">
          <StackPanel Orientation="Horizontal">
            <Path Classes="icon nav" Data="{StaticResource IconSearch}" />
            <TextBlock x:Name="TabCountText" Classes="label" />
          </StackPanel>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <DockPanel Width="380" Height="420">
                <TextBox x:Name="TabFinderBox" views:ControlHelp.Text="{x:Static views:Descriptions.TabFinderBox}" AutomationProperties.Name="Find an open tab" DockPanel.Dock="Top" Margin="0,0,0,6" PlaceholderText="Type part of a name, title or folder" />
                <ListBox x:Name="TabFinderList" AutomationProperties.Name="Matching tabs" Background="Transparent" />
              </DockPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <Button AutomationProperties.Name="Open" x:Name="OpenButton" views:ControlHelp.Text="{x:Static views:Descriptions.Open}" Grid.Column="2" Classes="tool">
          <StackPanel Orientation="Horizontal">
            <Path Classes="icon add" Data="{StaticResource IconAdd}" />
            <TextBlock Classes="label" Text="Open" />
          </StackPanel>
        </Button>
        <Button AutomationProperties.Name="Tabs and settings" x:Name="TabsMenuButton" views:ControlHelp.Text="{x:Static views:Descriptions.TabsMenu}" Grid.Column="3" Classes="tool" Content="Tabs &amp; settings ▾" Margin="0,0,4,0">
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem x:Name="OpenMenuItem" views:ControlHelp.Text="{x:Static views:Descriptions.Open}" Header="_Open…" InputGesture="Ctrl+O" />
              <MenuItem x:Name="RecentMenuItem" views:ControlHelp.Text="{x:Static views:Descriptions.OpenRecent}" Header="Open _Recent" />
              <MenuItem x:Name="ClearRecentMenuItem" views:ControlHelp.Text="Remove recent PDFs without deleting files. On Linux, this also clears the desktop's shared recent PDF list." Header="Clear Recent List" />
              <MenuItem x:Name="NewWindowMenuItem" views:ControlHelp.Text="{x:Static views:Descriptions.NewWindow}" Header="_New Window" InputGesture="Ctrl+N" />
              <MenuItem x:Name="ReopenMenuItem" views:ControlHelp.Text="{x:Static views:Descriptions.ReopenClosedTabs}" Header="_Reopen Closed Tabs" InputGesture="Ctrl+Shift+T" />
              <MenuItem x:Name="SearchFolderMenuItem" views:ControlHelp.Text="{x:Static views:Descriptions.SearchFolder}" Header="_Search in Folder…" InputGesture="Ctrl+Shift+F" />
              <Separator />
              <MenuItem x:Name="PageToneMenuItem" views:ControlHelp.Text="{x:Static views:Descriptions.ComfortPageColour}" Header="_Comfort Page Colour" InputGesture="Ctrl+I" ToggleType="CheckBox" />
              <MenuItem x:Name="PreferencesMenuItem" views:ControlHelp.Text="{x:Static views:Descriptions.Preferences}" Header="_Preferences…" InputGesture="Ctrl+OemComma" />
              <MenuItem x:Name="LicencesMenuItem" views:ControlHelp.Text="{x:Static views:Descriptions.Licences}" Header="About and _Licences…" />
              <Separator />
              <MenuItem x:Name="CloseAllMenuItem" views:ControlHelp.Text="{x:Static views:Descriptions.CloseAllTabs}" Header="Close _All Tabs" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </Grid>
    </Border>
    <Panel Grid.Row="1">
      <views:StartView x:Name="StartPage" />
      <!-- The second column holds a second view of the same document while the view is split. -->
      <Grid x:Name="DocumentArea" ColumnDefinitions="*,Auto,0">
        <ContentControl x:Name="DocumentHost" />
        <GridSplitter x:Name="SplitSplitter" Grid.Column="1" Width="6" views:ControlHelp.Text="{x:Static views:Descriptions.SplitSplitter}" AutomationProperties.Name="Split view divider" IsVisible="False" />
        <ContentControl x:Name="SplitHost" Grid.Column="2" AutomationProperties.Name="Second view" IsVisible="False" />
      </Grid>
    </Panel>
    <Border Grid.Row="2" x:Name="StatusBar" Classes="toolbar" BorderThickness="0,1,0,0" AutomationProperties.Name="Status" AutomationProperties.ControlTypeOverride="StatusBar">
      <Grid ColumnDefinitions="*,Auto">
        <!-- Downloads and their failures are announced without moving the focus. -->
        <TextBlock x:Name="StatusText" AutomationProperties.LiveSetting="Polite" Margin="6,2" VerticalAlignment="Center" />
        <Button Grid.Column="1" x:Name="DismissStatusButton" views:ControlHelp.Text="{x:Static views:Descriptions.DismissMessage}" Content="Dismiss" />
      </Grid>
    </Border>
  </Grid>
</Window>
