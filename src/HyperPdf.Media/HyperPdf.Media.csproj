<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Sound and video playback for HyperPDF through the FFmpeg libraries shipped with the app. The sound clock drives the picture, so the two stay together.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HyperPdf.Core\HyperPdf.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FFmpeg.AutoGen.Abstractions" />
    <PackageReference Include="FFmpeg.AutoGen.Bindings.DynamicallyLinked" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HyperPdf.Core.Tests" />
    <InternalsVisibleTo Include="HyperPdf.Media.Tests" />
    <InternalsVisibleTo Include="HyperPdf.Benchmarks" />
  </ItemGroup>
</Project>
