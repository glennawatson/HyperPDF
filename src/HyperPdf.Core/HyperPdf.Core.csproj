<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>UI-agnostic document model, render scheduling, tile caching and search for HyperPDF.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HyperCodecs" />
    <PackageReference Include="HyperCodecs.Platform.Linux" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="ReactiveUI.Primitives" />
    <PackageReference Include="ReactiveUI.Primitives.ObservableEvents" PrivateAssets="all" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HyperPdf.Core.Tests" />
    <InternalsVisibleTo Include="HyperPdf.Benchmarks" />
  </ItemGroup>

  <!-- The CMS digest and SHAKE256 checks HyperPdfLibrary uses, compiled here too because Core cannot reference it. -->
  <ItemGroup>
    <Compile Include="..\Shared\Cms\*.cs" LinkBase="Shared\Cms" />
  </ItemGroup>
</Project>
