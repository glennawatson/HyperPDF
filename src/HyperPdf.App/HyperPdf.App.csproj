<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>..\..\packaging\windows\HyperPdf.ico</ApplicationIcon>
    <Description>Hyper PDF Viewer: a fast, tabbed PDF viewer.</Description>
    <AssemblyName>hyperpdf</AssemblyName>
    <RootNamespace>HyperPdf.App</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <!-- Ships the English text recognition data (Directory.Build.targets). -->
    <UsesRecognitionData>true</UsesRecognitionData>
  </PropertyGroup>

  <PropertyGroup Label="Native AOT">
    <PublishAot>true</PublishAot>
    <!-- The .NET 11 RC2 SDK publishes Native AOT without the full Build, which skips the step that embeds Avalonia's XAML
         resources, so the app crashes at start with "No precompiled XAML found". Keep the full Build until Avalonia handles it:
         https://github.com/AvaloniaUI/Avalonia/issues/22465 -->
    <UseOptimizedPublish>false</UseOptimizedPublish>
    <EventSourceSupport>true</EventSourceSupport>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <OptimizationPreference>Speed</OptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HyperPdf.ViewModels\HyperPdf.ViewModels.csproj" />
    <ProjectReference Include="..\HyperPdf.Presentation\HyperPdf.Presentation.csproj" />
    <ProjectReference Include="..\HyperPdf.Rendering.Skia\HyperPdf.Rendering.Skia.csproj" />
    <ProjectReference Include="..\HyperPdf.Core\HyperPdf.Core.csproj" />
    <ProjectReference Include="..\HyperPdf.Engine\HyperPdf.Engine.csproj" />
    <ProjectReference Include="..\HyperPdf.Ocr\HyperPdf.Ocr.csproj" />
    <ProjectReference Include="..\HyperPdf.Http\HyperPdf.Http.csproj" />
    <ProjectReference Include="..\HyperPdf.Speech\HyperPdf.Speech.csproj" />
    <ProjectReference Include="..\HyperPdf.Platform.Linux\HyperPdf.Platform.Linux.csproj" />
    <ProjectReference Include="..\HyperPdf.Platform.MacOS\HyperPdf.Platform.MacOS.csproj" />
    <ProjectReference Include="..\HyperPdf.Platform.Windows\HyperPdf.Platform.Windows.csproj" />
    <ProjectReference Include="..\HyperPdf.Skia\HyperPdf.Skia.csproj" />
    <ProjectReference Include="..\HyperPdf.AtSpiReplacement\HyperPdf.AtSpiReplacement.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Win32" />
    <PackageReference Include="Avalonia.Native" />
    <PackageReference Include="Avalonia.X11" />
    <PackageReference Include="Avalonia.Wayland" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="ReactiveUI.Avalonia" />
    <PackageReference Include="ReactiveUI.Primitives.ObservableEvents" PrivateAssets="all" />
    <!-- ReactiveUI's own dependency on the generators excludes analyzers, so they only run when referenced here. -->
    <PackageReference Include="ReactiveUI.SourceGenerators" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HyperPdf.App.Tests" />
  </ItemGroup>

  <!-- The Licences window shows these notices: the packages in this project's assets, the font and CMap resource packs, and the data the app downloads. -->
  <PropertyGroup>
    <NoticesResourceName>HyperPdf.ThirdPartyNotices.md</NoticesResourceName>
    <NoticesComponents>unicode-ucd;open-font-pack;adobe-cmaps;opus-reference-decoder;pv-aac-decoder;tessdata-fast;kokoro;misaki;melotts;bert-base-uncased;g2p-en;cmudict;verapdf-profile-text</NoticesComponents>
  </PropertyGroup>
  <Import Project="..\licenses\ThirdPartyNotices.targets" />

  <!-- Debug symbols stay out of the packaged app, in a symbols folder beside it; Native AOT copies them in after Publish. -->
  <Target Name="MoveSymbolsOutOfPublish" AfterTargets="_CopyAotSymbols">
    <ItemGroup>
      <_PublishedSymbols Include="$(PublishDir)*.pdb;$(PublishDir)*.dbg" />
      <_PublishedSymbolBundleFiles Include="$(PublishDir)*.dSYM\**" />
      <_PublishedSymbolBundles Include="$([System.IO.Directory]::GetDirectories('$(PublishDir)', '*.dSYM'))" />
    </ItemGroup>
    <Move SourceFiles="@(_PublishedSymbols)" DestinationFolder="$(PublishDir)..\symbols" />
    <Copy SourceFiles="@(_PublishedSymbolBundleFiles)" DestinationFiles="@(_PublishedSymbolBundleFiles->'$(PublishDir)..\symbols\%(RecursiveDir)%(Filename)%(Extension)')" />
    <RemoveDir Directories="@(_PublishedSymbolBundles)" />
  </Target>

  <ItemGroup Label="View model namespaces">
    <Using Include="HyperPdf.Core.Layout" />
    <Using Include="HyperPdf.Presentation.Canvas" />
    <Using Include="HyperPdf.Presentation.Input" />
    <Using Include="HyperPdf.Rendering.Skia" />
    <Using Include="HyperPdf.ViewModels.Dialogs" />
    <Using Include="HyperPdf.ViewModels.Finding" />
    <Using Include="HyperPdf.ViewModels.FormFilling" />
    <Using Include="HyperPdf.ViewModels.Help" />
    <Using Include="HyperPdf.ViewModels.Markup" />
    <Using Include="HyperPdf.ViewModels.Output" />
    <Using Include="HyperPdf.ViewModels.Preferences" />
    <Using Include="HyperPdf.ViewModels.Reading" />
    <Using Include="HyperPdf.ViewModels.Rendering" />
    <Using Include="HyperPdf.ViewModels.Security" />
    <Using Include="HyperPdf.ViewModels.Services" />
    <Using Include="HyperPdf.ViewModels.Sidebar" />
    <Using Include="HyperPdf.ViewModels.Signing" />
    <Using Include="HyperPdf.ViewModels.Viewing" />
  </ItemGroup>
</Project>
