<UserControl xmlns="https://github.com/avaloniaui" xmlns:loc="using:CP.Localisation.Avalonia"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:help="using:HyperPdf.ViewModels.Help"
             xmlns:views="using:HyperPdf.App.Views"
             x:Class="HyperPdf.App.Views.StatusBarView">
  <!-- Layout only: every binding is made in code with ReactiveUI.Binding (StatusBarView.axaml.cs). -->
  <Border x:Name="StatusBar" Classes="toolbar" BorderThickness="0,1,0,0" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Status&quot;}" AutomationProperties.ControlTypeOverride="StatusBar">
    <Grid ColumnDefinitions="*,Auto">
      <!-- Downloads and their failures are announced without moving the focus. -->
      <TextBlock x:Name="StatusText" AutomationProperties.LiveSetting="Polite" Margin="6,2" VerticalAlignment="Center" />
      <Button Grid.Column="1" x:Name="DismissStatusButton" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Hide this message.&quot;}" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Dismiss&quot;}" />
    </Grid>
  </Border>
</UserControl>
