<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:HyperPdf.App.Views"
             x:Class="HyperPdf.App.Views.TextFormatBubbleView">
  <!-- Layout only: every binding is made in code with ReactiveUI.Binding (TextFormatBubbleView.axaml.cs). -->
  <!--
    The few formats people reach for while typing, next to the text so the eyes and the pointer stay where the work is.
    The buttons do not take the keyboard, so the caret stays in the text; the full Text format bar has everything else.
  -->
  <Border x:Name="Bubble" Classes="toolbar subbar" AutomationProperties.Name="Quick text format" AutomationProperties.ControlTypeOverride="ToolBar">
    <StackPanel Orientation="Horizontal" Spacing="2">
      <ToggleButton AutomationProperties.Name="Bold" x:Name="BoldToggle" Focusable="False" views:ControlHelp.Text="{x:Static views:Descriptions.BoldText}" Classes="tool">
        <TextBlock Classes="label" Text="Bold" FontWeight="Bold" />
      </ToggleButton>
      <ToggleButton AutomationProperties.Name="Italic" x:Name="ItalicToggle" Focusable="False" views:ControlHelp.Text="{x:Static views:Descriptions.ItalicText}" Classes="tool">
        <TextBlock Classes="label" Text="Italic" FontStyle="Italic" />
      </ToggleButton>
      <ToggleButton AutomationProperties.Name="Underline text" x:Name="UnderlineToggle" Focusable="False" views:ControlHelp.Text="{x:Static views:Descriptions.UnderlineText}" Classes="tool">
        <TextBlock Classes="label" Text="Underline" TextDecorations="Underline" />
      </ToggleButton>
      <Button AutomationProperties.Name="Smaller text" x:Name="SmallerTextButton" Focusable="False" views:ControlHelp.Text="{x:Static views:Descriptions.ShrinkPageText}" Classes="tool">
        <TextBlock Classes="label" Text="Smaller" />
      </Button>
      <Button AutomationProperties.Name="Larger text" x:Name="LargerTextButton" Focusable="False" views:ControlHelp.Text="{x:Static views:Descriptions.GrowPageText}" Classes="tool">
        <TextBlock Classes="label" Text="Larger" />
      </Button>
      <Button AutomationProperties.Name="Finish Text" x:Name="FinishTextButton" Focusable="False" views:ControlHelp.Text="{x:Static views:Descriptions.FinishText}" Classes="tool">
        <TextBlock Classes="label" Text="Done" />
      </Button>
    </StackPanel>
  </Border>
</UserControl>
