<UserControl xmlns="https://github.com/avaloniaui" xmlns:loc="using:CP.Localisation.Avalonia"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:help="using:HyperPdf.ViewModels.Help"
             xmlns:views="using:HyperPdf.App.Views"
             x:Class="HyperPdf.App.Views.AnnotateBarView">
  <!-- Layout only: every binding is made in code with ReactiveUI.Binding (AnnotateBarView.axaml.cs). -->
  <!-- Annotate tools: shown only while annotating. Each tool has its name beside its icon. -->
  <Border x:Name="AnnotateBar" Classes="toolbar subbar" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Annotate tools&quot;}" AutomationProperties.ControlTypeOverride="ToolBar">
    <Grid ColumnDefinitions="*,Auto">
      <WrapPanel Orientation="Horizontal">
        <ToggleButton AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Select&quot;}" x:Name="SelectTool" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Select text, or click an annotation to pick it. Drag a picked annotation or its corner squares to move or resize it; arrow keys nudge it.&quot;}" Classes="tool">
          <StackPanel Orientation="Horizontal">
            <Path Classes="icon nav" Data="{StaticResource IconCursor}" />
            <TextBlock TextWrapping="Wrap" Classes="label" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Select&quot;}" />
          </StackPanel>
        </ToggleButton>
        <ToggleButton AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Highlight&quot;}" x:Name="HighlightTool" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Select text to highlight it.&quot;}" Classes="tool">
          <StackPanel Orientation="Horizontal">
            <Path Classes="icon edit" Data="{StaticResource IconHighlight}" />
            <TextBlock TextWrapping="Wrap" Classes="label" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Highlight&quot;}" />
          </StackPanel>
        </ToggleButton>
        <ToggleButton AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Underline&quot;}" x:Name="UnderlineTool" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Select text to underline it.&quot;}" Classes="tool">
          <StackPanel Orientation="Horizontal">
            <Path Classes="icon edit" Data="{StaticResource IconUnderline}" />
            <TextBlock TextWrapping="Wrap" Classes="label" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Underline&quot;}" />
          </StackPanel>
        </ToggleButton>
        <ToggleButton AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Strike&quot;}" x:Name="StrikeOutTool" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Select text to draw a line through it.&quot;}" Classes="tool">
          <StackPanel Orientation="Horizontal">
            <Path Classes="icon edit" Data="{StaticResource IconStrike}" />
            <TextBlock TextWrapping="Wrap" Classes="label" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Strike&quot;}" />
          </StackPanel>
        </ToggleButton>
        <ToggleButton AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Draw&quot;}" x:Name="DrawTool" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Drag on the page to draw freehand.&quot;}" Classes="tool">
          <StackPanel Orientation="Horizontal">
            <Path Classes="icon edit" Data="{StaticResource IconDraw}" />
            <TextBlock TextWrapping="Wrap" Classes="label" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Draw&quot;}" />
          </StackPanel>
        </ToggleButton>
        <ToggleButton AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Highlighter&quot;}" x:Name="FreehandHighlightTool" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Drag on the page with a wide, see-through pen to highlight anything, including pictures and scanned text.&quot;}" Classes="tool">
          <StackPanel Orientation="Horizontal">
            <Path Classes="icon edit" Data="{StaticResource IconFreehandHighlight}" />
            <TextBlock TextWrapping="Wrap" Classes="label" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Highlighter&quot;}" />
          </StackPanel>
        </ToggleButton>
        <ToggleButton AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Caret&quot;}" x:Name="CaretTool" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Click on the page to mark a place where text should be inserted.&quot;}" Classes="tool">
          <StackPanel Orientation="Horizontal">
            <Path Classes="icon add" Data="{StaticResource IconCaret}" />
            <TextBlock TextWrapping="Wrap" Classes="label" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Caret&quot;}" />
          </StackPanel>
        </ToggleButton>
        <ToggleButton AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Note&quot;}" x:Name="NoteTool" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Click on the page to add a sticky note.&quot;}" Classes="tool">
          <StackPanel Orientation="Horizontal">
            <Path Classes="icon add" Data="{StaticResource IconNote}" />
            <TextBlock TextWrapping="Wrap" Classes="label" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Note&quot;}" />
          </StackPanel>
        </ToggleButton>
        <ToggleButton AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Text&quot;}" x:Name="TextTool" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Click on the page and type. Click or double-click text to change it.&quot;}" Classes="tool">
          <StackPanel Orientation="Horizontal">
            <Path Classes="icon add" Data="{StaticResource IconText}" />
            <TextBlock TextWrapping="Wrap" Classes="label" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Text&quot;}" />
          </StackPanel>
        </ToggleButton>
        <views:AnnotateShapeButtonView />
        <views:AnnotateStampButtonView />
        <Rectangle Classes="separator" />
        <views:AnnotationStyleView />
      </WrapPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Undo&quot;}" x:Name="UndoButton" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Undo your last annotation change: adding, deleting, moving, colour, style, note or reply. Shortcut: Ctrl+Z&quot;}" Classes="tool">
          <StackPanel Orientation="Horizontal">
            <Path Classes="icon edit" Data="{StaticResource IconUndo}" />
            <TextBlock TextWrapping="Wrap" Classes="label" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Undo&quot;}" />
          </StackPanel>
        </Button>
        <Button AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Redo&quot;}" x:Name="RedoButton" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Make the annotation change you undid again. Shortcut: Ctrl+Y or Ctrl+Shift+Z&quot;}" Classes="tool">
          <StackPanel Orientation="Horizontal">
            <Path Classes="icon edit" Data="{StaticResource IconRedo}" />
            <TextBlock TextWrapping="Wrap" Classes="label" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Redo&quot;}" />
          </StackPanel>
        </Button>
        <Button AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Done&quot;}" x:Name="AnnotateDoneButton" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Put the annotation tools away.&quot;}" Classes="tool">
          <StackPanel Orientation="Horizontal">
            <Path Classes="icon nav" Data="{StaticResource IconDone}" />
            <TextBlock TextWrapping="Wrap" Classes="label" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Done&quot;}" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
