<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:help="using:HyperPdf.ViewModels.Help"
        xmlns:views="using:HyperPdf.App.Views"
        x:Class="HyperPdf.App.Views.SignaturesWindow"
        Width="560" SizeToContent="Height" MaxHeight="640" CanResize="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppWindowBackground}">
  <StackPanel Margin="20" Spacing="16">
    <ItemsControl x:Name="SignatureList" />
    <Button x:Name="CloseButton" views:ControlHelp.Text="{x:Static help:Descriptions.CloseWindow}" HorizontalAlignment="Right" Content="Close" IsDefault="True" IsCancel="True" />
  </StackPanel>
</Window>
