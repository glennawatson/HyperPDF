<UserControl xmlns="https://github.com/avaloniaui" xmlns:loc="using:CP.Localisation.Avalonia"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:help="using:HyperPdf.ViewModels.Help"
             xmlns:views="using:HyperPdf.App.Views"
             x:Class="HyperPdf.App.Views.NoticeBarsView">
  <!-- Layout only: every binding is made in code with ReactiveUI.Binding (NoticeBarsView.axaml.cs). -->
  <StackPanel>
    <!-- Says once, calmly, what this document holds that cannot be shown or run, instead of silently showing fallback pages. -->
    <Border x:Name="ContentWarningBar" Classes="toolbar">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="ContentWarningText" AutomationProperties.LiveSetting="Polite" VerticalAlignment="Center" Margin="6,0" TextWrapping="Wrap" />
        <Button Grid.Column="1" x:Name="DismissContentWarningButton" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Hide this message about parts of the document HyperPDF cannot show. It comes back next time the document opens.&quot;}" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Dismiss&quot;}" />
      </Grid>
    </Border>

    <!-- Says plainly when an encrypted document's integrity protection (PDF MAC) failed, is missing or could not be checked. -->
    <Border x:Name="IntegrityNoticeBar" Classes="toolbar">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="IntegrityNoticeText" AutomationProperties.LiveSetting="Assertive" VerticalAlignment="Center" Margin="6,0" TextWrapping="Wrap" />
        <Button Grid.Column="1" x:Name="DismissIntegrityNoticeButton" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Hide this message about the document&apos;s integrity protection. It comes back next time the document opens.&quot;}" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Dismiss&quot;}" />
      </Grid>
    </Border>

    <!-- Says once, calmly, that the file was damaged and repaired to show it; the list of repairs is shown on request. -->
    <Border x:Name="RepairNoticeBar" Classes="toolbar">
      <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
        <TextBlock x:Name="RepairNoticeText" AutomationProperties.LiveSetting="Polite" VerticalAlignment="Center" Margin="6,0" TextWrapping="Wrap" />
        <Button Grid.Column="1" x:Name="ToggleRepairDetailsButton" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Show or hide what was wrong with the file and how it was repaired.&quot;}" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Details&quot;}" />
        <Button Grid.Column="2" x:Name="DismissRepairNoticeButton" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Hide this message about the repaired file. It comes back next time the document opens.&quot;}" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Dismiss&quot;}" />
        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" x:Name="RepairDetailsText" VerticalAlignment="Center" Margin="6,4" TextWrapping="Wrap" />
      </Grid>
    </Border>

    <!-- Says once, calmly, which features the file declares it needs that HyperPDF cannot provide; the list is shown on request. -->
    <Border x:Name="RequirementNoticeBar" Classes="toolbar">
      <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
        <TextBlock x:Name="RequirementNoticeText" AutomationProperties.LiveSetting="Polite" VerticalAlignment="Center" Margin="6,0" TextWrapping="Wrap" />
        <Button Grid.Column="1" x:Name="ToggleRequirementDetailsButton" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Show or hide which features the file needs that HyperPDF does not fully provide.&quot;}" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Details&quot;}" />
        <Button Grid.Column="2" x:Name="DismissRequirementNoticeButton" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Hide this message about features the file needs. It comes back next time the document opens.&quot;}" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Dismiss&quot;}" />
        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" x:Name="RequirementDetailsText" VerticalAlignment="Center" Margin="6,4" TextWrapping="Wrap" />
      </Grid>
    </Border>

    <!-- A message that waits until dismissed, for example a failed save. -->
    <Border x:Name="NoticeBar" Classes="toolbar">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="NoticeText" AutomationProperties.LiveSetting="Assertive" VerticalAlignment="Center" Margin="6,0" TextWrapping="Wrap" />
        <Button Grid.Column="1" x:Name="DismissNoticeButton" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Hide this message.&quot;}" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Dismiss&quot;}" />
      </Grid>
    </Border>

    <!-- Shown when the user chose to be asked before reloading a changed file, or has unsaved edits. -->
    <Border x:Name="ReloadBar" Classes="toolbar">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock TextWrapping="Wrap" x:Name="ReloadText" AutomationProperties.LiveSetting="Polite" VerticalAlignment="Center" Margin="6,0" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;This PDF changed on disk. Reload it?&quot;}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
          <Button x:Name="ReloadButton" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Load the changed file from the disk.&quot;}" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Reload&quot;}" />
          <Button x:Name="DismissReloadButton" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Keep what is on screen now and hide this message.&quot;}" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Dismiss&quot;}" />
        </StackPanel>
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
