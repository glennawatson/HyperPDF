<Window xmlns="https://github.com/avaloniaui" xmlns:loc="using:CP.Localisation.Avalonia"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:help="using:HyperPdf.ViewModels.Help"
        xmlns:views="using:HyperPdf.App.Views"
        xmlns:controls="using:HyperPdf.App.Controls"
        x:Class="HyperPdf.App.Views.SignatureMarkWindow"
        Width="560" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppWindowBackground}">
  <StackPanel Margin="20" Spacing="12">
    <TextBlock Classes="secondary" TextWrapping="Wrap"
               Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Choose how to make it: type it, draw it, or use a picture. Check the preview, then place it on the page.&quot;}" />

    <!-- The three ways stay visible, in the same order, every time. -->
    <StackPanel Orientation="Horizontal" Spacing="16">
      <RadioButton x:Name="TypeOption" GroupName="MarkStyle" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Type&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Type&quot;}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Make it by typing. This works with only a keyboard.&quot;}" />
      <RadioButton x:Name="DrawOption" GroupName="MarkStyle" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Draw&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Draw&quot;}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Make it by drawing with a mouse, pen or finger.&quot;}" />
      <RadioButton x:Name="ImageOption" GroupName="MarkStyle" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Image&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Image&quot;}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Make it from a picture, such as a photo or scan of your signature.&quot;}" />
    </StackPanel>

    <StackPanel x:Name="TypePanel" Spacing="6">
      <TextBlock x:Name="TextLabel" />
      <TextBox x:Name="MarkTextBox" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Type it as you want it to appear.&quot;}" MinHeight="32" />
    </StackPanel>

    <StackPanel x:Name="DrawPanel" Spacing="6">
      <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Draw with a mouse, pen or finger. Typing is the keyboard way.&quot;}" />
      <Border Background="{DynamicResource AppSignaturePaperBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="3" Height="160">
        <controls:SignaturePad x:Name="Pad" FlowDirection="LeftToRight" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Drawing area&quot;}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Draw here. Each line you draw is added until you clear it.&quot;}" />
      </Border>
      <Button x:Name="ClearDrawingButton" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Clear Drawing&quot;}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Rub out the drawing and start again.&quot;}" />
    </StackPanel>

    <StackPanel x:Name="ImagePanel" Spacing="6">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="ChooseImageButton" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Choose Picture…&quot;}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Choose a picture of your signature from a folder.&quot;}" />
        <TextBlock x:Name="ImageNameText" VerticalAlignment="Center" />
      </StackPanel>
      <CheckBox x:Name="RemovePaperCheck" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Remove white paper&quot;}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Make white paper see-through so only the ink shows. Untick to keep the picture as it is.&quot;}" />
      <TextBlock x:Name="ImageErrorText" AutomationProperties.LiveSetting="Assertive" TextWrapping="Wrap" />
    </StackPanel>

    <TextBlock TextWrapping="Wrap" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Preview&quot;}" AutomationProperties.HeadingLevel="2" />
    <Border Background="{DynamicResource AppSignaturePaperBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="3" Height="96">
      <controls:SignatureMarkPreview x:Name="Preview" FlowDirection="LeftToRight" />
    </Border>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <CheckBox x:Name="RememberCheck" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Remember on this computer&quot;}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Keep it on this computer to use again. Untick to forget it after this time.&quot;}" />
      <Button x:Name="ForgetButton" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Forget Remembered&quot;}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Forget the remembered one now. Signatures already placed are not changed.&quot;}" />
    </StackPanel>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="CancelButton" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Close this window without making any changes. Shortcut: Esc&quot;}" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Cancel&quot;}" IsCancel="True" />
      <Button x:Name="UseButton" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Use this, then choose where it goes on the page.&quot;}" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
