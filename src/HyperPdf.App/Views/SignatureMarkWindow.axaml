<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:HyperPdf.App.Views"
        xmlns:controls="using:HyperPdf.App.Controls"
        x:Class="HyperPdf.App.Views.SignatureMarkWindow"
        Width="560" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppWindowBackground}">
  <StackPanel Margin="20" Spacing="12">
    <TextBlock Classes="secondary" TextWrapping="Wrap"
               Text="Choose how to make it: type it, draw it, or use a picture. Check the preview, then place it on the page." />

    <!-- The three ways stay visible, in the same order, every time. -->
    <StackPanel Orientation="Horizontal" Spacing="16">
      <RadioButton x:Name="TypeOption" GroupName="MarkStyle" Content="Type" AutomationProperties.Name="Type" views:ControlHelp.Text="{x:Static views:Descriptions.MarkType}" />
      <RadioButton x:Name="DrawOption" GroupName="MarkStyle" Content="Draw" AutomationProperties.Name="Draw" views:ControlHelp.Text="{x:Static views:Descriptions.MarkDraw}" />
      <RadioButton x:Name="ImageOption" GroupName="MarkStyle" Content="Image" AutomationProperties.Name="Image" views:ControlHelp.Text="{x:Static views:Descriptions.MarkImage}" />
    </StackPanel>

    <StackPanel x:Name="TypePanel" Spacing="6">
      <TextBlock x:Name="TextLabel" />
      <TextBox x:Name="MarkTextBox" views:ControlHelp.Text="{x:Static views:Descriptions.MarkText}" MinHeight="32" />
    </StackPanel>

    <StackPanel x:Name="DrawPanel" Spacing="6">
      <TextBlock Classes="secondary" TextWrapping="Wrap" Text="Draw with a mouse, pen or finger. Typing is the keyboard way." />
      <Border Background="{DynamicResource AppSignaturePaperBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="3" Height="160">
        <controls:SignaturePad x:Name="Pad" AutomationProperties.Name="Drawing area" views:ControlHelp.Text="{x:Static views:Descriptions.MarkPad}" />
      </Border>
      <Button x:Name="ClearDrawingButton" Content="Clear Drawing" views:ControlHelp.Text="{x:Static views:Descriptions.ClearDrawing}" />
    </StackPanel>

    <StackPanel x:Name="ImagePanel" Spacing="6">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="ChooseImageButton" Content="Choose Picture…" views:ControlHelp.Text="{x:Static views:Descriptions.ChooseSignatureImage}" />
        <TextBlock x:Name="ImageNameText" VerticalAlignment="Center" />
      </StackPanel>
      <CheckBox x:Name="RemovePaperCheck" Content="Remove white paper" views:ControlHelp.Text="{x:Static views:Descriptions.RemovePaper}" />
      <TextBlock x:Name="ImageErrorText" AutomationProperties.LiveSetting="Assertive" TextWrapping="Wrap" />
    </StackPanel>

    <TextBlock Text="Preview" AutomationProperties.HeadingLevel="2" />
    <Border Background="{DynamicResource AppSignaturePaperBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="3" Height="96">
      <controls:SignatureMarkPreview x:Name="Preview" />
    </Border>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <CheckBox x:Name="RememberCheck" Content="Remember on this computer" views:ControlHelp.Text="{x:Static views:Descriptions.RememberMark}" />
      <Button x:Name="ForgetButton" Content="Forget Remembered" views:ControlHelp.Text="{x:Static views:Descriptions.ForgetMark}" />
    </StackPanel>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="CancelButton" views:ControlHelp.Text="{x:Static views:Descriptions.Cancel}" Content="Cancel" IsCancel="True" />
      <Button x:Name="UseButton" views:ControlHelp.Text="{x:Static views:Descriptions.UseMark}" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
