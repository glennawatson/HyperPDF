<Window xmlns="https://github.com/avaloniaui" xmlns:loc="using:CP.Localisation.Avalonia"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:help="using:HyperPdf.ViewModels.Help"
        xmlns:views="using:HyperPdf.App.Views"
        x:Class="HyperPdf.App.Views.ExportPagesWindow"
        Title="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Export Pages&quot;}" Width="680" Height="860" MinWidth="480" MinHeight="560" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppWindowBackground}">
  <!-- Layout only: bindings are made in code (ExportPagesWindow.axaml.cs). Every section is always present, so nothing moves while pages are exported. The choices scroll; the progress and summary stay on screen. -->
  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="20">
    <StackPanel Spacing="8">
      <TextBlock x:Name="HeadingText" FontSize="16" TextWrapping="Wrap" AutomationProperties.HeadingLevel="1" />
      <TextBlock TextWrapping="Wrap" Classes="secondary" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Save pages as picture files or drawings. Your open file is never changed. A format that holds one page makes a numbered file for each page you choose.&quot;}" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="8">
        <TextBlock TextWrapping="Wrap" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;File format&quot;}" FontWeight="SemiBold" AutomationProperties.HeadingLevel="2" />
        <ListBox x:Name="FormatList" views:ControlHelp.Text="{views:LiveHelp ExportFormats}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;File format&quot;}" />
        <TextBlock TextWrapping="Wrap" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Pages&quot;}" FontWeight="SemiBold" AutomationProperties.HeadingLevel="2" />
        <ListBox x:Name="ScopeList" views:ControlHelp.Text="{views:LiveHelp ExportScopes}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Pages to export&quot;}" />
        <TextBox x:Name="PagesBox" views:ControlHelp.Text="{views:LiveHelp ExportPageRange}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Pages to export, such as 1-3, 7&quot;}" PlaceholderText="1-3, 7" />
        <TextBlock TextWrapping="Wrap" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Picture resolution (dots to the inch)&quot;}" FontWeight="SemiBold" AutomationProperties.HeadingLevel="2" />
        <NumericUpDown x:Name="DpiBox" views:ControlHelp.Text="{views:LiveHelp ExportResolution}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Picture resolution in dots to the inch&quot;}" Minimum="10" Maximum="2400" Increment="25" FormatString="0" HorizontalAlignment="Left" MinWidth="160" />
        <CheckBox x:Name="MarkupBox" views:ControlHelp.Text="{views:LiveHelp ExportMarkup}" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Include comments and form fields&quot;}" />
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Spacing="4" Margin="0,12,0,0">
      <TextBlock TextWrapping="Wrap" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Progress and summary&quot;}" FontWeight="SemiBold" AutomationProperties.HeadingLevel="2" />
      <!-- The busy bar and the result bar share one cell, so the layout stays still; only one is visible at a time. -->
      <Grid>
        <ProgressBar x:Name="ExportProgress" Minimum="0" Maximum="100" views:ControlHelp.Text="{views:LiveHelp ExportProgress}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Progress of the export&quot;}" />
        <ProgressBar x:Name="BusyProgress" IsIndeterminate="True" views:ControlHelp.Text="{views:LiveHelp ExportProgress}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Exporting pages&quot;}" />
      </Grid>
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      <TextBlock x:Name="ErrorText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
      <Border BorderThickness="1" Padding="10" Height="120" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <SelectableTextBlock x:Name="ResultText" TextWrapping="Wrap" Focusable="True" AutomationProperties.LiveSetting="Polite" views:ControlHelp.Text="{views:LiveHelp ExportResult}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Summary of the export&quot;}" />
        </ScrollViewer>
      </Border>
    </StackPanel>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button x:Name="CancelButton" views:ControlHelp.Text="{views:LiveHelp ExportCancel}" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;_Cancel&quot;}" />
      <Button x:Name="SaveButton" views:ControlHelp.Text="{views:LiveHelp ExportSave}" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;_Export…&quot;}" IsDefault="True" />
      <Button x:Name="CloseButton" views:ControlHelp.Text="{views:LiveHelp CloseWindow}" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Clos_e&quot;}" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
