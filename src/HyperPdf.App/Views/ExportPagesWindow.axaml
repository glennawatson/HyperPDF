<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:help="using:HyperPdf.ViewModels.Help"
        xmlns:views="using:HyperPdf.App.Views"
        x:Class="HyperPdf.App.Views.ExportPagesWindow"
        Title="Export Pages" Width="680" Height="860" MinWidth="480" MinHeight="560" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppWindowBackground}">
  <!-- Layout only: bindings are made in code (ExportPagesWindow.axaml.cs). Every section is always present, so nothing moves while pages are exported. The choices scroll; the progress and summary stay on screen. -->
  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="20">
    <StackPanel Spacing="8">
      <TextBlock x:Name="HeadingText" FontSize="16" TextWrapping="Wrap" AutomationProperties.HeadingLevel="1" />
      <TextBlock TextWrapping="Wrap" Classes="secondary" Text="Save pages as picture files or drawings. Your open file is never changed. A format that holds one page makes a numbered file for each page you choose." />
    </StackPanel>

    <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="8">
        <TextBlock Text="File format" FontWeight="SemiBold" AutomationProperties.HeadingLevel="2" />
        <ListBox x:Name="FormatList" views:ControlHelp.Text="{x:Static help:Descriptions.ExportFormats}" AutomationProperties.Name="File format" />
        <TextBlock Text="Pages" FontWeight="SemiBold" AutomationProperties.HeadingLevel="2" />
        <ListBox x:Name="ScopeList" views:ControlHelp.Text="{x:Static help:Descriptions.ExportScopes}" AutomationProperties.Name="Pages to export" />
        <TextBox x:Name="PagesBox" views:ControlHelp.Text="{x:Static help:Descriptions.ExportPageRange}" AutomationProperties.Name="Pages to export, such as 1-3, 7" PlaceholderText="1-3, 7" />
        <TextBlock Text="Picture resolution (dots to the inch)" FontWeight="SemiBold" AutomationProperties.HeadingLevel="2" />
        <NumericUpDown x:Name="DpiBox" views:ControlHelp.Text="{x:Static help:Descriptions.ExportResolution}" AutomationProperties.Name="Picture resolution in dots to the inch" Minimum="10" Maximum="2400" Increment="25" FormatString="0" HorizontalAlignment="Left" MinWidth="160" />
        <CheckBox x:Name="MarkupBox" views:ControlHelp.Text="{x:Static help:Descriptions.ExportMarkup}" Content="Include comments and form fields" />
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Spacing="4" Margin="0,12,0,0">
      <TextBlock Text="Progress and summary" FontWeight="SemiBold" AutomationProperties.HeadingLevel="2" />
      <!-- The busy bar and the result bar share one cell, so the layout stays still; only one is visible at a time. -->
      <Grid>
        <ProgressBar x:Name="ExportProgress" Minimum="0" Maximum="100" views:ControlHelp.Text="{x:Static help:Descriptions.ExportProgress}" AutomationProperties.Name="Progress of the export" />
        <ProgressBar x:Name="BusyProgress" IsIndeterminate="True" views:ControlHelp.Text="{x:Static help:Descriptions.ExportProgress}" AutomationProperties.Name="Exporting pages" />
      </Grid>
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      <TextBlock x:Name="ErrorText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
      <Border BorderThickness="1" Padding="10" Height="120" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <SelectableTextBlock x:Name="ResultText" TextWrapping="Wrap" Focusable="True" AutomationProperties.LiveSetting="Polite" views:ControlHelp.Text="{x:Static help:Descriptions.ExportResult}" AutomationProperties.Name="Summary of the export" />
        </ScrollViewer>
      </Border>
    </StackPanel>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button x:Name="CancelButton" views:ControlHelp.Text="{x:Static help:Descriptions.ExportCancel}" Content="_Cancel" />
      <Button x:Name="SaveButton" views:ControlHelp.Text="{x:Static help:Descriptions.ExportSave}" Content="_Export…" IsDefault="True" />
      <Button x:Name="CloseButton" views:ControlHelp.Text="{x:Static help:Descriptions.CloseWindow}" Content="Clos_e" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
