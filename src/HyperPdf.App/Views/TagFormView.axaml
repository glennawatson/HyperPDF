<UserControl xmlns="https://github.com/avaloniaui" xmlns:loc="using:CP.Localisation.Avalonia"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:help="using:HyperPdf.ViewModels.Help"
             xmlns:views="using:HyperPdf.App.Views"
             x:Class="HyperPdf.App.Views.TagFormView">
  <!-- Layout only: every binding is made in code with ReactiveUI.Binding (TagFormView.axaml.cs). -->
  <StackPanel Spacing="4">
    <TextBlock TextWrapping="Wrap" x:Name="TypeLabel" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Tag type&quot;}" FontWeight="SemiBold" />
    <ComboBox x:Name="TypeBox" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Tag type&quot;}" AutomationProperties.LabeledBy="{Binding #TypeLabel}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;What the chosen tag is, such as a heading or a paragraph. Only types the file may use are listed.&quot;}" HorizontalAlignment="Stretch" />
    <TextBlock TextWrapping="Wrap" x:Name="ScopeLabel" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Cells this header labels&quot;}" FontWeight="SemiBold" Margin="0,6,0,0" />
    <ComboBox x:Name="ScopeBox" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Cells this header labels&quot;}" AutomationProperties.LabeledBy="{Binding #ScopeLabel}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Which cells this table header labels: the cells in its row, in its column, or both. Screen readers use it to say which header goes with a cell.&quot;}" HorizontalAlignment="Stretch" />
    <TextBlock TextWrapping="Wrap" x:Name="RowSpanLabel" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Rows this cell covers&quot;}" FontWeight="SemiBold" Margin="0,6,0,0" />
    <TextBox x:Name="RowSpanBox" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Rows this cell covers&quot;}" AutomationProperties.LabeledBy="{Binding #RowSpanLabel}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;How many rows or columns this table cell stretches across. Leave it at 1 for a normal cell.&quot;}" />
    <TextBlock TextWrapping="Wrap" x:Name="ColumnSpanLabel" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Columns this cell covers&quot;}" FontWeight="SemiBold" Margin="0,6,0,0" />
    <TextBox x:Name="ColumnSpanBox" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Columns this cell covers&quot;}" AutomationProperties.LabeledBy="{Binding #ColumnSpanLabel}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;How many rows or columns this table cell stretches across. Leave it at 1 for a normal cell.&quot;}" />
    <TextBlock TextWrapping="Wrap" x:Name="NumberingLabel" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;How list items are labelled&quot;}" FontWeight="SemiBold" Margin="0,6,0,0" />
    <ComboBox x:Name="NumberingBox" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;How list items are labelled&quot;}" AutomationProperties.LabeledBy="{Binding #NumberingLabel}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;How this list labels its items, such as bullets or numbers. Screen readers use it to say what kind of list it is.&quot;}" HorizontalAlignment="Stretch" />
    <TextBlock TextWrapping="Wrap" x:Name="PlacementLabel" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;How this tag sits in the text&quot;}" FontWeight="SemiBold" Margin="0,6,0,0" />
    <ComboBox x:Name="PlacementBox" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;How this tag sits in the text&quot;}" AutomationProperties.LabeledBy="{Binding #PlacementLabel}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Whether this tag is its own block (Block), runs inside a line (Inline), or sits before, at the start or at the end of its text.&quot;}" HorizontalAlignment="Stretch" />
    <TextBlock x:Name="AlternateLabel" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Description for a screen reader&quot;}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" />
    <TextBox x:Name="AlternateBox" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Description for a screen reader&quot;}" AutomationProperties.LabeledBy="{Binding #AlternateLabel}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;What a screen reader says in place of the content, for example what a picture shows.&quot;}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" />
    <TextBlock TextWrapping="Wrap" x:Name="ActualLabel" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Replacement text&quot;}" FontWeight="SemiBold" Margin="0,6,0,0" />
    <TextBox x:Name="ActualBox" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Replacement text&quot;}" AutomationProperties.LabeledBy="{Binding #ActualLabel}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Text that stands in for the content when it is read aloud or copied. Leave it empty when the page text reads well.&quot;}" AcceptsReturn="True" TextWrapping="Wrap" />
    <TextBlock TextWrapping="Wrap" x:Name="LanguageLabel" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Language, such as en-AU&quot;}" FontWeight="SemiBold" Margin="0,6,0,0" />
    <TextBox x:Name="LanguageBox" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Language&quot;}" AutomationProperties.LabeledBy="{Binding #LanguageLabel}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;The language of this tag&apos;s content, such as en-AU, so a screen reader uses the right voice. Leave it empty to use the document&apos;s language.&quot;}" />
    <TextBlock TextWrapping="Wrap" x:Name="TitleLabel" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Title&quot;}" FontWeight="SemiBold" Margin="0,6,0,0" />
    <TextBox x:Name="TitleBox" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Title&quot;}" AutomationProperties.LabeledBy="{Binding #TitleLabel}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;A short title for the chosen tag.&quot;}" />
    <Button x:Name="ApplyButton" Margin="0,8,0,4" HorizontalAlignment="Stretch" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Save Changes&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Save tag changes&quot;}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Save the type and text above to the chosen tag. Undo takes the change back.&quot;}" />
  </StackPanel>
</UserControl>
