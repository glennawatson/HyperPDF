<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:help="using:HyperPdf.ViewModels.Help"
        xmlns:views="using:HyperPdf.App.Views"
        x:Class="HyperPdf.App.Views.Pdf20CopyWindow"
        Title="Save as PDF 2.0 Copy" Width="640" Height="560" MinWidth="480" MinHeight="420" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppWindowBackground}">
  <!-- Layout only: bindings are made in code (Pdf20CopyWindow.axaml.cs). Every section is always present, so nothing moves while a copy is made. -->
  <Grid RowDefinitions="Auto,*,Auto" Margin="20">
    <StackPanel Spacing="8">
      <TextBlock x:Name="HeadingText" FontSize="16" TextWrapping="Wrap" AutomationProperties.HeadingLevel="1" />
      <TextBlock TextWrapping="Wrap" Classes="secondary" Text="PDF 2.0 is the newest version of PDF. The copy gets a PDF 2.0 header and stops using features that version has retired. Details stored in those features are moved when they can be. If something cannot be kept, no file is saved and the summary says why." />
    </StackPanel>

    <StackPanel Grid.Row="1" Spacing="4" Margin="0,12,0,0">
      <TextBlock Text="Progress and summary" FontWeight="SemiBold" AutomationProperties.HeadingLevel="2" />
      <!-- The busy bar and the result bar share one cell, so the layout stays still; only one is visible at a time. -->
      <Grid>
        <ProgressBar x:Name="CopyProgress" Minimum="0" Maximum="100" views:ControlHelp.Text="{x:Static help:Descriptions.Pdf20Progress}" AutomationProperties.Name="Progress of the copy" />
        <ProgressBar x:Name="BusyProgress" IsIndeterminate="True" views:ControlHelp.Text="{x:Static help:Descriptions.Pdf20Progress}" AutomationProperties.Name="Making the copy" />
      </Grid>
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      <TextBlock x:Name="ErrorText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
      <Border BorderThickness="1" Padding="10" MinHeight="160" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <SelectableTextBlock x:Name="ResultText" TextWrapping="Wrap" Focusable="True" AutomationProperties.LiveSetting="Polite" views:ControlHelp.Text="{x:Static help:Descriptions.Pdf20Result}" AutomationProperties.Name="Summary of the copy" />
        </ScrollViewer>
      </Border>
    </StackPanel>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button x:Name="CancelButton" views:ControlHelp.Text="{x:Static help:Descriptions.Pdf20Cancel}" Content="_Cancel" />
      <Button x:Name="SaveButton" views:ControlHelp.Text="{x:Static help:Descriptions.Pdf20Save}" Content="_Save Copy…" IsDefault="True" />
      <Button x:Name="CloseButton" views:ControlHelp.Text="{x:Static help:Descriptions.CloseWindow}" Content="Clos_e" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
