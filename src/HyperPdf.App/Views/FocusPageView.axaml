<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HyperPdf.App.Views.FocusPageView">
  <!-- One page of Focus Mode: a quiet page marker, then its text in reading order. -->
  <StackPanel>
    <TextBlock x:Name="PageLabel" Classes="focusPage" />
    <TextBlock x:Name="EmptyText" Classes="focusPage" Text="No text on this page." />
    <ItemsControl x:Name="BlockList" />
  </StackPanel>
</UserControl>
