<UserControl xmlns="https://github.com/avaloniaui" xmlns:loc="using:CP.Localisation.Avalonia"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HyperPdf.App.Views.FocusPageView">
  <!-- One page of Focus Mode: a quiet page marker, then its text in reading order. -->
  <StackPanel>
    <TextBlock x:Name="PageLabel" Classes="focusPage" />
    <TextBlock TextWrapping="Wrap" x:Name="EmptyText" Classes="focusPage" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;No text on this page.&quot;}" />
    <ItemsControl x:Name="BlockList" />
  </StackPanel>
</UserControl>
