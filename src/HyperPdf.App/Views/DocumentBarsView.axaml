<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:help="using:HyperPdf.ViewModels.Help"
             xmlns:views="using:HyperPdf.App.Views"
             x:Class="HyperPdf.App.Views.DocumentBarsView">
  <!-- Layout only: every binding is made in code with ReactiveUI.Binding (DocumentBarsView.axaml.cs). -->
  <StackPanel>
    <!-- Shown for digitally signed documents. Signatures are checked only when asked, as checking may go online. -->
    <Border x:Name="SignedBar" Classes="toolbar">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="6,0">
          <Path Classes="icon nav" Data="{StaticResource IconSignature}" />
          <TextBlock x:Name="SignedText" VerticalAlignment="Center" />
        </StackPanel>
        <Button Grid.Column="1" x:Name="CheckSignaturesButton" views:ControlHelp.Text="{x:Static help:Descriptions.CheckSignatures}" Content="Check Signatures" />
      </Grid>
    </Border>

    <!-- Shown on every page of a preseparated file, so nothing moves: which colourant the page is and which printed page it is part of. -->
    <Border x:Name="SeparationBar" Classes="toolbar" AutomationProperties.Name="Colour separation">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock x:Name="SeparationText" AutomationProperties.LiveSetting="Polite" VerticalAlignment="Center" Margin="6,0" TextWrapping="Wrap" />
        <TextBlock Grid.Column="1" x:Name="SeparationChoiceLabel" Text="Show separation" VerticalAlignment="Center" Margin="8,0,4,0" />
        <ComboBox Grid.Column="2" x:Name="SeparationBox" AutomationProperties.Name="Show separation" Width="200" VerticalAlignment="Center" Margin="0,0,6,0"
                  views:ControlHelp.Text="{x:Static help:Descriptions.ShowSeparation}" />
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
