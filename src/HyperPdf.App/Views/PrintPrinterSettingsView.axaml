<UserControl xmlns="https://github.com/avaloniaui" xmlns:loc="using:CP.Localisation.Avalonia"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:help="using:HyperPdf.ViewModels.Help"
             xmlns:views="using:HyperPdf.App.Views"
             x:Class="HyperPdf.App.Views.PrintPrinterSettingsView">
  <!-- Layout only: every binding is made in code with ReactiveUI.Binding (PrintPrinterSettingsView.axaml.cs). -->
  <StackPanel Spacing="14">
    <Grid ColumnDefinitions="136,*">
      <TextBlock TextWrapping="Wrap" x:Name="DestinationLabel" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Destination&quot;}" VerticalAlignment="Center" />
      <ComboBox x:Name="DestinationBox" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Choose a printer, save as a PDF file or use the system print dialog.&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Destination&quot;}" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" />
    </Grid>
    <Grid ColumnDefinitions="136,*">
      <TextBlock TextWrapping="Wrap" x:Name="PagesLabel" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Pages&quot;}" VerticalAlignment="Center" />
      <ComboBox x:Name="PagesBox" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Choose which pages to print: all, the current page or your own list.&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Pages&quot;}" Grid.Column="1" HorizontalAlignment="Stretch">
        <ComboBoxItem Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;All&quot;}" />
        <ComboBoxItem Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Current page&quot;}" />
        <ComboBoxItem Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Custom&quot;}" />
      </ComboBox>
    </Grid>
    <Grid x:Name="CustomPagesRow" ColumnDefinitions="136,*">
      <TextBox x:Name="CustomPagesBox" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Type the pages to print, such as 1-3, 7.&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Page range&quot;}" Grid.Column="1" PlaceholderText="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;For example 1-3, 7&quot;}" />
    </Grid>
    <Grid x:Name="CopiesRow" ColumnDefinitions="136,*">
      <TextBlock TextWrapping="Wrap" x:Name="CopiesLabel" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Copies&quot;}" VerticalAlignment="Center" />
      <NumericUpDown x:Name="CopiesBox" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Choose how many copies to print.&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Copies&quot;}" Grid.Column="1" Minimum="1" Maximum="999" Increment="1" FormatString="0" HorizontalAlignment="Stretch" />
    </Grid>
    <Grid x:Name="ColourRow" ColumnDefinitions="136,*">
      <TextBlock TextWrapping="Wrap" x:Name="ColourLabel" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Colour&quot;}" VerticalAlignment="Center" />
      <ComboBox x:Name="ColourBox" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Choose to print in colour or in black and white.&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Colour&quot;}" Grid.Column="1" HorizontalAlignment="Stretch">
        <ComboBoxItem Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Colour&quot;}" />
        <ComboBoxItem Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Black and white&quot;}" />
      </ComboBox>
    </Grid>
    <Grid x:Name="SidesRow" ColumnDefinitions="136,*">
      <CheckBox x:Name="TwoSidedBox" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Print on both sides of the paper.&quot;}" Grid.Column="1" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Print on both sides&quot;}" />
    </Grid>
    <Grid x:Name="BindingRow" ColumnDefinitions="136,*" RowDefinitions="Auto,Auto" RowSpacing="4">
      <TextBlock TextWrapping="Wrap" x:Name="BindingLabel" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Turn pages&quot;}" VerticalAlignment="Center" />
      <ComboBox x:Name="BindingBox" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Choose which edge the paper turns on when printing on both sides.&quot;}" Grid.Column="1" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Turn pages&quot;}" HorizontalAlignment="Stretch">
        <ComboBoxItem Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Long edge&quot;}" />
        <ComboBoxItem Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Short edge&quot;}" />
      </ComboBox>
      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="secondary" TextWrapping="Wrap" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;If the backs are upside down, try the other edge.&quot;}" />
    </Grid>
  </StackPanel>
</UserControl>
