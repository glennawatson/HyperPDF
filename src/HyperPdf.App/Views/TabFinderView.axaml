<UserControl xmlns="https://github.com/avaloniaui" xmlns:loc="using:CP.Localisation.Avalonia"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:help="using:HyperPdf.ViewModels.Help"
             xmlns:views="using:HyperPdf.App.Views"
             x:Class="HyperPdf.App.Views.TabFinderView">
  <!-- Layout only: every binding is made in code with ReactiveUI.Binding (TabFinderView.axaml.cs). -->
  <Button AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Find an open tab&quot;}" x:Name="TabFinderButton" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Find an open tab by part of its name, title or folder. Shortcut: Ctrl+Shift+A&quot;}" Classes="tool">
    <StackPanel Orientation="Horizontal">
      <Path Classes="icon nav" Data="{StaticResource IconSearch}" />
      <TextBlock x:Name="TabCountText" Classes="label" />
    </StackPanel>
    <Button.Flyout>
      <Flyout Placement="BottomEdgeAlignedRight">
        <DockPanel Width="380" Height="420">
          <TextBox x:Name="TabFinderBox" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Type part of a name, title or folder. Press Enter to go to the first tab found.&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Find an open tab&quot;}" DockPanel.Dock="Top" Margin="0,0,0,6" PlaceholderText="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Type part of a name, title or folder&quot;}" />
          <ListBox x:Name="TabFinderList" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Matching tabs&quot;}" Background="Transparent" />
        </DockPanel>
      </Flyout>
    </Button.Flyout>
  </Button>
</UserControl>
