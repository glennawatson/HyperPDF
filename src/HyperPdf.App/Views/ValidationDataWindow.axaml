<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:HyperPdf.App.Views"
        x:Class="HyperPdf.App.Views.ValidationDataWindow"
        Title="Add Validation Data or Timestamp" Width="640" Height="760" MinWidth="480" MinHeight="520" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppWindowBackground}">
  <!-- Layout only: bindings are made in code (ValidationDataWindow.axaml.cs). Every section is always present, so nothing moves while a copy is made. -->
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="20">
    <StackPanel Spacing="8">
      <TextBlock x:Name="HeadingText" FontSize="16" TextWrapping="Wrap" AutomationProperties.HeadingLevel="1" />
      <TextBlock TextWrapping="Wrap" Classes="secondary" Text="These steps keep a signed document checkable for many years. Each one saves a new copy; your open file is not changed." />
      <TextBlock Text="What to add" FontWeight="SemiBold" AutomationProperties.HeadingLevel="2" />
    </StackPanel>

    <ListBox x:Name="ActionList" Grid.Row="1" Margin="0,8,0,0" Focusable="True" views:ControlHelp.Text="{x:Static views:Descriptions.ValidationActions}" AutomationProperties.Name="What to add to the copy" />

    <CheckBox x:Name="VriBox" Grid.Row="2" Margin="0,8,0,0" views:ControlHelp.Text="{x:Static views:Descriptions.ValidationRecords}"
              Content="Add a record for each signature." />

    <StackPanel Grid.Row="3" Spacing="4" Margin="0,12,0,0">
      <TextBlock Text="Progress and summary" FontWeight="SemiBold" AutomationProperties.HeadingLevel="2" />
      <!-- The busy bar and the result bar share one cell, so the layout stays still; only one is visible at a time. -->
      <Grid>
        <ProgressBar x:Name="CopyProgress" Minimum="0" Maximum="100" views:ControlHelp.Text="{x:Static views:Descriptions.ValidationProgress}" AutomationProperties.Name="Progress of the copy" />
        <ProgressBar x:Name="BusyProgress" IsIndeterminate="True" views:ControlHelp.Text="{x:Static views:Descriptions.ValidationProgress}" AutomationProperties.Name="Making the copy" />
      </Grid>
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      <TextBlock x:Name="ErrorText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
      <Border BorderThickness="1" Padding="10" MinHeight="140" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <SelectableTextBlock x:Name="ResultText" TextWrapping="Wrap" Focusable="True" AutomationProperties.LiveSetting="Polite" views:ControlHelp.Text="{x:Static views:Descriptions.ValidationResult}" AutomationProperties.Name="Summary of the copy" />
        </ScrollViewer>
      </Border>
    </StackPanel>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button x:Name="CancelButton" views:ControlHelp.Text="{x:Static views:Descriptions.ValidationCancel}" Content="_Cancel" />
      <Button x:Name="SaveButton" views:ControlHelp.Text="{x:Static views:Descriptions.ValidationSave}" Content="_Save Copy…" IsDefault="True" />
      <Button x:Name="CloseButton" views:ControlHelp.Text="{x:Static views:Descriptions.CloseWindow}" Content="Clos_e" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
