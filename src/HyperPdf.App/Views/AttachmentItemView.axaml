<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HyperPdf.App.Views.AttachmentItemView">
  <DockPanel Background="Transparent">
    <Path DockPanel.Dock="Left" Classes="icon" Margin="0,0,8,0" Data="{StaticResource IconAttachment}" />
    <StackPanel Spacing="2">
      <TextBlock x:Name="NameText" TextTrimming="CharacterEllipsis" />
      <TextBlock x:Name="SizeText" Classes="secondary" FontSize="11" />
    </StackPanel>
  </DockPanel>
</UserControl>
