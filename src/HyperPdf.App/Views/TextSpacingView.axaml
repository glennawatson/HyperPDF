<UserControl xmlns="https://github.com/avaloniaui" xmlns:loc="using:CP.Localisation.Avalonia"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:help="using:HyperPdf.ViewModels.Help"
             xmlns:views="using:HyperPdf.App.Views"
             x:Class="HyperPdf.App.Views.TextSpacingView">
  <!-- Layout only: every binding is made in code with ReactiveUI.Binding (TextSpacingView.axaml.cs). -->
  <Button AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Spacing&quot;}" x:Name="SpacingButton" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Choose the space between lines and between letters.&quot;}" Classes="tool">
    <StackPanel Orientation="Horizontal">
      <Path Classes="icon edit" Data="{StaticResource IconLineWidth}" />
      <TextBlock TextWrapping="Wrap" x:Name="SpacingText" Classes="label" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Spacing&quot;}" />
    </StackPanel>
    <Button.Flyout>
      <MenuFlyout>
        <MenuItem Header="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Line spacing&quot;}" IsEnabled="False" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Choose the space between lines and between letters.&quot;}" />
        <MenuItem x:Name="SingleSpacingItem" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Choose the space between lines and between letters.&quot;}" Header="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;_Single&quot;}" />
        <MenuItem x:Name="NormalSpacingItem" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Choose the space between lines and between letters.&quot;}" Header="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;_Normal&quot;}" />
        <MenuItem x:Name="OneHalfSpacingItem" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Choose the space between lines and between letters.&quot;}" Header="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;One and a _Half&quot;}" />
        <MenuItem x:Name="DoubleSpacingItem" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Choose the space between lines and between letters.&quot;}" Header="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;_Double&quot;}" />
        <Separator />
        <MenuItem Header="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Letter spacing&quot;}" IsEnabled="False" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Choose the space between lines and between letters.&quot;}" />
        <MenuItem x:Name="TightLettersItem" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Choose the space between lines and between letters.&quot;}" Header="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;_Tight&quot;}" />
        <MenuItem x:Name="NormalLettersItem" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Choose the space between lines and between letters.&quot;}" Header="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;N_ormal Letters&quot;}" />
        <MenuItem x:Name="WideLettersItem" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Choose the space between lines and between letters.&quot;}" Header="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;_Wide&quot;}" />
        <MenuItem x:Name="WiderLettersItem" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Choose the space between lines and between letters.&quot;}" Header="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Wi_der&quot;}" />
      </MenuFlyout>
    </Button.Flyout>
  </Button>
</UserControl>
