<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:HyperPdf.App.Views"
             x:Class="HyperPdf.App.Views.TabBarView">
  <!-- Layout only: every binding is made in code with ReactiveUI.Binding (TabBarView.axaml.cs). -->
  <Border Classes="tabbar">
    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
      <ListBox x:Name="TabStrip" AutomationProperties.Name="Open documents" Classes="tabstrip"
               ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <!-- Virtualised so a thousand tabs cost no more than the ones on screen. -->
            <VirtualizingStackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
      </ListBox>
      <views:TabFinderView x:Name="TabFinder" Grid.Column="1" />
      <Button AutomationProperties.Name="Open" x:Name="OpenButton" views:ControlHelp.Text="{x:Static views:Descriptions.Open}" Grid.Column="2" Classes="tool">
        <StackPanel Orientation="Horizontal">
          <Path Classes="icon add" Data="{StaticResource IconAdd}" />
          <TextBlock Classes="label" Text="Open" />
        </StackPanel>
      </Button>
      <views:TabsMenuView x:Name="TabsMenu" Grid.Column="3" />
    </Grid>
  </Border>
</UserControl>
