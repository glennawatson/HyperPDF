<UserControl xmlns="https://github.com/avaloniaui" xmlns:loc="using:CP.Localisation.Avalonia"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:help="using:HyperPdf.ViewModels.Help"
             xmlns:views="using:HyperPdf.App.Views"
             x:Class="HyperPdf.App.Views.TagOrderView">
  <!-- Layout only: every binding is made in code with ReactiveUI.Binding (TagOrderView.axaml.cs). -->
  <StackPanel Spacing="4">
    <TextBlock TextWrapping="Wrap" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Reading order and nesting&quot;}" FontWeight="SemiBold" Margin="0,6,0,0" />
    <WrapPanel>
      <Button x:Name="MoveUpButton" Margin="0,0,4,4" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Read Earlier&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Read this tag earlier&quot;}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Make a screen reader read the chosen tag earlier. The page does not change.&quot;}" />
      <Button x:Name="MoveDownButton" Margin="0,0,4,4" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Read Later&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Read this tag later&quot;}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Make a screen reader read the chosen tag later. The page does not change.&quot;}" />
      <Button x:Name="NestButton" Margin="0,0,4,4" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Nest&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Put this tag inside the tag above&quot;}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Put the chosen tag inside the tag above it, so a screen reader reads it as part of that tag.&quot;}" />
      <Button x:Name="UnnestButton" Margin="0,0,4,4" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Un-nest&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Move this tag out of its parent&quot;}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Move the chosen tag out of the tag it is inside, to just after it.&quot;}" />
      <Button x:Name="RemoveButton" Margin="0,0,4,4" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Remove&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Remove tag&quot;}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Remove the chosen tag when it holds no page content. The tags inside it stay. Undo puts it back.&quot;}" />
      <Button x:Name="UndoButton" Margin="0,0,4,4" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Undo&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Undo document edit&quot;}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Take back the latest change to the document, including a tag change.&quot;}" />
    </WrapPanel>
    <TextBlock TextWrapping="Wrap" x:Name="MoveIntoLabel" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Move this tag inside another tag&quot;}" FontWeight="SemiBold" Margin="0,6,0,0" />
    <ComboBox x:Name="MoveIntoBox" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Tag to move this tag inside&quot;}" AutomationProperties.LabeledBy="{Binding #MoveIntoLabel}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Choose another tag, then move the chosen tag inside it, as its last item. A move that would break the document&apos;s structure is refused.&quot;}" HorizontalAlignment="Stretch" />
    <Button x:Name="MoveIntoButton" Margin="0,0,4,4" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Move Inside&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Move this tag inside the chosen tag&quot;}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Choose another tag, then move the chosen tag inside it, as its last item. A move that would break the document&apos;s structure is refused.&quot;}" />
  </StackPanel>
</UserControl>
