<UserControl xmlns="https://github.com/avaloniaui" xmlns:loc="using:CP.Localisation.Avalonia"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:help="using:HyperPdf.ViewModels.Help"
             xmlns:views="using:HyperPdf.App.Views"
             x:Class="HyperPdf.App.Views.PageManagementView">
  <StackPanel Margin="8" Spacing="4">
    <Menu Background="Transparent">
      <MenuItem Header="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Page actions&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Page actions&quot;}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Edit or save copies of the pages selected in the thumbnail list.&quot;}">
        <MenuItem x:Name="DeleteItem" Header="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Delete selected pages&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Delete selected pages&quot;}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Remove the selected pages. Undo can restore them. Shortcut: Delete.&quot;}" />
        <MenuItem x:Name="ClockwiseItem" Header="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Rotate clockwise&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Rotate selected pages clockwise&quot;}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Turn the selected pages clockwise by a quarter turn.&quot;}" />
        <MenuItem x:Name="CounterclockwiseItem" Header="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Rotate anticlockwise&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Rotate selected pages anticlockwise&quot;}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Turn the selected pages anticlockwise by a quarter turn.&quot;}" />
        <MenuItem x:Name="DuplicateItem" Header="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Duplicate selected pages&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Duplicate selected pages&quot;}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Add copies of the selected pages after the selection.&quot;}" />
        <Separator />
        <MenuItem x:Name="EarlierItem" Header="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Move earlier (Ctrl+Alt+Up)&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Move selected pages earlier&quot;}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Move the selected pages one place toward the start. Shortcut: Ctrl+Alt+Up.&quot;}" />
        <MenuItem x:Name="LaterItem" Header="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Move later (Ctrl+Alt+Down)&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Move selected pages later&quot;}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Move the selected pages one place toward the end. Shortcut: Ctrl+Alt+Down.&quot;}" />
        <MenuItem x:Name="InsertItem" Header="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Insert PDF before selection…&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Insert PDF before selection&quot;}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Choose PDFs to insert before the first selected page.&quot;}" />
        <MenuItem x:Name="MergeItem" Header="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Merge PDFs at end…&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Merge PDFs at end&quot;}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Choose PDFs to append at the end of this document.&quot;}" />
        <MenuItem x:Name="InsertImagesItem" Header="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Add pictures as pages…&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Add pictures as pages&quot;}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Choose picture files. Each becomes a PDF page after the selected page.&quot;}" />
        <MenuItem x:Name="ExtractItem" Header="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Extract selected pages…&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Extract selected pages&quot;}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Save the selected pages in a new PDF file.&quot;}" />
        <Separator />
        <MenuItem x:Name="UndoItem" Header="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Undo page edit&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Undo page edit&quot;}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Restore the document before its most recent edit.&quot;}" />
        <MenuItem x:Name="RedoItem" Header="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Redo page edit&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Redo page edit&quot;}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Apply the most recently undone edit again.&quot;}" />
      </MenuItem>
    </Menu>
    <TextBlock x:Name="PageStatusText" Classes="secondary" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Ctrl or Shift selects several pages. Drag selected pages to move them.&quot;}" />
  </StackPanel>
</UserControl>
