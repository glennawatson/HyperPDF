<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:HyperPdf.App.Views"
             x:Class="HyperPdf.App.Views.OutlinePanelView">
  <!-- Layout only: every binding is made in code with ReactiveUI.Binding (OutlinePanelView.axaml.cs). -->
  <DockPanel>
    <views:OutlineEditView DockPanel.Dock="Top" x:Name="OutlineTools" />
    <Panel>
      <TreeView x:Name="OutlineTree" AutomationProperties.Name="Outline" Background="Transparent" />
      <TextBlock x:Name="NoOutlineText" Classes="secondary" Margin="12" TextWrapping="Wrap" Text="This document has no outline." />
    </Panel>
  </DockPanel>
</UserControl>
