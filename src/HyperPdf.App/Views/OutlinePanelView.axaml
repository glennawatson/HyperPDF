<UserControl xmlns="https://github.com/avaloniaui" xmlns:loc="using:CP.Localisation.Avalonia"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:HyperPdf.App.Views"
             x:Class="HyperPdf.App.Views.OutlinePanelView">
  <!-- Layout only: every binding is made in code with ReactiveUI.Binding (OutlinePanelView.axaml.cs). -->
  <DockPanel>
    <views:OutlineEditView DockPanel.Dock="Top" x:Name="OutlineTools" />
    <Panel>
      <TreeView x:Name="OutlineTree" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Outline&quot;}" Background="Transparent" />
      <TextBlock x:Name="NoOutlineText" Classes="secondary" Margin="12" TextWrapping="Wrap" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;This document has no outline.&quot;}" />
    </Panel>
  </DockPanel>
</UserControl>
