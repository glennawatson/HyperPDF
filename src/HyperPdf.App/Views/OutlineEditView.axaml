<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:HyperPdf.App.Views"
             x:Class="HyperPdf.App.Views.OutlineEditView">
  <StackPanel Margin="8" Spacing="4">
    <WrapPanel>
      <Button x:Name="AddButton" Margin="0,0,4,4" Content="Add Bookmark" AutomationProperties.Name="Add bookmark" views:ControlHelp.Text="{x:Static views:OutlineEditDescriptions.Add}" />
      <Button x:Name="RenameButton" Margin="0,0,4,4" Content="Rename…" AutomationProperties.Name="Rename bookmark" views:ControlHelp.Text="{x:Static views:OutlineEditDescriptions.Rename}" />
      <Button x:Name="RemoveButton" Margin="0,0,4,4" Content="Remove" AutomationProperties.Name="Remove bookmark" views:ControlHelp.Text="{x:Static views:OutlineEditDescriptions.Remove}" />
      <Button x:Name="MoveUpButton" Margin="0,0,4,4" Content="Move Up" AutomationProperties.Name="Move bookmark up" views:ControlHelp.Text="{x:Static views:OutlineEditDescriptions.MoveUp}" />
      <Button x:Name="MoveDownButton" Margin="0,0,4,4" Content="Move Down" AutomationProperties.Name="Move bookmark down" views:ControlHelp.Text="{x:Static views:OutlineEditDescriptions.MoveDown}" />
      <Button x:Name="IndentButton" Margin="0,0,4,4" Content="Nest" AutomationProperties.Name="Nest bookmark under the one above" views:ControlHelp.Text="{x:Static views:OutlineEditDescriptions.Indent}" />
      <Button x:Name="OutdentButton" Margin="0,0,4,4" Content="Un-nest" AutomationProperties.Name="Move bookmark out of its parent" views:ControlHelp.Text="{x:Static views:OutlineEditDescriptions.Outdent}" />
      <Button x:Name="UndoButton" Margin="0,0,4,4" Content="Undo" AutomationProperties.Name="Undo document edit" views:ControlHelp.Text="{x:Static views:OutlineEditDescriptions.Undo}" />
    </WrapPanel>
    <TextBlock x:Name="StatusText" Classes="secondary" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    <TextBlock x:Name="KeysText" Classes="secondary" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
