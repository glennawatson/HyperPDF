<UserControl xmlns="https://github.com/avaloniaui" xmlns:loc="using:CP.Localisation.Avalonia"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:help="using:HyperPdf.ViewModels.Help"
             xmlns:views="using:HyperPdf.App.Views"
             x:Class="HyperPdf.App.Views.OutlineEditView">
  <StackPanel Margin="8" Spacing="4">
    <WrapPanel>
      <Button x:Name="AddButton" Margin="0,0,4,4" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Add Bookmark&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Add bookmark&quot;}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Add a bookmark that goes to the page you are on. It goes below the chosen bookmark, or at the top when none is chosen.&quot;}" />
      <Button x:Name="RenameButton" Margin="0,0,4,4" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Rename…&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Rename bookmark&quot;}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Change the title of the chosen bookmark.&quot;}" />
      <Button x:Name="RemoveButton" Margin="0,0,4,4" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Remove&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Remove bookmark&quot;}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Remove the chosen bookmark and the bookmarks below it. Undo puts them back.&quot;}" />
      <Button x:Name="MoveUpButton" Margin="0,0,4,4" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Move Up&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Move bookmark up&quot;}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Move the chosen bookmark above the one before it.&quot;}" />
      <Button x:Name="MoveDownButton" Margin="0,0,4,4" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Move Down&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Move bookmark down&quot;}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Move the chosen bookmark below the one after it.&quot;}" />
      <Button x:Name="IndentButton" Margin="0,0,4,4" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Nest&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Nest bookmark under the one above&quot;}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Make the chosen bookmark a child of the bookmark above it.&quot;}" />
      <Button x:Name="OutdentButton" Margin="0,0,4,4" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Un-nest&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Move bookmark out of its parent&quot;}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Move the chosen bookmark out of its parent, to just after the parent.&quot;}" />
      <Button x:Name="UndoButton" Margin="0,0,4,4" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Undo&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Undo document edit&quot;}" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Undo the latest edit of the document, such as a bookmark change.&quot;}" />
    </WrapPanel>
    <TextBlock x:Name="StatusText" Classes="secondary" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    <TextBlock x:Name="KeysText" Classes="secondary" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
