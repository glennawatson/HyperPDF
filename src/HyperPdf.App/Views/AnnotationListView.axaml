<UserControl xmlns="https://github.com/avaloniaui" xmlns:loc="using:CP.Localisation.Avalonia"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:help="using:HyperPdf.ViewModels.Help"
             xmlns:views="using:HyperPdf.App.Views"
             x:Class="HyperPdf.App.Views.AnnotationListView">
  <!-- Layout only: every binding is made in code with ReactiveUI.Binding (AnnotationListView.axaml.cs). -->
  <!-- Comment list: a text filter, then filters and sort order shown on request, then the list. -->
  <DockPanel x:Name="AnnotationsPanel">
    <StackPanel DockPanel.Dock="Top" Margin="8,4,8,4" Spacing="6">
      <TextBox AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Filter comments&quot;}" x:Name="AnnotationFilterBox" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Type words to show only the comments that contain them.&quot;}" PlaceholderText="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Filter comments&quot;}" />
      <ToggleButton AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Filter and sort&quot;}" x:Name="AnnotationFiltersToggle" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Show or hide the choices that filter and sort the comment list.&quot;}" HorizontalAlignment="Stretch">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Path Classes="icon nav" Data="{StaticResource IconFilter}" />
          <TextBlock TextWrapping="Wrap" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Filter and Sort&quot;}" VerticalAlignment="Center" />
        </StackPanel>
      </ToggleButton>
      <StackPanel x:Name="AnnotationFiltersPanel" Spacing="4">
        <TextBlock TextWrapping="Wrap" x:Name="AnnotationTypeLabel" Classes="secondary" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Type&quot;}" />
        <ComboBox AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Type&quot;}" x:Name="AnnotationTypeBox" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Show only one type of comment, such as notes or drawings.&quot;}" HorizontalAlignment="Stretch" />
        <TextBlock TextWrapping="Wrap" x:Name="AnnotationColourLabel" Classes="secondary" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Colour&quot;}" />
        <ComboBox AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Colour&quot;}" x:Name="AnnotationColourBox" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Show only the comments of one colour.&quot;}" HorizontalAlignment="Stretch" />
        <TextBlock TextWrapping="Wrap" x:Name="AnnotationAuthorLabel" Classes="secondary" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Author&quot;}" />
        <ComboBox AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Author&quot;}" x:Name="AnnotationAuthorBox" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Show only the comments one person wrote.&quot;}" HorizontalAlignment="Stretch" />
        <TextBlock TextWrapping="Wrap" x:Name="AnnotationSortLabel" Classes="secondary" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Sort by&quot;}" />
        <ComboBox AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Sort by&quot;}" x:Name="AnnotationSortBox" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Choose the order of the comment list: by page, newest first, by author or by type.&quot;}" HorizontalAlignment="Stretch" />
        <Button AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Show all comments&quot;}" x:Name="ClearAnnotationFilterButton" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Show every comment again.&quot;}" HorizontalAlignment="Stretch" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Show All Comments&quot;}" />
      </StackPanel>
    </StackPanel>
    <Panel>
      <ListBox x:Name="AnnotationList" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Annotations&quot;}" Background="Transparent" />
      <TextBlock x:Name="NoAnnotationsText" Classes="secondary" Margin="12" TextWrapping="Wrap"
                 Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;No annotations yet. Choose Annotate, or right-click selected text.&quot;}" />
      <TextBlock x:Name="NoMatchesText" Classes="secondary" Margin="12" TextWrapping="Wrap"
                 Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;No comments match the filter. Choose Show All Comments to see them all.&quot;}" />
    </Panel>
  </DockPanel>
</UserControl>
