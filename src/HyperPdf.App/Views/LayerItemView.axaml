<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:HyperPdf.App.Views"
             x:Class="HyperPdf.App.Views.LayerItemView">
  <StackPanel Orientation="Horizontal" Spacing="8">
    <!-- A label groups layers and cannot be switched. -->
    <TextBlock x:Name="LabelText" FontWeight="SemiBold" VerticalAlignment="Center" />
    <CheckBox x:Name="LayerBox" views:ControlHelp.Text="{x:Static views:Descriptions.Layer}" />
    <!-- Says in words that a layer is locked or limited by zoom, so it never relies on colour or a greyed box alone. -->
    <TextBlock x:Name="NoteText" Classes="secondary" VerticalAlignment="Center" />
  </StackPanel>
</UserControl>
