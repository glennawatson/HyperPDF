<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:help="using:HyperPdf.ViewModels.Help"
             xmlns:views="using:HyperPdf.App.Views"
             x:Class="HyperPdf.App.Views.AutoScrollBarView">
  <!-- Layout only: every binding is made in code with ReactiveUI.Binding (AutoScrollBarView.axaml.cs). -->
  <!-- Auto-scroll: shown only while the pages scroll by themselves, even in read mode, so stopping is always one click away. -->
  <Border x:Name="AutoScrollBar" Classes="toolbar subbar" AutomationProperties.Name="Auto-scroll" AutomationProperties.ControlTypeOverride="ToolBar">
    <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button AutomationProperties.Name="Slower" x:Name="AutoScrollSlowerButton" views:ControlHelp.Text="{x:Static help:Descriptions.AutoScrollSlower}" Classes="tool">
          <StackPanel Orientation="Horizontal">
            <Path Classes="icon nav" Data="{StaticResource IconZoomOut}" />
            <TextBlock Classes="label" Text="Slower" />
          </StackPanel>
        </Button>
        <Button AutomationProperties.Name="Faster" x:Name="AutoScrollFasterButton" views:ControlHelp.Text="{x:Static help:Descriptions.AutoScrollFaster}" Classes="tool">
          <StackPanel Orientation="Horizontal">
            <Path Classes="icon nav" Data="{StaticResource IconZoomIn}" />
            <TextBlock Classes="label" Text="Faster" />
          </StackPanel>
        </Button>
        <Button AutomationProperties.Name="Stop auto-scroll" x:Name="AutoScrollStopButton" views:ControlHelp.Text="{x:Static help:Descriptions.AutoScrollStop}" Classes="tool">
          <StackPanel Orientation="Horizontal">
            <Path Classes="icon nav" Data="{StaticResource IconPause}" />
            <TextBlock Classes="label" Text="Stop" />
          </StackPanel>
        </Button>
      </StackPanel>
      <TextBlock x:Name="AutoScrollText" AutomationProperties.LiveSetting="Polite" VerticalAlignment="Center" Margin="12,0" TextWrapping="Wrap" />
    </DockPanel>
  </Border>
</UserControl>
