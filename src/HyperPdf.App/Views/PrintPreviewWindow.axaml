<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:HyperPdf.App.Views"
        x:Class="HyperPdf.App.Views.PrintPreviewWindow"
        Title="Print" Width="1040" Height="720" MinWidth="760" MinHeight="480" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppWindowBackground}">
  <!-- Modelled on a browser's print preview: the sheets that will print on the left, a few settings on the right. -->
  <Grid ColumnDefinitions="*,340">
    <ListBox x:Name="SheetList" AutomationProperties.Name="Preview sheets" Grid.Column="0" Classes="sheets" Background="{DynamicResource AppCanvasBackground}" Padding="0,16" />

    <Border Grid.Column="1" Background="{DynamicResource AppHeaderBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1,0,0,0">
      <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <DockPanel Margin="0,0,0,20">
          <TextBlock x:Name="SummaryText" DockPanel.Dock="Right" Classes="secondary" VerticalAlignment="Center" />
          <TextBlock Text="Print" FontSize="18" VerticalAlignment="Center" AutomationProperties.HeadingLevel="1" />
        </DockPanel>
        <StackPanel Grid.Row="1" Spacing="14">
          <Grid ColumnDefinitions="136,*">
            <TextBlock x:Name="DestinationLabel" Text="Destination" VerticalAlignment="Center" />
            <ComboBox x:Name="DestinationBox" views:ControlHelp.Text="{x:Static views:Descriptions.PrintDestination}" AutomationProperties.Name="Destination" Grid.Column="1" HorizontalAlignment="Stretch" />
          </Grid>
          <Grid ColumnDefinitions="136,*">
            <TextBlock x:Name="PagesLabel" Text="Pages" VerticalAlignment="Center" />
            <ComboBox x:Name="PagesBox" views:ControlHelp.Text="{x:Static views:Descriptions.PrintPages}" AutomationProperties.Name="Pages" Grid.Column="1" HorizontalAlignment="Stretch">
              <ComboBoxItem Content="All" />
              <ComboBoxItem Content="Current page" />
              <ComboBoxItem Content="Custom" />
            </ComboBox>
          </Grid>
          <Grid x:Name="CustomPagesRow" ColumnDefinitions="136,*">
            <TextBox x:Name="CustomPagesBox" views:ControlHelp.Text="{x:Static views:Descriptions.PageRange}" AutomationProperties.Name="Page range" Grid.Column="1" PlaceholderText="For example 1-3, 7" />
          </Grid>
          <Grid x:Name="CopiesRow" ColumnDefinitions="136,*">
            <TextBlock x:Name="CopiesLabel" Text="Copies" VerticalAlignment="Center" />
            <NumericUpDown x:Name="CopiesBox" views:ControlHelp.Text="{x:Static views:Descriptions.Copies}" AutomationProperties.Name="Copies" Grid.Column="1" Minimum="1" Maximum="999" Increment="1" FormatString="0" HorizontalAlignment="Stretch" />
          </Grid>
          <Grid x:Name="ColourRow" ColumnDefinitions="136,*">
            <TextBlock x:Name="ColourLabel" Text="Colour" VerticalAlignment="Center" />
            <ComboBox x:Name="ColourBox" views:ControlHelp.Text="{x:Static views:Descriptions.PrintColour}" AutomationProperties.Name="Colour" Grid.Column="1" HorizontalAlignment="Stretch">
              <ComboBoxItem Content="Colour" />
              <ComboBoxItem Content="Black and white" />
            </ComboBox>
          </Grid>
          <Grid x:Name="SidesRow" ColumnDefinitions="136,*">
            <CheckBox x:Name="TwoSidedBox" views:ControlHelp.Text="{x:Static views:Descriptions.TwoSided}" Grid.Column="1" Content="Print on both sides" />
          </Grid>
          <Grid x:Name="BindingRow" ColumnDefinitions="136,*" RowDefinitions="Auto,Auto" RowSpacing="4">
            <TextBlock x:Name="BindingLabel" Text="Turn pages" VerticalAlignment="Center" />
            <ComboBox x:Name="BindingBox" views:ControlHelp.Text="{x:Static views:Descriptions.TurnPages}" Grid.Column="1" AutomationProperties.Name="Turn pages" HorizontalAlignment="Stretch">
              <ComboBoxItem Content="Long edge" />
              <ComboBoxItem Content="Short edge" />
            </ComboBox>
            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="secondary" TextWrapping="Wrap" Text="If the backs are upside down, try the other edge." />
          </Grid>
          <Grid ColumnDefinitions="136,*">
            <TextBlock x:Name="LayoutLabel" Text="Layout" VerticalAlignment="Center" />
            <ComboBox x:Name="LayoutBox" views:ControlHelp.Text="{x:Static views:Descriptions.PrintLayout}" AutomationProperties.Name="Layout" Grid.Column="1" HorizontalAlignment="Stretch" />
          </Grid>
          <Grid x:Name="PagesPerSheetRow" ColumnDefinitions="136,*">
            <TextBlock x:Name="PagesPerSheetLabel" Text="Pages per sheet" VerticalAlignment="Center" />
            <ComboBox x:Name="PagesPerSheetBox" views:ControlHelp.Text="{x:Static views:Descriptions.PagesPerSheet}" AutomationProperties.Name="Pages per sheet" Grid.Column="1" HorizontalAlignment="Stretch" />
          </Grid>
          <Grid x:Name="PaperRow" ColumnDefinitions="136,*">
            <TextBlock x:Name="PaperLabel" Text="Paper size" VerticalAlignment="Center" />
            <ComboBox x:Name="PaperBox" views:ControlHelp.Text="{x:Static views:Descriptions.PaperSize}" AutomationProperties.Name="Paper size" Grid.Column="1" HorizontalAlignment="Stretch">
              <ComboBoxItem Content="A4" />
              <ComboBoxItem Content="Letter" />
              <ComboBoxItem Content="A3" />
              <ComboBoxItem Content="A5" />
              <ComboBoxItem Content="Legal" />
              <ComboBoxItem Content="Tabloid" />
            </ComboBox>
          </Grid>
          <Grid x:Name="ScalingRow" ColumnDefinitions="136,*">
            <TextBlock x:Name="ScalingLabel" Text="Page size" VerticalAlignment="Center" />
            <ComboBox x:Name="ScalingBox" views:ControlHelp.Text="{x:Static views:Descriptions.PrintScaling}" AutomationProperties.Name="Page size" Grid.Column="1" HorizontalAlignment="Stretch">
              <ComboBoxItem Content="Fit to paper" />
              <ComboBoxItem Content="Actual size" />
              <ComboBoxItem Content="Shrink oversized pages" />
              <ComboBoxItem Content="Custom scale" />
            </ComboBox>
          </Grid>
          <Grid x:Name="ScalePercentRow" ColumnDefinitions="136,*">
            <TextBlock x:Name="ScalePercentLabel" Text="Scale (%)" VerticalAlignment="Center" />
            <NumericUpDown x:Name="ScalePercentBox" views:ControlHelp.Text="{x:Static views:Descriptions.PrintScalePercent}" AutomationProperties.Name="Scale percent" Grid.Column="1"
                           Minimum="10" Maximum="400" Increment="5" FormatString="0" HorizontalAlignment="Stretch" />
          </Grid>
          <Grid ColumnDefinitions="136,*">
            <TextBlock Text="Options" VerticalAlignment="Center" />
            <CheckBox x:Name="AnnotationsBox" views:ControlHelp.Text="{x:Static views:Descriptions.PrintAnnotations}" Grid.Column="1" Content="Annotations" />
          </Grid>
          <TextBlock x:Name="PrinterHint" Classes="secondary" TextWrapping="Wrap" Margin="0,8,0,0"
                     Text="The printer, copies and paper are chosen in the next step." />
          <Button x:Name="SystemDialogButton" views:ControlHelp.Text="{x:Static views:Descriptions.SystemPrintDialog}" Classes="link" Margin="0,4,0,0" HorizontalAlignment="Left"
                  Content="Print using system dialog… (Ctrl+Shift+P)" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
          <Button x:Name="CancelButton" views:ControlHelp.Text="{x:Static views:Descriptions.Cancel}" Content="Cancel" IsCancel="True" />
          <Button x:Name="PrintButton" views:ControlHelp.Text="{x:Static views:Descriptions.PrintNext}" Content="Print…" IsDefault="True" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
