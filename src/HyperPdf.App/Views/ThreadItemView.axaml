<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HyperPdf.App.Views.ThreadItemView">
  <StackPanel Spacing="2">
    <TextBlock x:Name="TitleText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
    <TextBlock x:Name="SummaryText" Classes="secondary" FontSize="11" />
  </StackPanel>
</UserControl>
