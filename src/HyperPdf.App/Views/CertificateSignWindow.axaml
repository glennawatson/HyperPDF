<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:help="using:HyperPdf.ViewModels.Help"
        xmlns:views="using:HyperPdf.App.Views"
        x:Class="HyperPdf.App.Views.CertificateSignWindow"
        Title="Sign with Certificate" Width="520" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppWindowBackground}">
  <StackPanel Margin="20" Spacing="12">
    <TextBlock Classes="secondary" TextWrapping="Wrap"
               Text="Signs a copy of this document with your digital certificate. People who open it can check who signed it and that it has not changed since." />
    <Grid x:Name="RememberedRow" ColumnDefinitions="110,*,Auto">
      <TextBlock Text="Remembered" VerticalAlignment="Center" />
      <ComboBox x:Name="RememberedBox" views:ControlHelp.Text="{x:Static help:Descriptions.RememberedCertificates}" Grid.Column="1" HorizontalAlignment="Stretch" AutomationProperties.Name="Remembered certificates" />
      <Button x:Name="ForgetButton" views:ControlHelp.Text="{x:Static help:Descriptions.ForgetCertificate}" Grid.Column="2" Margin="8,0,0,0" AutomationProperties.Name="Forget certificate" Content="Forget" />
    </Grid>
    <Grid ColumnDefinitions="110,*,Auto">
      <TextBlock x:Name="CertificateLabel" Text="Certificate" VerticalAlignment="Center" />
      <TextBox x:Name="CertificateBox" views:ControlHelp.Text="{x:Static help:Descriptions.CertificateFile}" Grid.Column="1" AutomationProperties.Name="Certificate file" PlaceholderText=".p12 or .pfx file" />
      <Button x:Name="BrowseButton" views:ControlHelp.Text="{x:Static help:Descriptions.ChooseCertificate}" Grid.Column="2" Margin="8,0,0,0" AutomationProperties.Name="Choose certificate file" Content="Choose…" />
    </Grid>
    <Grid ColumnDefinitions="110,*">
      <TextBlock x:Name="PasswordLabel" Text="Password" VerticalAlignment="Center" />
      <TextBox x:Name="PasswordBox" views:ControlHelp.Text="{x:Static help:Descriptions.CertificatePassword}" Grid.Column="1" PasswordChar="●" AutomationProperties.Name="Certificate password" />
    </Grid>
    <CheckBox x:Name="RememberCheck" Margin="110,0,0,0" views:ControlHelp.Text="{x:Static help:Descriptions.RememberCertificate}"
              Content="Remember this certificate on this computer. The password is never saved." />
    <Grid ColumnDefinitions="110,*">
      <TextBlock x:Name="ReasonLabel" Text="Reason" VerticalAlignment="Center" />
      <TextBox x:Name="ReasonBox" views:ControlHelp.Text="{x:Static help:Descriptions.SigningReason}" Grid.Column="1" AutomationProperties.Name="Reason" PlaceholderText="Optional, for example Approved" />
    </Grid>
    <Grid ColumnDefinitions="110,*">
      <TextBlock x:Name="LocationLabel" Text="Location" VerticalAlignment="Center" />
      <TextBox x:Name="LocationBox" views:ControlHelp.Text="{x:Static help:Descriptions.SigningLocation}" Grid.Column="1" AutomationProperties.Name="Location" PlaceholderText="Optional" />
    </Grid>
    <Grid ColumnDefinitions="110,*">
      <TextBlock x:Name="KindLabel" Text="Signature" VerticalAlignment="Center" />
      <ComboBox x:Name="KindBox" views:ControlHelp.Text="{x:Static help:Descriptions.SignatureKind}" Grid.Column="1" HorizontalAlignment="Stretch" AutomationProperties.Name="Signature kind" />
    </Grid>
    <CheckBox x:Name="VisibleCheck" Margin="110,0,0,0" views:ControlHelp.Text="{x:Static help:Descriptions.VisibleSignature}"
              Content="Show the signature on the page, in the bottom left corner." />
    <StackPanel x:Name="PreviewPanel" Spacing="4">
      <TextBlock x:Name="PreviewHeading" Classes="secondary" Text="What will be signed" />
      <TextBlock x:Name="PreviewText" Focusable="True" TextWrapping="Wrap" AutomationProperties.Name="What will be signed" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
    <TextBlock x:Name="ErrorText" AutomationProperties.LiveSetting="Assertive" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="CancelButton" views:ControlHelp.Text="{x:Static help:Descriptions.Cancel}" Content="Cancel" IsCancel="True" />
      <Button x:Name="SignButton" views:ControlHelp.Text="{x:Static help:Descriptions.Sign}" Content="Sign…" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
