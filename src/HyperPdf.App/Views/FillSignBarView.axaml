<UserControl xmlns="https://github.com/avaloniaui" xmlns:loc="using:CP.Localisation.Avalonia"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:help="using:HyperPdf.ViewModels.Help"
             xmlns:views="using:HyperPdf.App.Views"
             x:Class="HyperPdf.App.Views.FillSignBarView">
  <!-- Layout only: every binding is made in code with ReactiveUI.Binding (FillSignBarView.axaml.cs). -->
  <!--
    Fill & Sign tools: form fields are filled by clicking them. A signature or initials is typed, drawn or taken from a
    picture, previewed on the page, then placed. While placing, the same row shows the placing steps and buttons.
  -->
  <Border x:Name="FillSignBar" Classes="toolbar subbar" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Fill and Sign tools&quot;}" AutomationProperties.ControlTypeOverride="ToolBar">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel>
        <WrapPanel>
          <ToggleButton AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Add Text&quot;}" x:Name="AddTextTool" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Click anywhere on the page and type, as on paper. Click a form field to fill it in.&quot;}" Classes="tool">
            <StackPanel Orientation="Horizontal">
              <Path Classes="icon add" Data="{StaticResource IconText}" />
              <TextBlock TextWrapping="Wrap" Classes="label" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Add Text&quot;}" />
            </StackPanel>
          </ToggleButton>
          <Button AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Signature…&quot;}" x:Name="SignatureButton" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Type, draw or choose a picture of your signature, then place it on the page.&quot;}" Classes="tool">
            <StackPanel Orientation="Horizontal">
              <Path Classes="icon edit" Data="{StaticResource IconSignature}" />
              <TextBlock TextWrapping="Wrap" Classes="label" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Signature…&quot;}" />
            </StackPanel>
          </Button>
          <Button AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Initials…&quot;}" x:Name="InitialsButton" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Type, draw or choose a picture of your initials, then place them on the page.&quot;}" Classes="tool">
            <StackPanel Orientation="Horizontal">
              <Path Classes="icon edit" Data="{StaticResource IconText}" />
              <TextBlock TextWrapping="Wrap" Classes="label" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Initials…&quot;}" />
            </StackPanel>
          </Button>
          <Button AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Sign with Certificate…&quot;}" x:Name="CertificateSignButton" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Sign a copy of the document with your digital certificate, a .p12 or .pfx file.&quot;}" Classes="tool">
            <StackPanel Orientation="Horizontal">
              <Path Classes="icon edit" Data="{StaticResource IconCertificate}" />
              <TextBlock TextWrapping="Wrap" Classes="label" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Sign with Certificate…&quot;}" />
            </StackPanel>
          </Button>
          <StackPanel x:Name="PlacingTools" Orientation="Horizontal">
            <Button AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Place&quot;}" x:Name="PlaceMarkButton" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Put the signature on the page where the preview is. Shortcut: Enter&quot;}" Classes="tool">
              <StackPanel Orientation="Horizontal">
                <Path Classes="icon add" Data="{StaticResource IconDone}" />
                <TextBlock TextWrapping="Wrap" Classes="label" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Place&quot;}" />
              </StackPanel>
            </Button>
            <Button AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Bigger&quot;}" x:Name="BiggerMarkButton" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Make the signature being placed bigger. Shortcut: +&quot;}" Classes="tool">
              <StackPanel Orientation="Horizontal">
                <Path Classes="icon edit" Data="{StaticResource IconZoomIn}" />
                <TextBlock TextWrapping="Wrap" Classes="label" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Bigger&quot;}" />
              </StackPanel>
            </Button>
            <Button AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Smaller&quot;}" x:Name="SmallerMarkButton" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Make the signature being placed smaller. Shortcut: -&quot;}" Classes="tool">
              <StackPanel Orientation="Horizontal">
                <Path Classes="icon edit" Data="{StaticResource IconZoomOut}" />
                <TextBlock TextWrapping="Wrap" Classes="label" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Smaller&quot;}" />
              </StackPanel>
            </Button>
            <Button AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Cancel Placing&quot;}" x:Name="CancelPlacementButton" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Stop placing the signature. The document is not changed. Shortcut: Escape&quot;}" Classes="tool">
              <StackPanel Orientation="Horizontal">
                <Path Classes="icon remove" Data="{StaticResource IconClose}" />
                <TextBlock TextWrapping="Wrap" Classes="label" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Cancel&quot;}" />
              </StackPanel>
            </Button>
          </StackPanel>
          <StackPanel x:Name="PlacedTools" Orientation="Horizontal">
            <Button AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Adjust Mark&quot;}" x:Name="AdjustMarkButton" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Pick up the signature you just placed so you can move or resize it again.&quot;}" Classes="tool">
              <StackPanel Orientation="Horizontal">
                <Path Classes="icon edit" Data="{StaticResource IconCursor}" />
                <TextBlock TextWrapping="Wrap" Classes="label" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Adjust&quot;}" />
              </StackPanel>
            </Button>
            <Button AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Remove Mark&quot;}" x:Name="RemoveMarkButton" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Take the signature you just placed off the page.&quot;}" Classes="tool">
              <StackPanel Orientation="Horizontal">
                <Path Classes="icon remove" Data="{StaticResource IconClose}" />
                <TextBlock TextWrapping="Wrap" Classes="label" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Remove&quot;}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </WrapPanel>
        <TextBlock x:Name="FillSignHint" Classes="secondary" TextWrapping="Wrap" Margin="8,0,8,4" />
      </StackPanel>
      <Button Grid.Column="1" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Done&quot;}" x:Name="FillSignDoneButton" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Put the Fill &amp; Sign tools away.&quot;}" Classes="tool">
        <StackPanel Orientation="Horizontal">
          <Path Classes="icon nav" Data="{StaticResource IconDone}" />
          <TextBlock TextWrapping="Wrap" Classes="label" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Done&quot;}" />
        </StackPanel>
      </Button>
    </Grid>
  </Border>
</UserControl>
