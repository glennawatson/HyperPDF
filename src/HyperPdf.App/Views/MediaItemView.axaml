<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HyperPdf.App.Views.MediaItemView">
  <DockPanel Background="Transparent">
    <Path DockPanel.Dock="Left" Classes="icon nav" Margin="0,0,8,0" Data="{StaticResource IconMedia}" />
    <StackPanel Spacing="2">
      <TextBlock x:Name="NameText" TextWrapping="Wrap" />
      <TextBlock x:Name="SizeText" Classes="secondary" FontSize="11" />
    </StackPanel>
  </DockPanel>
</UserControl>
