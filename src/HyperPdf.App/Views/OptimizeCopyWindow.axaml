<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:HyperPdf.App.Views"
        x:Class="HyperPdf.App.Views.OptimizeCopyWindow"
        Title="Save Optimised Copy" Width="640" Height="900" MinWidth="480" MinHeight="560" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppWindowBackground}">
  <!-- Layout only: bindings are made in code (OptimizeCopyWindow.axaml.cs). Every section is always present, so nothing moves while a copy is written. The settings scroll; the progress and summary stay on screen. -->
  <Grid RowDefinitions="*,Auto,Auto" Margin="20">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="12" Margin="0,0,12,0">
        <TextBlock x:Name="HeadingText" FontSize="16" TextWrapping="Wrap" AutomationProperties.HeadingLevel="1" />

        <TextBlock Text="Size" FontWeight="SemiBold" AutomationProperties.HeadingLevel="2" />
        <ListBox x:Name="PresetList" views:ControlHelp.Text="{x:Static views:Descriptions.OptimizePresets}" AutomationProperties.Name="Size of the copy" />

        <TextBlock Text="Accessibility and clean-up" FontWeight="SemiBold" AutomationProperties.HeadingLevel="2" />
        <CheckBox x:Name="FixBox" views:ControlHelp.Text="{x:Static views:Descriptions.OptimizeAccessibility}" Content="Fill in missing language and title" />
        <Grid ColumnDefinitions="Auto,*" Margin="28,0,0,0" ColumnSpacing="12">
          <TextBlock x:Name="LanguageLabel" Text="Language" VerticalAlignment="Center" />
          <TextBox x:Name="LanguageBox" Grid.Column="1" views:ControlHelp.Text="{x:Static views:Descriptions.OptimizeLanguage}" PlaceholderText="for example en-AU" />
        </Grid>
        <CheckBox x:Name="TagsBox" views:ControlHelp.Text="{x:Static views:Descriptions.OptimizeTags}" Content="Add a reading structure (tags) when missing" />
        <CheckBox x:Name="CleanBox" views:ControlHelp.Text="{x:Static views:Descriptions.OptimizeCleanUp}" Content="Remove thumbnails and hidden extras" />
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1" Spacing="4" Margin="0,12,0,0">
      <TextBlock Text="Progress and summary" FontWeight="SemiBold" AutomationProperties.HeadingLevel="2" />
      <ProgressBar x:Name="CopyProgress" Minimum="0" Maximum="100" views:ControlHelp.Text="{x:Static views:Descriptions.OptimizeProgress}" AutomationProperties.Name="Progress of the copy" />
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      <TextBlock x:Name="ErrorText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
      <Border BorderThickness="1" Padding="10" Height="120" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <SelectableTextBlock x:Name="ResultText" TextWrapping="Wrap" Focusable="True" AutomationProperties.LiveSetting="Polite" views:ControlHelp.Text="{x:Static views:Descriptions.OptimizeResult}" AutomationProperties.Name="Summary of the copy" />
        </ScrollViewer>
      </Border>
    </StackPanel>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button x:Name="CancelButton" views:ControlHelp.Text="{x:Static views:Descriptions.OptimizeCancel}" Content="_Cancel" />
      <Button x:Name="SaveButton" views:ControlHelp.Text="{x:Static views:Descriptions.OptimizeSave}" Content="_Save Copy…" IsDefault="True" />
      <Button x:Name="CloseButton" views:ControlHelp.Text="{x:Static views:Descriptions.CloseWindow}" Content="Clos_e" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
