<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:HyperPdf.App.Views"
             x:Class="HyperPdf.App.Views.TagRoleMapView">
  <!-- Layout only: every binding is made in code with ReactiveUI.Binding (TagRoleMapView.axaml.cs). -->
  <StackPanel Spacing="4">
    <TextBlock x:Name="RoleLabel" Text="Custom tag types" FontWeight="SemiBold" Margin="0,6,0,0" />
    <ListBox x:Name="RoleList" MaxHeight="100" AutomationProperties.Name="Custom tag types and what they stand for" Background="Transparent" />
    <Button x:Name="RemoveRoleButton" Margin="0,0,4,4" Content="Remove Custom Type" AutomationProperties.Name="Remove the chosen custom tag type" views:ControlHelp.Text="{x:Static views:Descriptions.RemoveRole}" />
    <TextBlock x:Name="NewRoleLabel" Text="New custom tag type" FontWeight="SemiBold" Margin="0,6,0,0" />
    <TextBox x:Name="NewRoleBox" AutomationProperties.Name="New custom tag type name" AutomationProperties.LabeledBy="{Binding #NewRoleLabel}" views:ControlHelp.Text="{x:Static views:Descriptions.NewRole}" />
    <TextBlock x:Name="RoleTargetLabel" Text="It stands for" FontWeight="SemiBold" Margin="0,6,0,0" />
    <ComboBox x:Name="RoleTargetBox" AutomationProperties.Name="Standard tag the custom type stands for" AutomationProperties.LabeledBy="{Binding #RoleTargetLabel}" views:ControlHelp.Text="{x:Static views:Descriptions.NewRole}" HorizontalAlignment="Stretch" />
    <Button x:Name="AddRoleButton" Margin="0,0,4,4" Content="Add Custom Type" AutomationProperties.Name="Add the custom tag type" views:ControlHelp.Text="{x:Static views:Descriptions.NewRole}" />
  </StackPanel>
</UserControl>
