<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:HyperPdf.App.Views"
        x:Class="HyperPdf.App.Views.MainWindow"
        Title="Hyper PDF Viewer" Width="1200" Height="850" MinWidth="480" MinHeight="320"
        Background="{DynamicResource AppWindowBackground}"
        DragDrop.AllowDrop="True">
  <!-- Layout only: bindings, commands and shortcuts are set up in code with ReactiveUI.Binding (MainWindow.axaml.cs). -->
  <Grid RowDefinitions="Auto,*,Auto">
    <!-- Tab strip. -->
    <views:TabBarView x:Name="TabBar" AutomationProperties.Name="Tabs" AutomationProperties.LandmarkType="Navigation" />
    <Panel Grid.Row="1">
      <views:StartView x:Name="StartPage" />
      <!-- The second column holds a second view of the same document while the view is split. -->
      <Grid x:Name="DocumentArea" ColumnDefinitions="*,Auto,0">
        <ContentControl x:Name="DocumentHost" />
        <GridSplitter x:Name="SplitSplitter" Grid.Column="1" Width="6" views:ControlHelp.Text="{x:Static views:Descriptions.SplitSplitter}" AutomationProperties.Name="Split view divider" IsVisible="False" />
        <ContentControl x:Name="SplitHost" Grid.Column="2" AutomationProperties.Name="Second view" IsVisible="False" />
      </Grid>
    </Panel>
    <Border Grid.Row="2" x:Name="StatusBar" Classes="toolbar" BorderThickness="0,1,0,0" AutomationProperties.Name="Status" AutomationProperties.ControlTypeOverride="StatusBar">
      <Grid ColumnDefinitions="*,Auto">
        <!-- Downloads and their failures are announced without moving the focus. -->
        <TextBlock x:Name="StatusText" AutomationProperties.LiveSetting="Polite" Margin="6,2" VerticalAlignment="Center" />
        <Button Grid.Column="1" x:Name="DismissStatusButton" views:ControlHelp.Text="{x:Static views:Descriptions.DismissMessage}" Content="Dismiss" />
      </Grid>
    </Border>
  </Grid>
</Window>
