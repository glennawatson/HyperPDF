<Window xmlns="https://github.com/avaloniaui" xmlns:loc="using:CP.Localisation.Avalonia"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:help="using:HyperPdf.ViewModels.Help"
        xmlns:views="using:HyperPdf.App.Views"
        x:Class="HyperPdf.App.Views.SaveCopyWindow"
        Title="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Save a Copy&quot;}" Width="680" Height="920" MinWidth="480" MinHeight="560" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppWindowBackground}">
  <!-- Layout only: bindings are made in code (SaveCopyWindow.axaml.cs). The format and options scroll in Row 0; the progress, summary and buttons stay fixed at the bottom so nothing shifts. -->
  <Grid RowDefinitions="*,Auto,Auto" Margin="20">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="12" Margin="0,0,12,0">
        <TextBlock x:Name="HeadingText" FontSize="16" TextWrapping="Wrap" AutomationProperties.HeadingLevel="1" />

        <TextBlock TextWrapping="Wrap" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Format&quot;}" FontWeight="SemiBold" AutomationProperties.HeadingLevel="2" />
        <ListBox x:Name="FormatList" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Choose the kind of copy to save. Use the arrow keys to move between the choices.&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Format of the copy&quot;}" />

        <StackPanel x:Name="StandardPanel" Spacing="8">
          <TextBlock TextWrapping="Wrap" Classes="secondary" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Writes a standard PDF copy of this document with your annotations, form entries and page changes. Your open file is never changed.&quot;}" />
        </StackPanel>

        <StackPanel x:Name="OptimizePanel" Spacing="12">
          <TextBlock TextWrapping="Wrap" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Size&quot;}" FontWeight="SemiBold" AutomationProperties.HeadingLevel="2" />
          <ListBox x:Name="PresetList" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Choose how much picture detail may be traded for a smaller file. Use the arrow keys to move between the choices.&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Size of the copy&quot;}" />

          <TextBlock TextWrapping="Wrap" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Accessibility and clean-up&quot;}" FontWeight="SemiBold" AutomationProperties.HeadingLevel="2" />
          <CheckBox x:Name="FixBox" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Add the document language, a window title and tag flags when they are missing, so screen readers read the file correctly.&quot;}" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Fill in missing language and title&quot;}" />
          <Grid ColumnDefinitions="Auto,*" Margin="28,0,0,0" ColumnSpacing="12">
            <TextBlock TextWrapping="Wrap" x:Name="LanguageLabel" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Language&quot;}" VerticalAlignment="Center" />
            <TextBox x:Name="LanguageBox" Grid.Column="1" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;The language of the text, such as en-AU. It is used only when the document does not say.&quot;}" PlaceholderText="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;for example en-AU&quot;}" />
          </Grid>
          <CheckBox x:Name="TagsBox" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Guess headings, paragraphs and pictures from the page layout when the document has no reading structure. The guess can be wrong, so check it.&quot;}" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Add a reading structure (tags) when missing&quot;}" />
          <StackPanel x:Name="DescribePanel">
            <CheckBox x:Name="DescribeBox" views:ControlHelp.Text="{views:LiveHelp OptimizeDescribePictures}" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Describe pictures for screen readers&quot;}" />
            <TextBlock x:Name="DescribeNote" TextWrapping="Wrap" />
          </StackPanel>
          <CheckBox x:Name="CleanBox" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Remove page thumbnails, private application data, unused resources and empty comment lists. Pages look the same.&quot;}" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Remove thumbnails and hidden extras&quot;}" />

        </StackPanel>

        <StackPanel x:Name="ArchivePanel" Spacing="8">
          <TextBlock TextWrapping="Wrap" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;PDF/A level&quot;}" FontWeight="SemiBold" AutomationProperties.HeadingLevel="2" />
          <ListBox x:Name="LevelList" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Choose the PDF/A level the copy must meet. Use the arrow keys to move between the choices.&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;PDF/A level&quot;}" />
        </StackPanel>

        <StackPanel x:Name="Pdf20Panel" Spacing="8">
          <TextBlock TextWrapping="Wrap" Classes="secondary" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Saves this document as a PDF 2.0 file (ISO 32000-2). Details in features that PDF 2.0 retired are moved into their PDF 2.0 places when they can be. The copy is refused with a plain-words reason when something cannot be kept.&quot;}" />
        </StackPanel>

        <StackPanel x:Name="FlattenPanel" Spacing="8">
          <TextBlock TextWrapping="Wrap" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;What to flatten&quot;}" FontWeight="SemiBold" AutomationProperties.HeadingLevel="2" />
          <ListBox x:Name="ScopeList" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Choose what becomes part of the page. Use the arrow keys to move between the choices.&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;What to flatten&quot;}" />
          <TextBlock TextWrapping="Wrap" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Look to keep&quot;}" FontWeight="SemiBold" AutomationProperties.HeadingLevel="2" />
          <ListBox x:Name="LookList" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Choose whether the copy keeps the screen look or the print look. Use the arrow keys to move between the choices.&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Look to keep&quot;}" />
          <CheckBox x:Name="UprightBox" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Save pages that are shown turned the right way up, with the turn built into the page. Links and bookmarks on turned pages may land in a different place.&quot;}" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Save turned pages upright&quot;}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1" Spacing="4" Margin="0,12,0,0">
      <TextBlock TextWrapping="Wrap" Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Progress and summary&quot;}" FontWeight="SemiBold" AutomationProperties.HeadingLevel="2" />
      <Grid>
        <ProgressBar x:Name="CopyProgress" Minimum="0" Maximum="100" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Moves while the copy is being made.&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Progress of the copy&quot;}" />
        <ProgressBar x:Name="BusyProgress" IsIndeterminate="True" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Moves while the copy is being made.&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Making the copy&quot;}" />
      </Grid>
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      <TextBlock x:Name="ErrorText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
      <Border BorderThickness="1" Padding="10" Height="120" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <SelectableTextBlock x:Name="ResultText" TextWrapping="Wrap" Focusable="True" AutomationProperties.LiveSetting="Polite" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;What the saved copy changed, what was left alone, or why it could not be made.&quot;}" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Summary of the copy&quot;}" />
        </ScrollViewer>
      </Border>
    </StackPanel>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button x:Name="CancelButton" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Stop making the copy. No file is saved.&quot;}" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;_Cancel&quot;}" />
      <Button x:Name="SaveButton" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Choose where to save the copy, then make it. The open file is never replaced.&quot;}" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;_Save Copy…&quot;}" IsDefault="True" />
      <Button x:Name="CloseButton" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Close this window. Shortcut: Esc&quot;}" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Clos_e&quot;}" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
