<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:help="using:HyperPdf.ViewModels.Help"
             xmlns:controls="using:HyperPdf.App.Controls"
             xmlns:views="using:HyperPdf.App.Views"
             x:Class="HyperPdf.App.Views.PageCanvasView">
  <!-- Layout only: every binding is made in code with ReactiveUI.Binding (PageCanvasView.axaml.cs). -->
  <Panel x:Name="PageSurface">
    <views:FocusView x:Name="FocusPane" IsVisible="False" />
    <ScrollViewer x:Name="Scroller" Background="{DynamicResource AppCanvasBackground}"
                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <Panel HorizontalAlignment="Left" VerticalAlignment="Top">
        <!-- Named "Page 5 of 40" by its automation peer; the new page is announced as the reader moves. -->
        <controls:PageCanvas x:Name="Canvas" AutomationProperties.HelpText="{x:Static help:Descriptions.Pages}" AutomationProperties.LiveSetting="Polite" CurrentHitOutline="{DynamicResource AppCurrentHitOutline}"
                             SelectionBrush="{DynamicResource AppTextSelectionBrush}"
                             LabelBackground="{DynamicResource AppWindowBackground}" LabelForeground="{DynamicResource AppForeground}" />
        <!-- Search hits, the reading marks and the focus band, over the pages; the pointer passes through to the pages. -->
        <controls:PageMarksLayer x:Name="Marks" HitBrush="{DynamicResource AppHitBrush}" CurrentHitOutline="{DynamicResource AppCurrentHitOutline}"
                                 SpokenBrush="{DynamicResource AppSpokenBrush}" DimBrush="{DynamicResource AppDimBrush}" />
        <Canvas x:Name="FieldOverlay">
          <views:FieldEditorView x:Name="FieldEditing" />
          <views:PageTextEditorView x:Name="PageTextEditing" />
          <views:AnnotationBubbleView x:Name="AnnotationBubble" />
        </Canvas>
      </Panel>
    </ScrollViewer>
    <views:DocumentLockView />
  </Panel>
</UserControl>
