<UserControl xmlns="https://github.com/avaloniaui" xmlns:loc="using:CP.Localisation.Avalonia"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:help="using:HyperPdf.ViewModels.Help"
             xmlns:views="using:HyperPdf.App.Views"
             x:Class="HyperPdf.App.Views.RecognitionBarsView">
  <!-- Layout only: every binding is made in code with ReactiveUI.Binding (RecognitionBarsView.axaml.cs). -->
  <StackPanel>
    <!-- Steady progress while scanned pages are recognised; nothing moves except the bar, one step per page. -->
    <Border x:Name="RecognitionBar" Classes="toolbar">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock x:Name="RecognitionText" AutomationProperties.LiveSetting="Polite" VerticalAlignment="Center" Margin="6,0" />
        <ProgressBar Grid.Column="1" x:Name="RecognitionProgress" AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Text recognition progress&quot;}" Width="160" Minimum="0" Maximum="1" VerticalAlignment="Center" Margin="8,0" />
        <Button Grid.Column="2" x:Name="StopRecognitionButton" views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Stop finding the words in scanned pages.&quot;}" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Stop&quot;}" />
      </Grid>
    </Border>

    <!-- Asks which language a document is in, when it matters; one button downloads it if needed and recognises. -->
    <Border x:Name="LanguageBar" Classes="toolbar">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
        <TextBlock x:Name="LanguageBarText" VerticalAlignment="Center" Margin="6,0" TextWrapping="Wrap" />
        <ComboBox Grid.Column="1" x:Name="LanguageBox" Width="200" VerticalAlignment="Center" Margin="8,0"
                  AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Document language&quot;}"
                  views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Choose the language the scanned pages are written in.&quot;}" />
        <Button Grid.Column="2" x:Name="LanguageActionButton" MinWidth="220"
                views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Find the words in this document in the chosen language. A language not on this computer downloads first and stays for next time.&quot;}" />
        <ProgressBar Grid.Column="3" x:Name="LanguageDownloadProgress" Width="140" Minimum="0" Maximum="1" VerticalAlignment="Center" Margin="8,0"
                     AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Language download progress&quot;}" />
        <Button Grid.Column="4" x:Name="CloseLanguageBarButton" Content="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Not Now&quot;}"
                AutomationProperties.Name="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Not now&quot;}"
                views:ControlHelp.Text="{loc:GeneratedResx ResxName=HyperPdf.Localisation.Strings, Key=&quot;Hide this bar. Nothing on the pages has been changed, and any download in progress stops.&quot;}" />
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
