<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Icon glyphs: stroked paths drawn in a shared 24 unit frame (each geometry starts with "M0,0 M24,24"), so every
    icon keeps its designed position and sits on the button's centre line; 20px frames give 16px Breeze-sized glyphs.
  -->
  <Style Selector="Path.icon">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="RenderTransformOrigin" Value="0,0" />
    <Setter Property="RenderTransform" Value="scale(0.8333333)" />
    <Setter Property="StrokeThickness" Value="1.92" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Stroke" Value="{DynamicResource AppIconBrush}" />
  </Style>

  <!-- One tint per kind of action (rule 5): navigation, add, edit, remove. Shapes differ too, so colour is never the only cue. -->
  <Style Selector="Path.icon.nav">
    <Setter Property="Stroke" Value="{DynamicResource AppIconNav}" />
  </Style>
  <Style Selector="Path.icon.add">
    <Setter Property="Stroke" Value="{DynamicResource AppIconAdd}" />
  </Style>
  <Style Selector="Path.icon.edit">
    <Setter Property="Stroke" Value="{DynamicResource AppIconEdit}" />
  </Style>
  <Style Selector="Path.icon.remove">
    <Setter Property="Stroke" Value="{DynamicResource AppIconRemove}" />
  </Style>

  <!-- Text beside tool bar icons; hidden when the user prefers icons only. -->
  <Style Selector="TextBlock.label">
    <Setter Property="Margin" Value="6,0,2,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.label.leading">
    <Setter Property="Margin" Value="2,0,6,0" />
  </Style>

  <!-- Flat tool bar buttons. -->
  <Style Selector=":is(Button).tool">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="7" />
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.tool">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="7" />
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppTabHoverBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
  </Style>
  <Style Selector="ToggleButton.tool:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppTabHoverBackground}" />
  </Style>

  <!-- A text-only button that reads like a link, for secondary choices such as the system print dialog. -->
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
  </Style>

  <!-- Print preview sheets: no selection highlight, the sheets are only to look at. -->
  <Style Selector="ListBox.sheets ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBox.sheets ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.sheets ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.toolbar">
    <Setter Property="Background" Value="{DynamicResource AppHeaderBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="4,3" />
  </Style>

  <!-- The contextual tool rows under the main tool bar. -->
  <Style Selector="Border.subbar">
    <Setter Property="Background" Value="{DynamicResource AppViewBackground}" />
  </Style>
  <Style Selector="RadioButton.swatch">
    <Setter Property="Margin" Value="6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.swatch">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
  </Style>

  <Style Selector="Rectangle.separator">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Margin" Value="5,0" />
    <Setter Property="Fill" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Selected list rows use the soft selection colour rather than the accent. -->
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppSelectionBrush}" />
  </Style>
  <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppSelectionBrush}" />
  </Style>
  <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource AppSelectionBrush}" />
  </Style>

  <!-- The document tab strip. -->
  <Style Selector="Border.tabbar">
    <Setter Property="Background" Value="{DynamicResource AppWindowBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="ListBox.tabstrip">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4,4,4,0" />
  </Style>
  <Style Selector="ListBox.tabstrip > ListBoxItem">
    <Setter Property="Padding" Value="10,5,4,5" />
    <Setter Property="Margin" Value="0,0,2,0" />
    <Setter Property="MinWidth" Value="80" />
    <Setter Property="MaxWidth" Value="240" />
    <Setter Property="CornerRadius" Value="4,4,0,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AppSecondaryForeground}" />
  </Style>
  <Style Selector="ListBox.tabstrip > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppTabHoverBackground}" />
  </Style>
  <Style Selector="ListBox.tabstrip > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppHeaderBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="BorderThickness" Value="0,2,0,0" />
  </Style>
  <Style Selector="ListBox.tabstrip > ListBoxItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
  </Style>
  <Style Selector="Ellipse.unsaved">
    <Setter Property="Width" Value="7" />
    <Setter Property="Height" Value="7" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Fill" Value="{DynamicResource AppIconEdit}" />
  </Style>
  <Style Selector="Button.tabclose">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="Margin" Value="6,0,0,0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Opacity" Value="0.6" />
  </Style>
  <Style Selector="Button.tabclose:pointerover">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <!-- Full strength under the keyboard too, so the focused close button is as clear as a hovered one. -->
  <Style Selector="Button.tabclose:focus-visible">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.tabclose Path.icon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="StrokeThickness" Value="1.8" />
  </Style>

  <!-- Sidebar. -->
  <Style Selector="Border.sidebar">
    <Setter Property="Background" Value="{DynamicResource AppViewBackground}" />
  </Style>
  <Style Selector="ListBox.thumbnails > ListBoxItem">
    <Setter Property="Padding" Value="8" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <!-- The editor over a form field: plain, so it reads as the field itself. -->
  <Style Selector="TextBox.field">
    <Setter Property="Padding" Value="3,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <!-- Text typed on the page: no padding or rounding, so the letters sit exactly where they are written. -->
  <!-- Help shows in the app's own text, never the letter spacing, weight or slant of the text being typed under it. -->
  <Style Selector="ToolTip">
    <Setter Property="LetterSpacing" Value="0" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="FontStyle" Value="Normal" />
  </Style>

  <Style Selector="TextBox.pagetext">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="4" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="RenderTransformOrigin" Value="0%,0%" />
  </Style>
  <!-- The theme recolours a focused or hovered text box; on the page it keeps the paper colour so it reads as the page. -->
  <Style Selector="TextBox.pagetext:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{TemplateBinding Background}" />
  </Style>
  <Style Selector="TextBox.pagetext:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{TemplateBinding Background}" />
  </Style>

  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource AppSecondaryForeground}" />
  </Style>
</Styles>
