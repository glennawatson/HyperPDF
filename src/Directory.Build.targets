<Project>
  <!--
    Text recognition ships with the app: native Tesseract and Leptonica from the Tesseract.Native.runtime.<rid> package
    for the runtime being built, and Tesseract's English data, so Recognise Text works the first time with no setup.
    Projects that run text recognition set UsesTesseractNative to true.
  -->
  <PropertyGroup>
    <TesseractRuntimeIdentifier Condition="'$(TesseractRuntimeIdentifier)' == '' and '$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</TesseractRuntimeIdentifier>
    <TesseractRuntimeIdentifier Condition="'$(TesseractRuntimeIdentifier)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</TesseractRuntimeIdentifier>

    <!--
      Each package holds every library up to three times (real name, soname and plain name), plus libraries Tesseract
      never loads. Only Tesseract under its plain name, which the app loads by path, and its dependency closure under
      the names its dependants ask for are kept.
    -->
    <TesseractNativeFiles Condition="'$(TesseractRuntimeIdentifier)' == 'linux-x64' or '$(TesseractRuntimeIdentifier)' == 'linux-arm64'">;libtesseract.so;libleptonica.so.6;libarchive.so.13;libcurl.so.4;libssl.so.3;libcrypto.so.3;libgif.so;libjpeg.so.62;libopenjp2.so.7;libpng16.so.16;libtiff.so.6;libwebp.so.7;libwebpmux.so.3;libsharpyuv.so.0;libz.so.1;libzstd.so.1;liblzma.so.5;libbz2.so.1.0;liblz4.so.1;</TesseractNativeFiles>
    <TesseractNativeFiles Condition="'$(TesseractRuntimeIdentifier)' == 'osx-arm64'">;libtesseract.dylib;libleptonica.6.0.0.dylib;libarchive.13.8.7.dylib;libcurl.4.8.0.dylib;libssl.3.dylib;libcrypto.3.dylib;libgif.dylib;libjpeg.62.4.0.dylib;libopenjp2.2.5.4.dylib;libpng16.16.58.0.dylib;libtiff.6.3.0.dylib;libwebp.7.2.0.dylib;libwebpmux.3.1.2.dylib;libsharpyuv.0.1.2.dylib;libz.1.3.2.dylib;libzstd.1.5.7.dylib;liblzma.5.8.3.dylib;libbz2.1.0.8.dylib;liblz4.1.10.0.dylib;</TesseractNativeFiles>
    <TesseractNativeFiles Condition="'$(TesseractRuntimeIdentifier)' == 'win-x64'">;tesseract.dll;leptonica-1.87.0.dll;archive.dll;libcurl.dll;libcrypto-3-x64.dll;gif.dll;jpeg62.dll;openjp2.dll;libpng16.dll;tiff.dll;libwebp.dll;libwebpmux.dll;libsharpyuv.dll;z.dll;zstd.dll;liblzma.dll;bz2.dll;lz4.dll;</TesseractNativeFiles>
    <TesseractNativeFiles Condition="'$(TesseractRuntimeIdentifier)' == 'win-arm64'">;tesseract.dll;leptonica-1.87.0.dll;archive.dll;libcurl.dll;libcrypto-3-arm64.dll;gif.dll;jpeg62.dll;openjp2.dll;libpng16.dll;tiff.dll;libwebp.dll;libwebpmux.dll;libsharpyuv.dll;z.dll;zstd.dll;liblzma.dll;bz2.dll;lz4.dll;</TesseractNativeFiles>

    <!-- tessdata_fast 4.1.0 English, pinned by SHA-256; the same file OcrLanguageCatalog offers for download. -->
    <TesseractEnglishUrl>https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/4.1.0/eng.traineddata</TesseractEnglishUrl>
    <TesseractEnglishSha256>7d4322bd2a7749724879683fc3912cb542f19906c83bcc1a52132556427170b2</TesseractEnglishSha256>
  </PropertyGroup>

  <ItemGroup Condition="'$(UsesTesseractNative)' == 'true' and '$(TesseractNativeFiles)' != ''">
    <PackageReference Include="Tesseract.Native.runtime.$(TesseractRuntimeIdentifier)" />
  </ItemGroup>

  <!-- Drops the package's duplicate and unused libraries from the build and publish outputs. -->
  <Target Name="KeepTesseractNativeClosure" AfterTargets="ResolvePackageAssets" Condition="'$(TesseractNativeFiles)' != ''">
    <ItemGroup>
      <_TesseractUnusedNative Include="@(RuntimeTargetsCopyLocalItems)"
                              Condition="$([System.String]::Copy('%(RuntimeTargetsCopyLocalItems.NuGetPackageId)').StartsWith('Tesseract.Native.runtime.')) and !$(TesseractNativeFiles.Contains(';%(Filename)%(Extension);'))" />
      <_TesseractUnusedNative Include="@(NativeCopyLocalItems)"
                              Condition="$([System.String]::Copy('%(NativeCopyLocalItems.NuGetPackageId)').StartsWith('Tesseract.Native.runtime.')) and !$(TesseractNativeFiles.Contains(';%(Filename)%(Extension);'))" />
      <RuntimeTargetsCopyLocalItems Remove="@(_TesseractUnusedNative)" />
      <NativeCopyLocalItems Remove="@(_TesseractUnusedNative)" />
    </ItemGroup>
  </Target>

  <!--
    The shipped libcurl needs OpenSSL 3.2, but Ubuntu 24.04 and Debian 12 have 3.0. Once .NET loads the system OpenSSL,
    the loader would hand that copy to libcurl and Tesseract would fail to load. Giving the shipped OpenSSL its own
    sonames (same length, so the ELF layout is unchanged) keeps the two copies apart.
  -->
  <Target Name="RenameTesseractOpenSsl" AfterTargets="KeepTesseractNativeClosure"
          Condition="'$(TesseractRuntimeIdentifier)' == 'linux-x64' or '$(TesseractRuntimeIdentifier)' == 'linux-arm64'">
    <PropertyGroup>
      <_TesseractOpenSslRenames>libssl.so.3=libpvs.so.3;libcrypto.so.3=libpvcryp.so.3</_TesseractOpenSslRenames>
    </PropertyGroup>
    <ItemGroup>
      <_TesseractRuntimeTargetsElf Include="@(RuntimeTargetsCopyLocalItems)" Condition="$([System.String]::Copy('%(RuntimeTargetsCopyLocalItems.NuGetPackageId)').StartsWith('Tesseract.Native.runtime.'))" />
      <_TesseractNativeElf Include="@(NativeCopyLocalItems)" Condition="$([System.String]::Copy('%(NativeCopyLocalItems.NuGetPackageId)').StartsWith('Tesseract.Native.runtime.'))" />
    </ItemGroup>
    <RenameElfDependencies Libraries="@(_TesseractRuntimeTargetsElf)" OutputDirectory="$(IntermediateOutputPath)tesseract-native/" Renames="$(_TesseractOpenSslRenames)"
                           Condition="'@(_TesseractRuntimeTargetsElf)' != ''">
      <Output TaskParameter="Results" ItemName="_TesseractRuntimeTargetsRenamed" />
    </RenameElfDependencies>
    <RenameElfDependencies Libraries="@(_TesseractNativeElf)" OutputDirectory="$(IntermediateOutputPath)tesseract-native/" Renames="$(_TesseractOpenSslRenames)"
                           Condition="'@(_TesseractNativeElf)' != ''">
      <Output TaskParameter="Results" ItemName="_TesseractNativeRenamed" />
    </RenameElfDependencies>
    <ItemGroup>
      <RuntimeTargetsCopyLocalItems Remove="@(_TesseractRuntimeTargetsElf)" />
      <RuntimeTargetsCopyLocalItems Include="@(_TesseractRuntimeTargetsRenamed)" />
      <NativeCopyLocalItems Remove="@(_TesseractNativeElf)" />
      <NativeCopyLocalItems Include="@(_TesseractNativeRenamed)" />
    </ItemGroup>
  </Target>

  <!--
    Copies ELF libraries into OutputDirectory, renaming each library named on the left of Renames and rewriting the
    dependency and soname strings in .dynstr that name it. Each new name must be as long as the old one.
  -->
  <UsingTask TaskName="RenameElfDependencies" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Libraries ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <OutputDirectory ParameterType="System.String" Required="true" />
      <Renames ParameterType="System.String" Required="true" />
      <Results ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
var renames = new List<KeyValuePair<byte[], byte[]>>();
var fileNames = new Dictionary<string, string>(StringComparer.Ordinal);
foreach (var pair in Renames.Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries))
{
    var parts = pair.Split('=');
    if (parts.Length != 2 || parts[0].Length != parts[1].Length)
    {
        Log.LogError("RenameElfDependencies: '{0}' must be old=new with names of equal length.", pair);
        return false;
    }

    renames.Add(new KeyValuePair<byte[], byte[]>(Encoding.ASCII.GetBytes(parts[0] + "\0"), Encoding.ASCII.GetBytes(parts[1] + "\0")));
    fileNames[parts[0]] = parts[1];
}

Directory.CreateDirectory(OutputDirectory);
var results = new List<Microsoft.Build.Framework.ITaskItem>();
foreach (var library in Libraries)
{
    var source = library.ItemSpec;
    var name = Path.GetFileName(source);
    var bytes = File.ReadAllBytes(source);

    // ELF64 little-endian (x64 and arm64): find .dynstr through the section headers.
    if (bytes.Length < 64 || bytes[0] != 0x7F || bytes[1] != (byte)'E' || bytes[2] != (byte)'L' || bytes[3] != (byte)'F' || bytes[4] != 2 || bytes[5] != 1)
    {
        results.Add(library);
        continue;
    }

    // Fields are little-endian, as are the x64 and arm64 machines that build the app.
    var sectionTable = (int)BitConverter.ToUInt64(bytes, 0x28);
    int entrySize = BitConverter.ToUInt16(bytes, 0x3A);
    int count = BitConverter.ToUInt16(bytes, 0x3C);
    int namesIndex = BitConverter.ToUInt16(bytes, 0x3E);
    var namesOffset = (int)BitConverter.ToUInt64(bytes, sectionTable + (namesIndex * entrySize) + 0x18);
    var dynstr = Encoding.ASCII.GetBytes(".dynstr\0");
    var changed = false;
    for (var section = 0; section < count; section++)
    {
        var header = sectionTable + (section * entrySize);
        if (!Matches(bytes, namesOffset + (int)BitConverter.ToUInt32(bytes, header), dynstr))
        {
            continue;
        }

        var start = (int)BitConverter.ToUInt64(bytes, header + 0x18);
        var end = start + (int)BitConverter.ToUInt64(bytes, header + 0x20);
        foreach (var rename in renames)
        {
            // Only whole strings: a match must start a string, not end a longer one.
            for (var at = start; at + rename.Key.Length <= end; at++)
            {
                if ((at == start || bytes[at - 1] == 0) && Matches(bytes, at, rename.Key))
                {
                    Buffer.BlockCopy(rename.Value, 0, bytes, at, rename.Value.Length);
                    changed = true;
                }
            }
        }
    }

    string newName;
    var renamed = fileNames.TryGetValue(name, out newName);
    if (!changed && !renamed)
    {
        results.Add(library);
        continue;
    }

    var target = Path.Combine(OutputDirectory, renamed ? newName : name);
    // Rewriting only on a change keeps the timestamp, so incremental builds skip the copy.
    var existing = File.Exists(target) ? File.ReadAllBytes(target) : null;
    if (existing == null || existing.Length != bytes.Length || !Matches(existing, 0, bytes))
    {
        File.WriteAllBytes(target, bytes);
    }

    var item = new Microsoft.Build.Utilities.TaskItem(target);
    library.CopyMetadataTo(item);
    var destination = library.GetMetadata("DestinationSubPath");
    if (renamed && destination.Length > 0)
    {
        item.SetMetadata("DestinationSubPath", destination.Substring(0, destination.Length - name.Length) + newName);
    }

    results.Add(item);
}

Results = results.ToArray();

static bool Matches(byte[] haystack, int offset, byte[] needle)
{
    if (offset < 0 || offset + needle.Length > haystack.Length)
    {
        return false;
    }

    for (var i = 0; i < needle.Length; i++)
    {
        if (haystack[offset + i] != needle[i])
        {
            return false;
        }
    }

    return true;
}
]]></Code>
    </Task>
  </UsingTask>

  <!--
    Downloads the English data into this build's own obj folder, checks its SHA-256 and copies it to tessdata/ beside
    the app. The folder is per target framework because multi-targeted projects build their frameworks in parallel.
  -->
  <Target Name="AddTesseractEnglish" BeforeTargets="AssignTargetPaths" Condition="'$(UsesTesseractNative)' == 'true'">
    <PropertyGroup>
      <TesseractEnglishDirectory>$(IntermediateOutputPath)tessdata/</TesseractEnglishDirectory>
    </PropertyGroup>
    <DownloadFile SourceUrl="$(TesseractEnglishUrl)" DestinationFolder="$(TesseractEnglishDirectory)" Retries="3"
                  Condition="!Exists('$(TesseractEnglishDirectory)eng.traineddata')" />
    <GetFileHash Files="$(TesseractEnglishDirectory)eng.traineddata" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_TesseractEnglishHash" />
    </GetFileHash>
    <Delete Files="$(TesseractEnglishDirectory)eng.traineddata" Condition="'$(_TesseractEnglishHash.ToLowerInvariant())' != '$(TesseractEnglishSha256)'" />
    <Error Condition="'$(_TesseractEnglishHash.ToLowerInvariant())' != '$(TesseractEnglishSha256)'"
           Text="The downloaded English text recognition data did not match its SHA-256 and was deleted. Build again to download it again." />
    <ItemGroup>
      <None Include="$(TesseractEnglishDirectory)eng.traineddata" Link="tessdata/eng.traineddata"
            CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
