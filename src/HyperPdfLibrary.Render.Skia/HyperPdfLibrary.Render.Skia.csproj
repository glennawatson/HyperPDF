<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>HyperPdfLibrary.Render.Skia</RootNamespace>
    <Description>Skia drawing services for HyperPdfLibrary.</Description>
    <IsPackable>true</IsPackable>
    <PackageId>HyperPdfLibrary.Render.Skia</PackageId>
    <Title>HyperPdfLibrary.Render.Skia</Title>
    <PackageTags>pdf;pdf-renderer;skia;skiasharp;aot</PackageTags>
    <PackageProjectUrl>https://github.com/glennawatson/HyperPDF</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>false</IncludeSymbols>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>
  <!-- HyperPdfLibrary depends on .NET 11 release-candidate packages under the go-live licence, so a stable pack of this
       package trips NU5104 for the same reason. -->
  <PropertyGroup Condition="$(TargetFrameworks.Contains('net11.0'))">
    <NoWarn>$(NoWarn);NU5104</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../HyperPdfLibrary/HyperPdfLibrary.csproj" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
  </ItemGroup>
  <!-- The idle-object slots are shared with HyperPdfLibrary, which does not expose its internals to this assembly. -->
  <ItemGroup>
    <Compile Include="..\Shared\Pooling\*.cs" LinkBase="Shared\Pooling" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="HyperPdfLibrary.Tests" />
    <InternalsVisibleTo Include="HyperPdf.Engine.Tests" />
    <InternalsVisibleTo Include="HyperPdf.Benchmarks" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\licenses\notices\HyperPdfLibrary.Render.Skia.md" Pack="true" PackagePath="THIRD-PARTY-NOTICES.md" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../../docs/hyperpdf/PACKAGE-README.md" Pack="true" PackagePath="README.md" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../../icons/HyperPDFViewerIcon.png" Pack="true" PackagePath="icon.png" Visible="false" />
  </ItemGroup>
</Project>
