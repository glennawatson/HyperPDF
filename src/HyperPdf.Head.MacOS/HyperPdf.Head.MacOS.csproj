<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Description>Hyper PDF Viewer for macOS: a native Cocoa window that shows the page canvas through the Metal or CPU render backend, with no UI toolkit.</Description>
    <RootNamespace>HyperPdf.Head.MacOS</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- The Licences window shows these notices: the packages in the heads' assets, the font and CMap resource packs, and the data the app downloads. -->
    <NoticesComponents>unicode-ucd;open-font-pack;adobe-cmaps;opus-reference-decoder;pv-aac-decoder;tessdata-fast;kokoro;misaki;melotts;bert-base-uncased;g2p-en;cmudict;verapdf-profile-text</NoticesComponents>
    <!-- Ships the English text recognition data (Directory.Build.targets). -->
    <UsesRecognitionData>true</UsesRecognitionData>
  </PropertyGroup>

  <!-- The published program is called hyperpdf. A build keeps the project's own name, because the tests load every head side by side. -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <AssemblyName>hyperpdf</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Label="Native AOT">
    <PublishAot>true</PublishAot>
    <EventSourceSupport>true</EventSourceSupport>
    <InvariantGlobalization>false</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <OptimizationPreference>Speed</OptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HyperPdf.Viewer\HyperPdf.Viewer.csproj" />
    <None Include="..\licenses\notices\HyperPdf.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <ProjectReference Include="..\HyperPdf.Windowing\HyperPdf.Windowing.csproj" />
    <ProjectReference Include="..\HyperPdf.Rendering.Cpu\HyperPdf.Rendering.Cpu.csproj" />
    <ProjectReference Include="..\HyperPdf.Rendering.Metal\HyperPdf.Rendering.Metal.csproj" />
    <ProjectReference Include="..\HyperPdf.Core\HyperPdf.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HyperPdf.Windowing.Tests" />
    <InternalsVisibleTo Include="HyperPdf.CocoaWindowRun" />
  </ItemGroup>
</Project>
