<Project>
  <!--
    Embeds the project's checked-in third-party notices (src/licenses/notices/<project>.md) as the resource named in
    NoticesResourceName. The files are generated, not written by hand: after a package or component change, run
    src/tools/RefreshThirdPartyNotices.cs, which restores each project and
    calls src/tools/GenerateThirdPartyNotices.cs with the project's assets file and the components listed in the project's
    NoticesComponents. On Renovate pull requests the refresh-notices workflow does this and pushes the result.
    Generating during the build is avoided on purpose:
    multi-target and solution builds would run the script concurrently and race on its output. A test fails when a
    shipped package is missing from the notices, so a stale file is caught.
  -->
  <PropertyGroup>
    <NoticesRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..'))</NoticesRoot>
    <NoticesFile>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', 'notices', '$(MSBuildProjectName).md'))</NoticesFile>
    <NoticesResourceName Condition="'$(NoticesResourceName)' == ''">$(RootNamespace).ThirdPartyNotices.md</NoticesResourceName>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(NoticesFile)" LogicalName="$(NoticesResourceName)" Visible="false" />
  </ItemGroup>
</Project>
