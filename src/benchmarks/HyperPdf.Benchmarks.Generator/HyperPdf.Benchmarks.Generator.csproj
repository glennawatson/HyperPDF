<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- A source generator loads into the compiler, which only offers netstandard2.0. -->
    <TargetFrameworks>netstandard2.0</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <DevelopmentDependency>true</DevelopmentDependency>
    <Description>Generates the benchmark case list the allocation harness runs, so no reflection finds or calls the benchmarks.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>

  <!-- The shared props alias System.Threading.Lock, which netstandard2.0 does not have. -->
  <ItemGroup>
    <Using Remove="System.Threading.Lock" />
  </ItemGroup>
</Project>
