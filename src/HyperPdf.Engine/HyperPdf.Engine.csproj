<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Connects the managed HyperPdfLibrary engine to HyperPDF.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HyperPdfLibrary\HyperPdfLibrary.csproj" />
    <ProjectReference Include="..\HyperPdfLibrary.Render.Managed\HyperPdfLibrary.Render.Managed.csproj" />
    <ProjectReference Include="..\HyperPdf.Core\HyperPdf.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="ScriptFonts\*.ttf.z" LogicalName="HyperPdf.Engine.ScriptFonts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="ScriptFonts\LICENSE.txt" LogicalName="HyperPdf.Engine.ScriptFonts.LICENSE.txt" />
    <None Include="ScriptFonts\LICENSE.txt" Pack="true" PackagePath="ScriptFonts-LICENSE.txt" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HyperPdf.Engine.Tests" />
    <InternalsVisibleTo Include="HyperPdf.Benchmarks" />
  </ItemGroup>
</Project>
