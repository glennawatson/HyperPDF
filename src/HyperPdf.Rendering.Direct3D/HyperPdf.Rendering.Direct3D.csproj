<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Direct3D 11 render backend for the HyperPDF Windows head: page tiles are textures and each frame is one batch of quads, called through COM function pointers with no wrapper library and no reflection.</Description>
    <RootNamespace>HyperPdf.Rendering.Direct3D</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HyperPdf.Windowing\HyperPdf.Windowing.csproj" />
    <ProjectReference Include="..\HyperPdf.Rendering.Cpu\HyperPdf.Rendering.Cpu.csproj" />
    <ProjectReference Include="..\HyperPdf.Core\HyperPdf.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HyperPdf.Windowing.Tests" />
    <InternalsVisibleTo Include="HyperPdf.Benchmarks" />
  </ItemGroup>
</Project>
